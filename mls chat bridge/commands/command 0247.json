    "claims": [
      {
        "clientId": "c-siot-name",
        "sectionKey": "En pocas palabras / Observación importante",
        "summary": "El jamo consonántico ㅅ recibe el nombre 시옷 (siot) en coreano; el nombre de la letra no implica que ㅅ tenga una única realización fonética constante.",
        "claimType": "general",
        "materiality": "substantial"
      },
      {
        "clientId": "c-onset-palatalization",
        "sectionKey": "Cómo funciona / Ejemplos",
        "summary": "La sibilante coreana ㅅ presenta realizaciones dependientes del contexto: ante segmentos frontales altos como /i/ y secuencias con /j/ adquiere características palatalizadas/alveolopalatales, mientras que ante vocales no frontales su realización es más anterior. Por eso 시 no se pronuncia exactamente como una s española seguida de i.",
        "claimType": "general",
        "materiality": "substantial"
      },
      {
        "clientId": "c-coda-neutralization",
        "sectionKey": "Cómo funciona / Ejemplos",
        "summary": "En posición final de sílaba o ante otra consonante, el 받침 ㅅ se neutraliza al sonido representativo [ㄷ], fonéticamente un cierre coronal no liberado; por eso 옷 aislado se pronuncia [옫], no con una s final continua.",
        "claimType": "normative",
        "materiality": "substantial"
      }
