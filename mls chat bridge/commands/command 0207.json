    "claims": [
      {
        "clientId": "c-formes-demonstratives",
        "sectionKey": "En pocas palabras / Cómo funciona / Observación importante",
        "summary": "Celui-ci y celui-là son formas compuestas del pronombre demostrativo masculino singular celui. Las partículas -ci y -là pueden marcar respectivamente proximidad y alejamiento, se unen al pronombre con guion y permiten distinguir o retomar referentes sin repetir el nombre.",
        "claimType": "general",
        "materiality": "substantial"
      },
      {
        "clientId": "c-ordre-anaphorique",
        "sectionKey": "Cómo funciona",
        "summary": "Cuando dos antecedentes ya han sido mencionados en el discurso escrito, celui-ci puede remitir al último mencionado y celui-là al primero; por ello no es correcto presentar de forma general -ci como 'el primero de dos' y -là como 'el segundo'.",
        "claimType": "general",
        "materiality": "substantial"
      },
      {
        "clientId": "c-usage-contextuel",
        "sectionKey": "Cómo funciona / Observación importante",
        "summary": "La oposición -ci/-là es contextual y no siempre mantiene una separación absoluta de cercanía: en la lengua hablada, là puede sustituir a ci incluso sin una oposición estricta de distancia.",
        "claimType": "general",
        "materiality": "substantial"
      }
    ],
