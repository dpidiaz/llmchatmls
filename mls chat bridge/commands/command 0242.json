    "claims": [
      {
        "clientId": "c-meiyou-discourse",
        "sectionKey": "En pocas palabras / Cómo funciona / Observación importante",
        "summary": "En el mandarín de Taiwán, 沒有 posee usos discursivo-pragmáticos que van más allá de negar existencia o posesión: puede funcionar en respuestas, rechazo, evasión, autorreparación o aclaración y otras secuencias conversacionales.",
        "claimType": "regional_variation",
        "materiality": "substantial"
      },
      {
        "clientId": "c-compliment-response",
        "sectionKey": "Cómo funciona / Ejemplos",
        "summary": "El uso de 沒有 como respuesta a elogios está documentado en Taiwán, incluido el ejemplo 你中文說得很流利。— 沒有啦，我中文還有待加強。, donde la respuesta rechaza o rebaja la atribución elogiosa; es una estrategia posible, no una respuesta obligatoria ni universal.",
        "claimType": "regional_variation",
        "materiality": "substantial"
      },
      {
        "clientId": "c-la-adjustment",
        "sectionKey": "Matiz conversacional / Observación importante",
        "summary": "啦 funciona como partícula final en el mandarín de Taiwán y su contribución es discursiva e interpersonal, dependiente del contexto. La literatura la describe, entre otras cosas, como marcador de cierre de unidad discursiva o de un ajuste explícito/implícito, por lo que no tiene una traducción léxica fija independiente.",
        "claimType": "regional_variation",
        "materiality": "substantial"
      },
      {
        "clientId": "c-la-softening-overclaim",
        "sectionKey": "Cómo funciona / Matiz conversacional",
        "summary": "La versión canónica atribuye específicamente a 啦 la reducción de la fuerza del rechazo en 沒有啦 y enumera como efectos propios tonos modestos, amistosos, juguetones o ligeramente defensivos según la entonación. La evidencia localizada para este piloto no basta para sostener esa formulación causal y esa lista como regla general.",
        "claimType": "regional_variation",
        "materiality": "substantial"
      }
    ],
