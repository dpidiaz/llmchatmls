    "claims": [
      {
        "clientId": "c-consequence",
        "sectionKey": "En pocas palabras / Cómo funciona / Ejemplos",
        "summary": "C’est pourquoi es un marcador de relación que introduce una consecuencia lógica derivada de un hecho o explicación anterior; pertenece al mismo campo funcional de marcadores de consecuencia como donc y par conséquent.",
        "claimType": "general",
        "materiality": "substantial"
      },
      {
        "clientId": "c-position",
        "sectionKey": "Cómo funciona",
        "summary": "C’est pourquoi se emplea como articulación entre un segmento previo y la proposición que expresa la consecuencia, típicamente tras una puntuación que separa ambos segmentos.",
        "claimType": "general",
        "materiality": "substantial"
      },
      {
        "clientId": "c-interrogatif",
        "sectionKey": "Observación importante",
        "summary": "El pourquoi de una interrogación pregunta ordinariamente por la causa o razón de algo; ese uso interrogativo debe distinguirse de la locución c’est pourquoi, que introduce una consecuencia o conclusión.",
        "claimType": "general",
        "materiality": "substantial"
      }
