    "claims": [
      {
        "clientId": "c-forme-partitive",
        "sectionKey": "En pocas palabras / Cómo funciona / Ejemplos",
        "summary": "En italiano, el artículo partitivo se forma mediante la fusión de di con el artículo definido: del/dello/della/dell' en singular y dei/degli/delle en plural. En singular suele expresar una cantidad indefinida con nombres de masa; en plural puede funcionar como plural indefinido de nombres contables.",
        "claimType": "general",
        "materiality": "substantial"
      },
      {
        "clientId": "c-forma-no-basta",
        "sectionKey": "Observación importante",
        "summary": "Las formas del/dello/della/dei/degli/delle no son siempre artículos partitivos: también pueden ser preposiciones articuladas con otras relaciones sintácticas, por ejemplo especificación o posesión; la función se determina por la estructura y el significado.",
        "claimType": "general",
        "materiality": "substantial"
      }
