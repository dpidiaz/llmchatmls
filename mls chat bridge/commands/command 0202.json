    "claims": [
      {
        "clientId": "c-opposizione",
        "sectionKey": "En pocas palabras / Cómo funciona / Ejemplos",
        "summary": "Las relaciones adversativas en italiano ponen en contraste dos contenidos o un contenido con una expectativa; entre los conectores frecuentes están ma, però y tuttavia, mientras invece puede introducir o reforzar oposiciones y alternativas.",
        "claimType": "general",
        "materiality": "substantial"
      },
      {
        "clientId": "c-distribuzione",
        "sectionKey": "Cómo funciona / Observación importante",
        "summary": "Los conectores de contraste no son mecánicamente intercambiables: pertenecen a clases y construcciones distintas; ma es una conjunción coordinante, tuttavia puede funcionar como conector adverbial y però, a diferencia de ma, admite también posición pospuesta.",
        "claimType": "general",
        "materiality": "substantial"
      },
      {
        "clientId": "c-concessione",
        "sectionKey": "Cómo funciona / Observación importante",
        "summary": "La concesión está relacionada con la adversatividad pero añade una estructura específica de expectativa frustrada: una situación que podría impedir o hacer esperar lo contrario no evita el contenido de la principal; anche se es una forma típica de introducir esta relación.",
        "claimType": "general",
        "materiality": "substantial"
