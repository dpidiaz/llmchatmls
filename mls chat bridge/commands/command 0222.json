    "claims": [
      {
        "clientId": "c-laut-quelle",
        "sectionKey": "En pocas palabras / Cómo funciona / Observación importante",
        "summary": "La preposición laut introduce una fuente o base de información: presenta el contenido de una afirmación remitiéndolo a la persona, documento o fuente expresada en su complemento, sin convertir por sí sola esa atribución en una garantía del hablante.",
        "claimType": "general",
        "materiality": "substantial"
      },
      {
        "clientId": "c-laut-kasus",
        "sectionKey": "En pocas palabras / Cómo funciona / Ejemplos",
        "summary": "En el alemán actual, laut admite dativo y también genitivo. Duden presenta el dativo como el patrón ordinario y el genitivo como más raro; por ello no es correcto enseñar uno de los dos casos como la única construcción válida.",
        "claimType": "general",
        "materiality": "substantial"
      },
      {
        "clientId": "c-phrase-kasus",
        "sectionKey": "Cómo funciona",
        "summary": "El caso seleccionado por una preposición pertenece al sintagma nominal completo y se refleja por concordancia en determinantes, adjetivos y, cuando corresponde, en la forma del sustantivo; no es simplemente una terminación aislada del artículo.",
        "claimType": "general",
        "materiality": "substantial"
      }
    ],
