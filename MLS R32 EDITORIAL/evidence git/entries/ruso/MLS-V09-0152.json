  "claims": [
    {
      "claimId": "MLS-CLM-F952427074F0E793C684C649",
      "sectionKey": "En pocas palabras",
      "summary": "In Russian, a comparison can be expressed without 'чем' ('that') by putting the second term in genitive case. For example, 'Он выше брата' means 'He is taller than his brother', where 'брата' is in genitive case.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2CE74C3A87482BC174EEB726",
      "sectionKey": "Cómo funciona",
      "summary": "This pattern appears especially with comparative forms like 'выше' ('taller'), 'старше' ('older'), 'моложе' ('younger'), or 'быстрее' ('faster'). The compared element can appear directly in genitive: 'сестра старше брата' ('the sister is older than the brother').",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-EB73B2736F232B5AB4D02B63",
      "sectionKey": "Ejemplos",
      "summary": "Provides examples such as 'Он выше брата' ('He is taller than his brother'), 'Москва больше нашего города' ('Moscú is larger than our city'), and 'Эта машина быстрее автобуса' ('This car is faster than the bus'), demonstrating the genitive comparison.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
