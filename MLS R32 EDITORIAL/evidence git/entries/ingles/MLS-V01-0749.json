  "claims": [
    {
      "claimId": "MLS-CLM-AEF8942F555723D85C38F044",
      "sectionKey": "En pocas palabras",
      "summary": "Una cláusula relativa suplementaria añade información parentética no esencial sobre un referente identificado y no se usa principalmente para seleccionar cuál persona o cosa es el referente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-034A9CA57F71BD5F6F2924A7",
      "sectionKey": "Cómo funciona",
      "summary": "Una relativa suplementaria puede modificar un sintagma nominal con información adicional y suprimirla deja identificable el antecedente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-20E6AD79F9984370E0669CE6",
      "sectionKey": "Cómo funciona",
      "summary": "Una relativa con which puede retomar una proposición completa anterior (sentential which), no solo un sustantivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-45A30C4270965FDA9F6181EF",
      "sectionKey": "Cómo funciona",
      "summary": "Las relativas suplementarias se separan con comas en la escritura y pueden marcarse con pausas en el habla; también pueden usarse guiones o paréntesis como puntuación parentética.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FB62A7EB0E4BE1861A1AB8D5",
      "sectionKey": "Cómo funciona",
      "summary": "Las relativas suplementarias usan pronombres relativos como who, whom o which según el antecedente, y that no sustituye normalmente estos pronombres en una relativa no definitoria.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3E7E8B6F09A184A9CC0EF14C",
      "sectionKey": "Cómo funciona",
      "summary": "Una relativa restrictiva identifica o selecciona el referente; una relativa suplementaria agrega información adicional sobre un referente ya identificado y la puntuación puede señalar el contraste.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3D4EE4072E38426BF2A733D7",
      "sectionKey": "Observación importante",
      "summary": "No toda relativa introducida por which es suplementaria; puede ser restrictiva según estructura, puntuación y contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
