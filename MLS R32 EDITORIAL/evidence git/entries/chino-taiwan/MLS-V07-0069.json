  "claims": [
    {
      "claimId": "MLS-CLM-673437255AC89820CEABABF5",
      "sectionKey": "En pocas palabras",
      "summary": "En mandarín de Taiwán, el primer tono 3 de una secuencia local de dos tonos bajos suele realizarse con un ascenso parecido, pero no necesariamente idéntico, al tono 2.",
      "claimType": "phonetic_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-96130A961CD921EC5F4F1B4D",
      "sectionKey": "Cómo funciona",
      "summary": "El sandhi se condiciona por la frase prosódica y puede evitarse cuando una frontera separa los tonos 3.",
      "claimType": "phonetic_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-DCA23F4394EB4E2BC6A51FFD",
      "sectionKey": "Cómo funciona — Notación",
      "summary": "La secuencia de tonos léxicos 3+3 puede tener una realización superficial ascendente en la primera sílaba sin cambiar la transcripción léxica.",
      "claimType": "phonetic_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BF37820AB05BC2BE919ED29B",
      "sectionKey": "Observación importante",
      "summary": "La regla no se aplica categóricamente a través de toda frontera prosódica y la realización de T3 sandhi puede diferir fonéticamente de T2.",
      "claimType": "phonetic_description",
      "materiality": "substantial"
    }
  ],
