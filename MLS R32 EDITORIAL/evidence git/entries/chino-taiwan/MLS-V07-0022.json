      "claimId": "MLS-CLM-E201EB98E5E89F2545C82BC4",
      "sectionKey": "Observación importante",
      "summary": "逗號 separa cláusulas o marca pausas; 頓號 separa palabras o expresiones paralelas.",
      "claimType": "general",
      "materiality": "substantial"
    }
