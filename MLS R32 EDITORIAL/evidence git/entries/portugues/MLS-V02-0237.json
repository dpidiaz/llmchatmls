  "claims": [
    {
      "claimId": "MLS-CLM-52616F58743C0D81901A9394",
      "sectionKey": "Formas de objeto lhe y lhes",
      "summary": "Lhe y lhes son pronombres átonos que representan un complemento indirecto de tercera persona en la norma de referencia.",
      "claimType": "normative",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BFA8266AF671662630CC24B3",
      "sectionKey": "Cómo funciona",
      "summary": "Aparecen con verbos que admiten un complemento introducido por 'a': entregar algo a alguém → entregar-lhe algo, dizer algo a alguém → dizer-lhe algo.",
      "claimType": "normative",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-284EC66ED62EB363EA59265E",
      "sectionKey": "Cómo funciona",
      "summary": "En la escritura formal son normales secuencias como 'Eu lhe disse a verdade' y 'Entreguei-lhes os documentos'.",
      "claimType": "normative",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-23EBD4502E8586836C609137",
      "sectionKey": "Ejemplos",
      "summary": "Lle entreguei o documento, Eu lhe disse a verdade, entreguei-lhes as chaves.",
      "claimType": "normative",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-938C8F9E9DF9982B866AF543",
      "sectionKey": "Observación importante",
      "summary": "Lhe/lhes no equivale automáticamente a o/a/os/as; estas últimas representan objeto directo, mientras lhe/lhes representa complemento indirecto.",
      "claimType": "orthography",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F78129448CEC893565F61E04",
      "sectionKey": "Observación importante",
      "summary": "El uso real presenta variación regional: lhe puede asociarse especialmente al interlocutor y, en algunas variedades, extenderse a funciones distintas de la indirecta tradicional.",
      "claimType": "regional_variation",
      "materiality": "substantial"
    }
  ],
