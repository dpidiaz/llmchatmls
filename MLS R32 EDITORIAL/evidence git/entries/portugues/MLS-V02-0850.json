      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AAD7EE441F7B470B23E7BD8D",
      "sectionKey": "Observación importante",
      "summary": "No existe una equivalencia obligatoria 'aqui → lá'. Si el punto espacial sigue siendo el mismo, mantener 'aqui' es correcto.",
      "claimType": "orthography",
      "materiality": "substantial"
    }
