  "claims": [
    {
      "claimId": "MLS-CLM-6BB8FE8B068D11B58BA7BD53",
      "sectionKey": "Dar certo es una colocación brasileña muy frecuente que significa “funcionar”, “salir bien” o “tener buen resultado”",
      "summary": "The expression 'dar certo' is a common Brazilian usage meaning 'to work', 'to go well', or 'to have a good result'.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8F571468C9F729491E4001BB",
      "sectionKey": "Cómo funciona",
      "summary": "The expression is conjugated through 'dar': 'dá certo, deu certo, dava certo, vai dar certo'.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-19FF515AF8C651C7A1BC5535",
      "sectionKey": "Ejemplos",
      "summary": "Examples include 'O plano deu certo', 'Vai dar certo!', 'Esse método sempre dá certo', and 'Se no der certo, tentamos novamente'.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7B5665C657A1935145CA19CD",
      "sectionKey": "Observación importante",
      "summary": "The expression 'dar certo' does not mean the same as 'estar certo'. 'Está certo' can mean 'is correct' while 'deu certo' indicates that something worked or produced the expected result.",
      "claimType": "orthography",
      "materiality": "substantial"
    }
  ],
