  "claims": [
    {
      "claimId": "MLS-CLM-3CA8CA3D4D200413E8C2F45B",
      "sectionKey": "En pocas palabras",
      "summary": "Las palabras terminadas en -l suelen formar el plural cambiando esa terminación. El resultado depende de la vocal que aparece antes de la l.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2EC54768D5AA1F0BC206E4B4",
      "sectionKey": "Cómo funciona",
      "summary": "Son frecuentes los patrones -al → -ais, -el → -éis/-eis, -ol → -óis/-ois y -ul → -uis: animal → animais, papel → papéis, farol → faróis, azul → azuis.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-366F24B306DBD733BA5FED73",
      "sectionKey": "Con -il interviene también la posición del acento",
      "summary": "Muchas oxítonas forman -is, como funil → funis; muchas paroxítonas forman -eis, como fácil → fáceis.",
      "claimType": "historical",
      "materiality": "substantial"
    }
  ],
