      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E8A4237798FEB7A51FF7E103",
      "sectionKey": "Cómo funciona",
      "summary": "Spanish normally keeps words separate, while Portuguese has a more extensive system including contractions like do livro, da escola, no Brasil, na mesa.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-83CB3FC2E8BD62A3778DBABC",
      "sectionKey": "Ejemplos",
      "summary": "Portuguese examples include 'O título do livro', 'Saí da escola', 'Moro no Brasil', 'A chave está na mesa'.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AEAE4065AA1DF269375D7E64",
      "sectionKey": "Observación importante",
      "summary": "Literal translations like 'en el → em o' or 'de la → de a' are not recommended in standard Portuguese.",
      "claimType": "orthography",
      "materiality": "substantial"
    }
