  "claims": [
    {
      "claimId": "MLS-CLM-17C52042959843BB6502BAC5",
      "sectionKey": "En pocas palabras",
      "summary": "A relative prepositioned pronoun maintains the preposition before the relative pronoun, which is required by the verb, noun, or construction of the subordinate clause.",
      "claimType": "normative",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CC527388295DA1DD23AB7ABC",
      "sectionKey": "En O assunto de que falamos é importante",
      "summary": "The preposition 'de' appears because it is required by the verb 'falar de um assunto'.",
      "claimType": "normative",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-ED653D0E4DAB04DACB741E18",
      "sectionKey": "Cómo funciona",
      "summary": "The preposition is not chosen by the relative alone; it comes from the internal structure of the subordinate clause.",
      "claimType": "historical",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-526B8745C00711584F01F959",
      "sectionKey": "Cómo funciona",
      "summary": "The relative can be 'que, quem, o qual/a qual' or another form compatible with the antecedent and preposition.",
      "claimType": "historical",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2249D98278D835B194B3720B",
      "sectionKey": "Ejemplos",
      "summary": "Examples demonstrate the use of prepositioned relatives, such as 'O assunto de que falamos é importante' and 'A pessoa com quem trabalho chegou cedo'.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
