      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-92D187B7D4EA2399969E5241",
      "sectionKey": "En Os jovens chegaram cedo",
      "summary": "In the example 'Os jovens chegaram cedo', 'jovens' functions nominally, meaning 'the young ones'.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B24B10103E148CBC63E0AC9B",
      "sectionKey": "Como funciona",
      "summary": "The article or determiner helps show the nominalized usage, such as 'o jovem, os jovens, a responsável, os pobres'.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D5682A47856FF6062D5A9ABC",
      "sectionKey": "Observação importante",
      "summary": "The substantivation is contextual and depends on the presence of a noun or determiner.",
      "claimType": "general",
      "materiality": "substantial"
    }
