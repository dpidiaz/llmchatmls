    "language": "espanol-guatemala",
    "languageName": "Español de Guatemala",
    "title": "Modo y modalidad",
    "level": "G3",
    "part": "Subjuntivo y modo / Subjunctive and mood",
    "chapter": "Modo, indicativo y subjuntivo / Mood, indicative, and subjunctive"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 4,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-7B9403EF91D3CD0221BC29F4",
      "sectionKey": "En pocas palabras",
      "summary": "En la descripción gramatical tradicional del español se reconocen tres paradigmas modales: indicativo, subjuntivo e imperativo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-EED40A4E3AE339C1C5DE5564",
      "sectionKey": "En pocas palabras",
      "summary": "El modo es una categoría de flexión verbal, mientras que la modalidad es un concepto más amplio relacionado con la interpretación de los enunciados.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F1BAB9293015CF148FF78B67",
      "sectionKey": "En pocas palabras",
      "summary": "La flexión modal puede expresar varios valores y participar en actos verbales, selección sintáctica y grados de compromiso del hablante.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8E50D645EABAA9A59E44814B",
      "sectionKey": "Indicativo",
      "summary": "Los predicados de comunicación presentan habitualmente como cierta o asumida la información de sus complementos en indicativo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-388DDA5E2C152ABFCCCA6623",
      "sectionKey": "Indicativo",
      "summary": "El indicativo no expresa necesariamente certeza absoluta: formas indicativas pueden aparecer en usos modalizados, como el futuro de conjetura.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1F090A3B19B602617BD19823",
      "sectionKey": "Subjuntivo",
      "summary": "El subjuntivo no equivale sin excepción a duda o irrealidad, pues también aparece en complementos factivos cuyo contenido se presupone verdadero.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4D6A5C6FDFE7629EAC0443A6",
      "sectionKey": "Subjuntivo",
      "summary": "Los predicados de voluntad e intención, como querer, suelen seleccionar el subjuntivo en sus subordinadas sustantivas.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FE1CC43A9D4A76C41BBB921E",
      "sectionKey": "Subjuntivo",
      "summary": "Los predicados de afección como alegrar suelen construirse con subjuntivo, incluso cuando el contenido subordinado se da por conocido o cierto.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4E81BA3CAE5BFCC5C7A1F716",
      "sectionKey": "Dependencia sintáctica",
      "summary": "Los predicados de adquisición o posesión de conocimientos, como saber, se construyen típicamente con indicativo en sus complementos.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-41193AD62EE8B715019D54A6",
      "sectionKey": "Dependencia sintáctica",
      "summary": "Los predicados de duda y posibilidad pueden inducir subjuntivo en la subordinada.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7083EA8DC7F36D02501F0D37",
      "sectionKey": "Subjuntivo",
      "summary": "En Quiero que vengás, el predicado de voluntad querer selecciona una oración subordinada en subjuntivo.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-86E87A1BACBCDD82CBEAB4E2",
      "sectionKey": "Subjuntivo",
      "summary": "El DPD documenta el voseo centroamericano y formas de presente de subjuntivo voseante en Guatemala, como las formas en -és/-ás que corresponden al ejemplo vengás.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-59FB119D87587C0C5BA8721A",
      "sectionKey": "Imperativo",
      "summary": "Los enunciados imperativos expresan actos directivos dirigidos a un destinatario y emplean formas del paradigma imperativo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2742E7C2C4EA9E17286F9F8E",
      "sectionKey": "Imperativo",
      "summary": "Vení es una forma singular voseante de imperativo del verbo venir.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6B18C76395A0D6AA2EEF2B25",
      "sectionKey": "Imperativo",
      "summary": "Los imperativos negativos se forman con el paradigma del subjuntivo, como en no vengás.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0405B3AA88FF31FE0D2C56D2",
      "sectionKey": "Modalidad",
      "summary": "Los adverbios de duda y posibilidad, como quizá, admiten subjuntivo en determinados contextos, especialmente cuando preceden al verbo: Quizá venga mañana.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-965AAD39A61FE91C8D5E8F72",
      "sectionKey": "Modalidad",
      "summary": "La perífrasis tener que + infinitivo expresa obligación o necesidad en su lectura radical, como en tiene que venir.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F12EAA2104C27E63D72E23F6",
      "sectionKey": "Modalidad",
      "summary": "Ojalá + subjuntivo es una construcción desiderativa independiente, como en ojalá venga.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-76BDA733D3666F3C847D075A",
      "sectionKey": "Modalidad",
      "summary": "Los predicados de valoración, como bueno, inducen subjuntivo en subordinadas sustantivas como es bueno que venga.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3FAC4417E2051405241C261B",
      "sectionKey": "Dependencia sintáctica",
      "summary": "El subjuntivo puede aparecer en construcciones independientes, como ojalá llueva y que todo salga bien.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
