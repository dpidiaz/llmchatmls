  "claims": [
    {
      "claimId": "MLS-CLM-14EA16F13A1E96C6139A6672",
      "sectionKey": "En pocas palabras",
      "summary": "Los verbos intransitivos de cambio de estado presentan un sujeto que experimenta una transición y pueden aparecer con o sin pronombre según el verbo y la construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A3DEE0A405483C755821DD1F",
      "sectionKey": "Cómo funciona",
      "summary": "En variantes pronominales como romperse, el sujeto representa la entidad que experimenta el cambio de estado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-70F1EF0C5510C22C0F07D2F8",
      "sectionKey": "Cómo funciona",
      "summary": "Algunos verbos expresan un cambio de estado sin pronombre, y no existe una regla que haga pronominal a todo verbo de cambio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-565B9E4D4B7462E58DA4F027",
      "sectionKey": "Cómo funciona",
      "summary": "Las variantes pronominales pueden relacionarse con variantes transitivas causativas, aunque la alternancia depende del verbo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1A796A99A114BA3AC0D047C6",
      "sectionKey": "Observación importante",
      "summary": "La selección de una forma pronominal o no pronominal depende de las propiedades léxicas y sintácticas del verbo, no de una regla general única.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
