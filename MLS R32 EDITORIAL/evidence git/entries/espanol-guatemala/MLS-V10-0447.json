    "title": "Contextos que imponen el modo indicativo",
    "level": "G3",
    "part": "Subjuntivo y modo / Subjunctive and mood",
    "chapter": "Modo, indicativo y subjuntivo / Mood, indicative, and subjunctive"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 2,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-D3A06A9DA431631A1D0B9020",
      "sectionKey": "En pocas palabras",
      "summary": "Predicados afirmativos de conocimiento, comunicación o percepción tienden a seleccionar indicativo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8CFC591A496B4EB79E262734",
      "sectionKey": "En pocas palabras",
      "summary": "El indicativo no se reduce a hechos ciertos; puede expresar contenidos modalizados o futuros.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-105F09F15AE1C88DB10F833A",
      "sectionKey": "Verbos de conocimiento y constatación",
      "summary": "Saber y otros predicados de conocimiento seleccionan indicativo en sus complementos oracionales.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7EEBFCF50AF413C4A04BB419",
      "sectionKey": "Verbos de conocimiento y constatación",
      "summary": "Comprobar y demostrar pueden introducir indicativo cuando presentan el contenido como constatado.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FEDCE02B993CA9271030C9CD",
      "sectionKey": "Verbos de comunicación y afirmación",
      "summary": "Predicados de comunicación como afirmar y decir suelen introducir indicativo si transmiten información.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BFA92D2BC05A868B00AA57B9",
      "sectionKey": "Verbos de comunicación y afirmación",
      "summary": "El mismo verbo comunicativo puede llevar subjuntivo cuando se reinterpreta como petición u orden.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-95DABA7742160843EC1DABA0",
      "sectionKey": "Percepción y evidencia",
      "summary": "Predicados de percepción como ver y oír inducen indicativo en sus complementos.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-617B7441006E49BD2D76B654",
      "sectionKey": "Percepción y evidencia",
      "summary": "Expresiones de certeza como evidente y claro favorecen el indicativo en subordinadas.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E01EC213B56FC54B0E948815",
      "sectionKey": "Relativas con referente identificado",
      "summary": "El modo en una oración relativa depende también de la interpretación específica o inespecífica del grupo nominal.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0AF16E39AA17494F15B512AB",
      "sectionKey": "Relativas con referente identificado",
      "summary": "Los verbos intensionales como buscar inducen subjuntivo en relativas inespecíficas, en contraste con relativas con referente establecido.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7AB7D60B3B6E02ACB41069AB",
      "sectionKey": "Temporales realizadas o habituales",
      "summary": "El modo dependiente está determinado por el inductor y por las características de la construcción subordinada.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CA7B79189518EEAF51E659F4",
      "sectionKey": "Observación importante",
      "summary": "El indicativo puede aparecer con futuro de conjetura y no implica por sí mismo certeza absoluta.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-91C510C72189DFA2683B205B",
      "sectionKey": "Observación importante",
      "summary": "La negación es un inductor modal que puede cambiar el modo seleccionado en una subordinada.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-441750AFDF4C0393447FE4DB",
      "sectionKey": "Observación importante",
      "summary": "Los contextos de selección modal dependen conjuntamente de variables léxicas y sintácticas.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-847FEEAC362E05C500D658A0",
      "sectionKey": "Ejemplos",
      "summary": "Los predicados de adquisición o posesión de conocimientos construyen sus complementos con indicativo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-394DF8D74E72ED3BE03E25B9",
      "sectionKey": "Ejemplos",
      "summary": "Una subordinada de relativo puede alternar de modo según el antecedente se entienda como específico o inespecífico.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
