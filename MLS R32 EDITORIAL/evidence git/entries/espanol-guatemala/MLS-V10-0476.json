  "claims": [
    {
      "claimId": "MLS-CLM-06A7B91EE44ECEAAA648844D",
      "sectionKey": "En pocas palabras",
      "summary": "El gerundio puede construirse con un sujeto expreso que identifica a quien participa en la situación del gerundio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8368B500156C7EA573BD3E78",
      "sectionKey": "Cómo funciona",
      "summary": "Las construcciones absolutas de gerundio pueden contener un sujeto propio relativamente independiente de la oración principal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A0C2C975C8C6531A38DDDCF0",
      "sectionKey": "Cómo funciona",
      "summary": "El sujeto expreso puede diferir del sujeto de la oración principal y aparecer pospuesto al gerundio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CD5DD132EF60B4FD1F0897C5",
      "sectionKey": "Cómo funciona",
      "summary": "El gerundio compuesto puede aparecer con un sujeto expreso y expresar anterioridad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-57A454803495A1DD5DBB1D06",
      "sectionKey": "Cómo funciona",
      "summary": "Un gerundio con sujeto tácito correferente al sujeto principal se distingue de una construcción absoluta con sujeto expreso propio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-187C68153E1CDA40757FAC8E",
      "sectionKey": "Cómo funciona",
      "summary": "Las construcciones con sujeto expreso pueden recibir lecturas temporales, causales u otras según el contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0797871E6E47B0E2A25E0ABA",
      "sectionKey": "Ejemplos",
      "summary": "Estando Ana en la oficina, comenzó la reunión contiene un sujeto expreso del gerundio distinto del sujeto principal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-46D8A2BDBE020D15AD1FEB48",
      "sectionKey": "Ejemplos",
      "summary": "Habiendo Marta terminado el informe presenta sujeto expreso con gerundio compuesto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-05746C4C8558E4B4027B00E4",
      "sectionKey": "Observación importante",
      "summary": "Sujeto expreso significa que el grupo nominal es participante de la predicación del gerundio, no solo un nombre cercano.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-9E0FC7BBF6A5B78154297978",
      "sectionKey": "Observación importante",
      "summary": "El gerundio con sujeto expreso puede expresar estados, acciones y procesos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
