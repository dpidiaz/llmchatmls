  "claims": [
    {
      "claimId": "MLS-CLM-CC9984E2191C6133E151783B",
      "sectionKey": "En pocas palabras",
      "summary": "Las interrogativas directas presentan una pregunta como enunciado independiente y pueden solicitar información o cumplir otras funciones comunicativas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-63A395C040616FB63E504E3C",
      "sectionKey": "Cómo funciona",
      "summary": "En la escritura, las interrogativas directas se delimitan normalmente con signos de apertura y cierre; en el habla contribuyen la entonación y la estructura.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-9D7EC45D9726C653228D3C45",
      "sectionKey": "Cómo funciona",
      "summary": "Las interrogativas directas pueden ser totales, cuando preguntan por la proposición completa, o parciales, cuando preguntan por un constituyente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3ED5F775FBC4E1B54915CDAC",
      "sectionKey": "Cómo funciona",
      "summary": "Una interrogativa directa puede realizar una pregunta informativa o una petición indirecta según el contexto y la relación entre interlocutores.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CE82CAEEC13A288F97919D6D",
      "sectionKey": "Observación importante",
      "summary": "La interpretación interrogativa se establece por la forma, la entonación y el contexto, y no se reduce a una inversión obligatoria del orden sujeto-verbo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
