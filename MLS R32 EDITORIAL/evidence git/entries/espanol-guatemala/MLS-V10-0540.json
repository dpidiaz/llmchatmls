      "claimId": "MLS-CLM-6DDD32D119553A90AC496109",
      "sectionKey": "En pocas palabras",
      "summary": "Los sujetos coordinados suelen activar concordancia verbal plural por la interpretación conjunta de sus miembros.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-10413EAFDF5BF2FDF952225A",
      "sectionKey": "Cómo funciona",
      "summary": "Dos miembros de tercera persona suelen llevar verbo plural; la inclusión de primera persona puede producir primera persona plural.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E4241F009EB65977643B743E",
      "sectionKey": "Cómo funciona",
      "summary": "Las construcciones correlativas y sujetos guatemaltecos con vos más un tercer participante pueden requerir concordancia plural de tercera persona.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E24F7BB46F75D91A20D5EC93",
      "sectionKey": "Cómo funciona",
      "summary": "Si los elementos coordinados son complementos y no sujeto, la concordancia verbal sigue dependiendo del sujeto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-196D0F95FFB31DD5AF5A07AC",
      "sectionKey": "Ejemplos",
      "summary": "Ana y Luis llegaron, Ana y yo llegamos y tanto Ana como Luis llegaron ilustran concordancia con sujeto coordinado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F752FDCD2CE424E587F3B2D4",
      "sectionKey": "Observación importante",
      "summary": "La pauta general de plural admite variantes condicionadas por posición e interpretación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
