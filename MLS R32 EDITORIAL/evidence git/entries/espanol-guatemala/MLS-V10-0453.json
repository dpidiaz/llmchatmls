    "title": "Inductores modales en las subordinadas relativas",
    "level": "G5",
    "part": "Subjuntivo y modo / Subjunctive and mood",
    "chapter": "Modo, indicativo y subjuntivo / Mood, indicative, and subjunctive"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 2,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-E9FF55C3A56087CEDD381C34",
      "sectionKey": "En pocas palabras",
      "summary": "Las relativas modifican un antecedente nominal y la selección modal depende de su interpretación, incluyendo identificación, búsqueda, negación y proyección.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0226F29EC1F09496C37DFBDE",
      "sectionKey": "En pocas palabras",
      "summary": "Con antecedente identificado suele aparecer indicativo; en búsqueda de un antecedente no identificado puede aparecer subjuntivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-35E6371D846C22512556DF4E",
      "sectionKey": "Antecedentes identificados",
      "summary": "El indicativo en relativas favorece una lectura específica del antecedente indefinido, aunque no equivale sin excepción a existencia o definitud.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-20A9024064615FF126AF8047",
      "sectionKey": "Antecedentes no identificados",
      "summary": "Los predicados como buscar crean contextos opacos que favorecen relativas inespecíficas en subjuntivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-37C24F8FBCDC21A42290BA69",
      "sectionKey": "Negación e inexistencia",
      "summary": "Los indefinidos negativos como nadie pueden inducir subjuntivo en la relativa.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-48D763CD0501153ABE35A9EC",
      "sectionKey": "Superlativos y valoración",
      "summary": "Cuantificadores superlativos como más pueden inducir subjuntivo en relativas, con posibilidad de alternancia con indicativo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A7CEAAC6D9B66EC54BB8C6E2",
      "sectionKey": "Referencia futura o hipotética",
      "summary": "Las relativas de antecedentes no identificados o proyectados pueden aparecer en subjuntivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-03934B980CA8CFC3515A0376",
      "sectionKey": "Referencia futura o hipotética",
      "summary": "Los predicados de búsqueda o necesidad pueden favorecer subjuntivo en relativas de propiedades requeridas para un referente no identificado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F5BFD1CC2CDA27AA3F93F1CF",
      "sectionKey": "El papel de la especificidad",
      "summary": "Indicativo e interpretación específica, y subjuntivo e interpretación inespecífica, forman una correlación aproximada, no absoluta.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0C79CED3E0B0FC2045BB57ED",
      "sectionKey": "El papel de la especificidad",
      "summary": "Especificidad y existencia no son conceptos equivalentes y no permiten inferir automáticamente inexistencia a partir del subjuntivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4C4EAB850EF4E9D9C2C7C670",
      "sectionKey": "Ejemplos",
      "summary": "Conozco a una médica que trabaja aquí y Buscan una médica que trabaje aquí ilustran el contraste de identificación del referente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7D49A1CC8872FA8F4EA109EE",
      "sectionKey": "Ejemplos",
      "summary": "La persona que llegue primero puede presentar un antecedente cuya identidad no se conoce antes del evento futuro.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-320D8048B5E44061BDDDA185",
      "sectionKey": "Observación importante",
      "summary": "El subjuntivo relativo no es una marca general de irrealidad; la selección depende de inductores internos y externos y del modo de presentar la referencia.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
