  "claims": [
    {
      "claimId": "MLS-CLM-42C46B0B19597A34792821FD",
      "sectionKey": "En pocas palabras",
      "summary": "Cantaría es el condicional simple y cantaba el pretérito imperfecto; son formas diferentes que pueden aproximarse en algunos contextos.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-42F82B13FDCF3438DD59C821",
      "sectionKey": "En pocas palabras",
      "summary": "El imperfecto presenta situaciones pasadas y puede expresar hábitos o eventos en curso, mientras el condicional puede marcar posterioridad respecto de un pasado o valores modales.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BEB3B6F88618CFAEC16D3B20",
      "sectionKey": "Cómo funciona",
      "summary": "El condicional en discurso indirecto puede presentar una situación posterior respecto del momento pasado expresado por dijo.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-36B249F1BD382595225C567F",
      "sectionKey": "Cómo funciona",
      "summary": "El imperfecto prospectivo puede describir planes previstos desde un marco pasado y alternar en ciertos contextos con el condicional.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4D7D8D756988D0B9A808BF7F",
      "sectionKey": "Cómo funciona",
      "summary": "El imperfecto de cortesía puede atenuar una petición actual y alternar con el condicional simple en fórmulas de solicitud.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-06A1A930C470D7ADB1960B9F",
      "sectionKey": "Ejemplos",
      "summary": "En ciertos entornos hipotéticos puede alternar el imperfecto en la apódosis con el condicional, como en Si tuviera más tiempo, viajaba/viajaría más.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-69FF1B9F0D8722C33B39EF06",
      "sectionKey": "Observación importante",
      "summary": "El imperfecto habitual puede expresar una lectura que normalmente no equivale al condicional simple.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5203AEDD98410F12305786A0",
      "sectionKey": "Observación importante",
      "summary": "Las alternancias modales entre imperfecto y condicional se restringen a las construcciones y contextos donde están documentadas; no hacen intercambiables las formas en general.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
