      "sectionKey": "En pocas palabras",
      "summary": "Quedar puede funcionar como semicopulativo para presentar el estado o la propiedad resultante de un acontecimiento o cambio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
