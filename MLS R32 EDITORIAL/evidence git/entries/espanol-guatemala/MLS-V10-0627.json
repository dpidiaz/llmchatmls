      "sectionKey": "Cómo funciona",
      "summary": "Quedarse puede presentar el inicio de un estado del sujeto y su persistencia posterior, de acuerdo con el contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E79C4FDB6AE9F78381A58422",
      "sectionKey": "Cómo funciona",
      "summary": "Cuando quedar(se) lleva un atributo adjetival, este concuerda en género y número con el sujeto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BC600097A6760862AB625D66",
      "sectionKey": "Cómo funciona",
      "summary": "Los atributos que acompañan a quedar(se) pueden expresar estados o resultados, mientras el verbo aporta la relación de cambio o permanencia.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-05083DA14C0BF1389A8D4050",
      "sectionKey": "Observación importante",
      "summary": "Quedar(se) puede alternar con otros verbos de cambio solo en ciertos contextos; las diferencias de significado limitan la sustitución.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
