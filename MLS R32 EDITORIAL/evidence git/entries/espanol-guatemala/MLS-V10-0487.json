      "claimId": "MLS-CLM-44096F6831FD44613D3AA7D4",
      "sectionKey": "En pocas palabras",
      "summary": "Poder, tener que y deber + infinitivo son construcciones modales que pueden expresar valores distintos y sensibles al contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3338A23A2B9D930EB830FA47",
      "sectionKey": "Cómo funciona",
      "summary": "Poder + infinitivo expresa posibilidad o capacidad y en ciertos contextos permiso.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-38E6C7749625D87312DC4381",
      "sectionKey": "Cómo funciona",
      "summary": "Tener que + infinitivo suele expresar obligación o necesidad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
