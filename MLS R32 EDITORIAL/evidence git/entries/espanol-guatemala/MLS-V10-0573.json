  "claims": [
    {
      "claimId": "MLS-CLM-E360F9230A7ECFF08CC0C748",
      "sectionKey": "En pocas palabras",
      "summary": "El complemento directo se caracteriza por su relación con verbos transitivos, la sustitución pronominal y, en muchos casos, la posibilidad de convertirse en sujeto de una pasiva; ninguna prueba aislada es absoluta.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-879644C60BB59FC9D8CA01C9",
      "sectionKey": "Cómo funciona",
      "summary": "El complemento directo puede llevar la preposición a con referentes personales y esta marca no lo convierte por sí misma en complemento indirecto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-68AE4D7E959D30D1F3B049D4",
      "sectionKey": "Cómo funciona",
      "summary": "Los complementos directos pueden representar papeles semánticos diversos, como entidades afectadas, creadas o percibidas, y no se reducen a un único papel de paciente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1F5ABDC5510627109E97FE39",
      "sectionKey": "Cómo funciona",
      "summary": "Una oración subordinada puede desempeñar la función de complemento directo de un verbo de comunicación o cognición.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4371212D88D66A6933ABD98C",
      "sectionKey": "Forma y posición",
      "summary": "El complemento directo puede aparecer antepuesto al verbo y retomado por un pronombre átono; el orden lineal no determina por sí solo la función.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
