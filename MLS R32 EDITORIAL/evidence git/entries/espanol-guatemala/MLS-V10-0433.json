  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-B6EA7BD075A967C6CB08022E",
      "sectionKey": "En pocas palabras",
      "summary": "La elección del subjuntivo depende de los inductores y de la construcción en que aparece, no de una equivalencia general con la duda.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-49E62B722EFE67E22D84CE82",
      "sectionKey": "En pocas palabras",
      "summary": "El presente de subjuntivo puede referirse al presente o al futuro; el nombre del tiempo no fija por sí solo el momento del evento.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4B9B9A77D21B3768CA71493F",
      "sectionKey": "Cómo funciona",
      "summary": "En Espero que vengás temprano, el verbo de deseo/espera induce el subjuntivo y la forma tiene interpretación prospectiva.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0FD905A6D17A81FB7680B2B9",
      "sectionKey": "Cómo funciona",
      "summary": "El pretérito perfecto compuesto de subjuntivo se forma con haber en presente de subjuntivo más un participio invariable.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3747695796CC3831B6A59F33",
      "sectionKey": "El presente de subjuntivo",
      "summary": "El presente de subjuntivo presenta formas regulares como cante, cantes, cantemos, coma y viva, además de paradigmas irregulares como sea, vaya y tenga.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7F8B4D057C3FD7DB412203FD",
      "sectionKey": "El presente de subjuntivo",
      "summary": "El voseo verbal es general en Guatemala y se acepta en la norma culta centroamericana en contextos familiares.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-272AF9C55024C60E4F6A5D9B",
      "sectionKey": "El presente de subjuntivo",
      "summary": "El DPD documenta para Guatemala formas voseantes del presente de subjuntivo como cantés, comás y vivás, que alternan en el uso con formas de tuteo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-68E0A2D2977DFE9AC737BD25",
      "sectionKey": "El pretérito perfecto de subjuntivo",
      "summary": "Haya cantado puede expresar anterioridad respecto del presente o respecto de un punto futuro, según el contexto que lo induce.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AE829DB538F4C75D139B4B20",
      "sectionKey": "Ejemplos",
      "summary": "En Cuando hayamos cerrado la oficina, nos iremos, el cierre se interpreta como anterior a la situación futura de irse.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B89AB69AADCAFB969C0EB07D",
      "sectionKey": "Observación importante",
      "summary": "El subjuntivo puede aparecer en construcciones factivas que presuponen la verdad de la situación, como Me alegra que estés aquí.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6A40A660AF3808316D1D1CC6",
      "sectionKey": "Observación importante",
      "summary": "El presente de subjuntivo y el pretérito perfecto compuesto se interpretan en relación con la construcción y el punto temporal pertinente, y no solo por su etiqueta temporal.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
