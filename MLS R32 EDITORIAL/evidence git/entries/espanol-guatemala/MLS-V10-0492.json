      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-90BF2E5E10039A3950519B69",
      "sectionKey": "Cómo funciona",
      "summary": "En varias perífrasis, un clítico puede aparecer con el auxiliar o ligado al gerundio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
