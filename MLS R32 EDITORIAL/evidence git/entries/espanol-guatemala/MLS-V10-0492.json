      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-78C0F634CE780F6A450CA536",
      "sectionKey": "Cómo funciona",
      "summary": "El tiempo de estar sitúa temporalmente la perífrasis, con gerundio invariable.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6ED78F161CC191597909262B",
      "sectionKey": "Cómo funciona",
      "summary": "Seguir + gerundio expresa continuidad de una situación previa.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-763257C9CDB75D79EBFE9979",
      "sectionKey": "Cómo funciona",
      "summary": "Llevar + gerundio puede expresar duración acumulada hasta el punto de referencia.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6CFFD036D46D8E8B81621009",
      "sectionKey": "Cómo funciona",
      "summary": "Ir + gerundio presenta progresión gradual o desarrollo por etapas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2A3EA56B3FC594D21DC85F2D",
      "sectionKey": "Cómo funciona",
      "summary": "Estas perífrasis suelen compartir el sujeto entre auxiliar y gerundio.",
