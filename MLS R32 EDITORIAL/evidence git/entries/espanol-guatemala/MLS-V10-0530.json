  "claims": [
    {
      "claimId": "MLS-CLM-DADADDA9F9CED0DBAA6AE263",
      "sectionKey": "En pocas palabras",
      "summary": "Los conectores discursivos se clasifican por la relación interpretativa que establecen, como contraste, consecuencia, adición y reformulación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7633B4E1DB22639FB7CAB555",
      "sectionKey": "Cómo funciona",
      "summary": "Sin embargo, no obstante y en cambio pueden expresar contraste o expectativa contraria.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AFCE0F78D0964D577CE4CD83",
      "sectionKey": "Cómo funciona",
      "summary": "Por tanto, por consiguiente y en consecuencia pueden presentar una consecuencia o conclusión.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0D8E20BE3A34B8424F600FE7",
      "sectionKey": "Cómo funciona",
      "summary": "Además, asimismo y igualmente pueden introducir adición; es decir y en otras palabras pueden reformular.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F2E632E9D5A93707A67E068E",
      "sectionKey": "Cómo funciona",
      "summary": "Una misma expresión puede variar de valor según la relación contextual entre segmentos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-18353A4348B7E47CA6BD7DE5",
      "sectionKey": "Ejemplos",
      "summary": "Los ejemplos distinguen contraste, consecuencia, adición y reformulación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5BA30DB1DCBE274C1689DC4A",
      "sectionKey": "Observación importante",
      "summary": "La clasificación no asigna una función fija fuera del contexto y las subclases pueden solaparse.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
