  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-F7BBCC6F001C903AF9561605",
      "sectionKey": "En pocas palabras",
      "summary": "Estar + participio suele presentar un estado resultante y el participio concuerda con el sujeto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D669AB947DAB4E4C769D2C51",
      "sectionKey": "Cómo funciona",
      "summary": "Estar aporta flexión verbal y el participio concuerda en género y número con el sujeto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C04D359CB9F9E140843A0740",
      "sectionKey": "Cómo funciona",
      "summary": "La lectura resultativa relaciona el estado con un cambio previo aunque el evento no se exprese.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0CC447BCC99AAED70EFA923F",
      "sectionKey": "Cómo funciona",
      "summary": "Estar + participio se distingue de ser + participio pasivo, que enfoca el evento y puede admitir complemento agente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-9015CAB8FD4EB475D15F82C5",
      "sectionKey": "Cómo funciona",
      "summary": "Estar + participio se distingue de haber + participio, en el que el participio permanece invariable.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-EB9131D9F3B03772C6543099",
      "sectionKey": "Cómo funciona",
      "summary": "La interpretación de estar + participio depende del significado verbal y no es igualmente natural con todos los verbos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F2615D352EBA846EFF223E02",
      "sectionKey": "Cómo funciona",
      "summary": "Algunos participios con estar se acercan a usos adjetivales, con límites graduales.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-154A3E35026E5D0BCE0D71F3",
      "sectionKey": "Ejemplos",
      "summary": "La puerta está cerrada presenta estado resultante y concordancia.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-85448A8C85770567CAC759AA",
      "sectionKey": "Ejemplos",
      "summary": "La puerta fue cerrada por Marta presenta pasiva con ser y agente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-09E0BC4D74F85151BF1BB10B",
      "sectionKey": "Ejemplos",
      "summary": "Ana ha escrito la carta presenta un tiempo compuesto con participio invariable.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E12EFF3E733FBC65BA1B8CF8",
      "sectionKey": "Observación importante",
      "summary": "Estar + participio no equivale simplemente a una pasiva en presente: su lectura prototípica es estativa o resultativa.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FCE98F8D0C2948A75D8688C7",
      "sectionKey": "Observación importante",
      "summary": "La frontera entre participio y adjetivo puede ser gradual y se analiza por sintaxis y significado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
