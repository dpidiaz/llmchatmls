  "claims": [
    {
      "claimId": "MLS-CLM-23273C5F426D92F6FA6555A9",
      "sectionKey": "En pocas palabras",
      "summary": "La transitividad es una propiedad sintáctica de las construcciones verbales relacionadas con la selección de un complemento directo; no es un único papel semántico del objeto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FF87F1D147F0D7A0BD9B46BC",
      "sectionKey": "Cómo funciona",
      "summary": "Los verbos transitivos pueden seleccionar complementos directos nominales, oracionales o ambos, según las propiedades léxicas y la construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-55B803B5D5EAF421E30E54C0",
      "sectionKey": "Cómo funciona",
      "summary": "El objeto directo puede omitirse en usos absolutos y recuperarse sintácticamente, léxicamente o por el contexto, sin que todos esos usos conviertan al verbo en intransitivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7293A7AB3ABFF2CF2B9CA5FF",
      "sectionKey": "Transitividad y valencia",
      "summary": "Un mismo verbo puede alternar entre usos transitivos e intransitivos o presentar cambios de régimen y significado; el comportamiento se determina para cada construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
