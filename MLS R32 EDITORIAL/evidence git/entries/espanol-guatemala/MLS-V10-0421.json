  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-B472681C9DF657EAB07DE304",
      "sectionKey": "En pocas palabras",
      "summary": "El modo de acción es una propiedad del predicado, no solo del verbo, y se describe mediante clases de situaciones como estados, actividades, realizaciones y logros.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-152A73ECBCAF684C05286F65",
      "sectionKey": "En pocas palabras",
      "summary": "Las clases aspectuales difieren en duración y delimitación; llegar es un logro puntual y vivir o saber pueden expresar estados durativos.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-52983CD38D869CC9319D2818",
      "sectionKey": "Cómo funciona",
      "summary": "Los complementos pueden cambiar la clase aspectual: leer puede ser actividad y leer el contrato completo una realización delimitada.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5C974BE742F829D4A8542251",
      "sectionKey": "Cómo funciona",
      "summary": "El estado expresado por vivir puede incluir el momento de habla, mientras que llegar denota una transición y el pretérito simple lo presenta como evento concluido.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4668393C59BCB8BE8AEA9567",
      "sectionKey": "Cómo funciona",
      "summary": "Un complemento temporal como ahora puede inducir una lectura de hecho recién ocurrido con una forma de pasado en variedades que emplean el simple para acciones pasadas.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-83E7B64EAAC4041CB4E4440B",
      "sectionKey": "Ejemplos",
      "summary": "El pretérito perfecto simple presenta un evento con límites; el imperfecto suele mostrarlo en curso y sin enfocar sus límites.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FB2725625A7CADC6AA250ED1",
      "sectionKey": "Observación importante",
      "summary": "El contexto sintáctico y los complementos participan en la interpretación aspectual del predicado completo.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
