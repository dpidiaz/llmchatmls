    "title": "Contextos de modo independiente",
    "level": "G3",
    "part": "Subjuntivo y modo / Subjunctive and mood",
    "chapter": "Modo, indicativo y subjuntivo / Mood, indicative, and subjunctive"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 2,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-DB8ED3F0A6B35C5AA14760BC",
      "sectionKey": "En pocas palabras",
      "summary": "El subjuntivo independiente o no subordinado existe, aunque la NGLE lo caracteriza como un uso restringido.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-9CC561A7B4277869133DBCF2",
      "sectionKey": "Deseos y fórmulas optativas",
      "summary": "Los usos desiderativos del subjuntivo pueden construirse con que o sin esa conjunción.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-66A8D5E6000484480EF7C087",
      "sectionKey": "Deseos y fórmulas optativas",
      "summary": "Ojalá induce subjuntivo en una oración no subordinada y no admite alternancia con indicativo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-48ABED937762EC0A9341BFAD",
      "sectionKey": "Deseos y fórmulas optativas",
      "summary": "Que te vaya bien es un ejemplo de oración desiderativa autónoma con subjuntivo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-472E26F7E60416CC72EA8728",
      "sectionKey": "Posibilidad y duda",
      "summary": "Quizá y tal vez pueden inducir subjuntivo en oraciones no subordinadas y alternar con indicativo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-265DE3AD099E9E50DF697B57",
      "sectionKey": "Posibilidad y duda",
      "summary": "La posición preverbal es relevante para que quizá, tal vez o acaso induzcan subjuntivo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-51FDBD53BA63AA4B5B0F9026",
      "sectionKey": "Construcciones de valor exhortativo",
      "summary": "Las construcciones de subjuntivo en tercera persona pueden adquirir valor exhortativo, aunque su clasificación como imperativo es objeto de análisis.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B76CF377FC6D764A220A5E44",
      "sectionKey": "Construcciones de valor exhortativo",
      "summary": "Las formas negativas dirigidas a vos usan la flexión de subjuntivo, no el imperativo afirmativo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E8E599308BF1F56E1C293D48",
      "sectionKey": "Fórmulas fijadas",
      "summary": "Algunas fórmulas desiderativas con subjuntivo están lexicalizadas o semilexicalizadas.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-118346B4C01ED7EF7EF03FD8",
      "sectionKey": "El ejemplo condicional",
      "summary": "La selección modal en una cláusula dependiente la determina el inductor o la estructura de subordinación.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-432C6A279A242B962BDBEBC1",
      "sectionKey": "El ejemplo condicional",
      "summary": "Una cláusula desiderativa con ojalá no requiere un predicado matriz expreso, a diferencia de una subordinada como Dios quiera que…",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C7CFF02CAFFC144D6C59911F",
      "sectionKey": "Observación importante",
      "summary": "Independencia sintáctica no significa elección libre del modo: ojalá, adverbios de duda y otros inductores condicionan su aparición.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3B831A74BEF4FF4AC776CF1B",
      "sectionKey": "Observación importante",
      "summary": "El modo dependiente y la subordinación no son nociones equivalentes: un inductor puede aparecer en una oración no subordinada.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A20052A553A3DE7BF61915A8",
      "sectionKey": "Ejemplos",
      "summary": "Quizá/tal vez pueden alternar indicativo y subjuntivo con una ligera diferencia interpretativa.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6E3FA09B12EE9966B8E44B5D",
      "sectionKey": "Ejemplos",
      "summary": "La NGLE clasifica Que te vaya bien entre ejemplos de subjuntivo no subordinado desiderativo.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
