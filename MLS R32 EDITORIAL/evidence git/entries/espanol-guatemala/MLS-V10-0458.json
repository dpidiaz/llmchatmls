    "title": "Los infinitivos nominales de naturaleza sintáctica",
    "level": "G2",
    "part": "Formas no personales y perífrasis / Non-finite forms and periphrases",
    "chapter": "El infinitivo / The infinitive"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 3,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-F8467B13B84AE8B98211A5F8",
      "sectionKey": "En pocas palabras",
      "summary": "Los infinitivos nominales de naturaleza sintáctica pueden ocupar posiciones de un grupo nominal y conservar propiedades de verbo en su estructura interna.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4EEF314FAD3653687C032485",
      "sectionKey": "En pocas palabras",
      "summary": "La presencia de artículo ante el infinitivo no determina por sí sola que el infinitivo sea un sustantivo léxico.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-845CAEFAB70DDAC0CE98E5E2",
      "sectionKey": "Cómo funciona",
      "summary": "Un infinitivo con artículo puede funcionar como sujeto y mantener complementos verbales dentro de la oración.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F73BED30B7995389498D4A4D",
      "sectionKey": "Cómo funciona",
      "summary": "Un infinitivo verbal puede admitir complemento directo y modificadores adverbiales aun precedido de artículo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4F5A28F7908A35A580D460F3",
      "sectionKey": "Cómo funciona",
      "summary": "Los infinitivos nominales léxicos admiten rasgos nominales como plural y modificación adjetival, lo que los diferencia de muchas construcciones sintácticas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-669583D49E8C15B333EF8395",
      "sectionKey": "Cómo funciona",
      "summary": "Una oración de infinitivo puede ser sujeto sin artículo y conservar naturaleza verbal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D5540F22A0DD234679E21865",
      "sectionKey": "Cómo funciona",
      "summary": "Los sujetos expresos de los infinitivos son posibles en determinadas construcciones no dependientes y ciertos grupos nominales.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4A0B215EDA205219BBC622FC",
      "sectionKey": "Ejemplos",
      "summary": "El llegar tarde puede ser una construcción de infinitivo con posición nominal y modificador adverbial.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-718CDEEE53953D1F5422C5B4",
      "sectionKey": "Ejemplos",
      "summary": "Revisar datos con adverbio y objeto directo mantiene propiedades de grupo verbal aunque aparezca artículo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C945A6A8F84C21E8EF082345",
      "sectionKey": "Observación importante",
      "summary": "El artículo el delante de un infinitivo no basta para diagnosticar un sustantivo léxico; son decisivas las propiedades internas y de modificación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-9E1A01F0085553628CA84D93",
      "sectionKey": "Observación importante",
      "summary": "La nominalización sintáctica y los sustantivos lexicalizados como deber/deberes pertenecen a patrones distintos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
