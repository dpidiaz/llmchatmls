  "evidenceRevision": 2,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-FB2E37477DCCDFF205A93DAF",
      "sectionKey": "En pocas palabras",
      "summary": "Los adjuntos temporales de localización especifican el momento o el período en que ocurre una situación y su relación con el evento puede ser de coincidencia o inclusión.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-01685B17CB7E0C473D4ACC82",
      "sectionKey": "En pocas palabras",
      "summary": "Un adjunto temporal puede tener localización directa o localización indirecta/de fase, según cómo se combine con el tiempo y el aspecto del predicado.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4976724A751DA3B83183C016",
      "sectionKey": "Cómo funciona",
      "summary": "El rehén había muerto a las cuatro y media admite una lectura en la que esa es la hora de la muerte y otra en la que es un punto posterior para el cual el rehén ya había muerto.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4D05E8FB1E2137706AC3579C",
      "sectionKey": "Localización de fase",
      "summary": "Los adverbios de fase ya y todavía evocan estadios anteriores o posteriores a la situación expresada, y pueden ayudar a identificar una lectura indirecta/de fase.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1B8AF80B1FDB020B612FCF5D",
      "sectionKey": "Localización de fase",
      "summary": "En A las seis, Ana ya había salido, las seis puede ser un punto posterior a la salida y no la hora exacta en que ocurrió.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C1F8DE740350309BEF543EA0",
      "sectionKey": "Localización de fase",
      "summary": "En A las seis, Ana todavía no había salido, el punto temporal puede situarse dentro de una fase anterior a la salida.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-EA479FC4D13ACD0FEEC6C2F8",
      "sectionKey": "La importancia del tiempo verbal",
      "summary": "La interpretación de fase es característica de los tiempos compuestos, aunque está sujeta a excepciones y restricciones léxicas.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4B205F96C88E7ED9F6870032",
      "sectionKey": "Ejemplos",
      "summary": "Con un predicado imperfectivo como dormía, a las tres puede localizar un punto dentro del intervalo en que la persona dormía sin señalar el comienzo del sueño.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-449D1C7600A2FC95BE524F80",
      "sectionKey": "Ejemplos",
      "summary": "Con pretérito perfecto simple, A las ocho cerraron la tienda recibe la lectura de simultaneidad/localización directa, en contraste con la lectura de fase de A las ocho ya habían cerrado.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2E757DC113217BB8331A392E",
      "sectionKey": "Observación importante",
      "summary": "La localización directa/de fase describe la relación del adjunto temporal con la situación; no es una clasificación equivalente a pasado, presente o futuro.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-571DE3DFE16B0838E6616BF0",
      "sectionKey": "Observación importante",
      "summary": "Una oración condicional como Si tuviera tiempo, viajaría no ejemplifica por sí sola la oposición entre lecturas de un adjunto temporal porque no contiene uno.",
      "claimType": "example",
      "materiality": "substantial"
    }
  ],
