      "sectionKey": "Cómo funciona",
      "summary": "Los conectores organizan relaciones interpretativas entre oraciones, segmentos o argumentos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B78F3B7B231896B1EFCACACC",
      "sectionKey": "Cómo funciona",
      "summary": "Sin embargo, por tanto, además y es decir representan relaciones discursivas distintas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-075D2D7D46C64764D0489F47",
      "sectionKey": "Cómo funciona",
      "summary": "Los conectores pueden aparecer en posiciones periféricas y su posición no elimina necesariamente su función conectiva.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-39C6633656C81CE5076528C2",
      "sectionKey": "Cómo funciona",
      "summary": "Formas adverbiales o locuciones pueden adquirir función conectiva sin modificar simplemente el verbo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2D420D4DE89FBEDAE70BB39E",
      "sectionKey": "Ejemplos",
      "summary": "Los ejemplos ilustran contraste, adición, consecuencia y reformulación entre segmentos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1E484F6F58D35602937857B4",
      "sectionKey": "Observación importante",
      "summary": "Los conectores no enlazan indiscriminadamente palabras; establecen relaciones interpretativas entre segmentos discursivos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
