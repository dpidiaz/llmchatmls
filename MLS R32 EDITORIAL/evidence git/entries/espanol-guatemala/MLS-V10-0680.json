      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8D48D8CF8E068110629103DA",
      "sectionKey": "Cómo funciona",
      "summary": "La forma participial aislada no basta para identificar una pasiva; hay que considerar el verbo y la estructura en que aparece.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
