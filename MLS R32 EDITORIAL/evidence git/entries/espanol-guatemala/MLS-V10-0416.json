  "claims": [
    {
      "claimId": "MLS-CLM-592BB431B88881B890513FD7",
      "sectionKey": "En pocas palabras",
      "summary": "El presente se ancla prototípicamente al momento de habla, pero también expresa propiedades generales, hábitos y regularidades.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4F9833518E6C5A62843C5A49",
      "sectionKey": "Cómo funciona",
      "summary": "El presente puntual puede coincidir con el acto de habla, mientras que un estado como vivir en un lugar puede incluir el momento de habla sin limitarse a ese instante.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E0CB928405A7AA160D592BC0",
      "sectionKey": "Cómo funciona",
      "summary": "El presente expresa propiedades generales o caracterizadoras bajo condiciones pertinentes, sin afirmar que el evento ocurra en el instante de habla.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-46CD84C0A3D660B72E9CFB80",
      "sectionKey": "Cómo funciona",
      "summary": "El agua hierve aproximadamente a 100 °C a presión atmosférica estándar.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A09F5BF51EAF4A4EA2870778",
      "sectionKey": "Ejemplos",
      "summary": "El presente puede expresar hábitos y sucesos recurrentes, no solo sucesos simultáneos al habla.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7C587F59CD3E7D589394816B",
      "sectionKey": "Observación importante",
      "summary": "Una lectura habitual o generalizadora no implica que la acción ocurra continuamente o en cada intervalo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E95EA7232CD4D3532F4F3B2C",
      "sectionKey": "Observación importante",
      "summary": "No todos los usos del presente son estrictamente simultáneos al habla; el contexto y los valores retrospectivos o prospectivos amplían su interpretación.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
