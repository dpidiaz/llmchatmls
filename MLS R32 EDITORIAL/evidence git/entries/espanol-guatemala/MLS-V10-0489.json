  "claims": [
    {
      "claimId": "MLS-CLM-745D47D959262B1B2FC62663",
      "sectionKey": "En pocas palabras",
      "summary": "Las perífrasis fasales enfocan una fase interna de la situación, como comienzo, continuidad, repetición o terminación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E35AA5866AE5F59CC7F4AE31",
      "sectionKey": "Cómo funciona",
      "summary": "Empezar a + infinitivo y comenzar a + infinitivo presentan inicio o ingreso en una situación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-52D54B61DBE179D79C351DB2",
      "sectionKey": "Cómo funciona",
      "summary": "Seguir + gerundio presenta continuidad de una situación que se inició antes.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F3DCEF93B0376D76CB8A3F55",
      "sectionKey": "Cómo funciona",
      "summary": "Volver a + infinitivo presenta repetición o reanudación de una situación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FAE7B3CE1B690193DCE3BB0E",
      "sectionKey": "Cómo funciona",
      "summary": "Dejar de + infinitivo presenta cese o terminación de una actividad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-97E17F7C376E53469432DE9C",
      "sectionKey": "Cómo funciona",
      "summary": "Acabar de + infinitivo puede expresar pasado reciente y no siempre se interpreta como perífrasis terminativa.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0D74E0DD6DA0FDE5F2F5864F",
      "sectionKey": "Cómo funciona",
      "summary": "La interpretación fasal depende también de la clase aspectual del verbo principal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A86B8DEA97F101B58E8980EE",
      "sectionKey": "Cómo funciona",
      "summary": "Las construcciones fasales suelen compartir sujeto entre auxiliar y forma no personal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-55CD1A98E1E023851BF3CDAF",
      "sectionKey": "Ejemplos",
      "summary": "Empezó a llover enfoca el comienzo de la lluvia.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A46A1CE6725565E40EFF88CC",
      "sectionKey": "Ejemplos",
      "summary": "Sigue lloviendo presenta continuidad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-74DED300A7D79CAC3E40229E",
      "sectionKey": "Ejemplos",
      "summary": "Volvió a llover presenta una nueva realización.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BE85E01EA150F2127FE69E37",
      "sectionKey": "Ejemplos",
      "summary": "Dejó de llover enfoca el cese.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0263E1AAF3D8F054D235A894",
      "sectionKey": "Observación importante",
      "summary": "Las fases aspectuales no son tiempos verbales; el auxiliar conjugado sitúa temporalmente la perífrasis.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-05B9DD1C786D17BA79094921",
      "sectionKey": "Observación importante",
      "summary": "El grado de gramaticalización y análisis de construcciones fasales puede variar.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
