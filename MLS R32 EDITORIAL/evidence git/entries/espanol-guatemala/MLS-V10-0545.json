  "claims": [
    {
      "claimId": "MLS-CLM-532D9158BE30B107B991E9AB",
      "sectionKey": "En pocas palabras",
      "summary": "Sino suele corregir o sustituir un elemento negado; sino que introduce normalmente un segundo miembro oracional.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FE9E3B654DD95C70B1F62435",
      "sectionKey": "Cómo funciona",
      "summary": "Sino aparece después de negación explícita o implícita y presenta una alternativa correctiva.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3CD15D139F7307EEC7BFF534",
      "sectionKey": "Cómo funciona",
      "summary": "Sino que se usa cuando el segundo miembro contiene un verbo conjugado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-27850D57747ED9304B0D4E35",
      "sectionKey": "Cómo funciona",
      "summary": "Sino y pero difieren: el primero corrige o reemplaza y el segundo contrapone sin reemplazo necesario.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-DB030E3F59E255358CAAFAD2",
      "sectionKey": "Cómo funciona",
      "summary": "Sin embargo y no obstante son conectores discursivos, no conjunciones adversativas de la misma clase.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-210C777FA2C3FE75D89B6437",
      "sectionKey": "Ejemplos",
      "summary": "Los ejemplos contrastan sino, sino que y pero.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CA7F01CCB67FF58AADE8FF41",
      "sectionKey": "Observación importante",
      "summary": "Sino no debe confundirse con si no, que contiene una conjunción condicional seguida de negación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
