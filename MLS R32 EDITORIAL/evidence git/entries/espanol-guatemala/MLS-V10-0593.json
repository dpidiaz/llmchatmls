  "claims": [
    {
      "claimId": "MLS-CLM-7AE0CD0D3687D267E5672EF6",
      "sectionKey": "En pocas palabras",
      "summary": "Los complementos indirectos pueden clasificarse por su papel semántico y por su relación sintáctica con el predicado, incluida la distinción entre argumentos y adjuntos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-82F462D3E08EB3025A91046D",
      "sectionKey": "Cómo funciona",
      "summary": "Entre los complementos indirectos argumentales se encuentran destinatarios, receptores, experimentantes y participantes de término u origen, según el predicado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B8EE3A3E846259D8E527B569",
      "sectionKey": "Clases principales",
      "summary": "Otros dativos son adjuntos no seleccionados que expresan interés, beneficio, afectación o posesión simpatética.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3573957AC520D25ACA1EE9B4",
      "sectionKey": "Clases principales",
      "summary": "El dativo ético marca implicación personal y no es un argumento seleccionado por el verbo; el dativo concordado constituye otra clase descrita por la gramática.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E4CCFC65DBA1E8AF347FC151",
      "sectionKey": "Observación importante",
      "summary": "Receptor, experimentante, beneficiario y poseedor son papeles de significado y no equivalen por sí mismos a la función de complemento indirecto; un beneficiario introducido por para no se vuelve indirecto automáticamente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
