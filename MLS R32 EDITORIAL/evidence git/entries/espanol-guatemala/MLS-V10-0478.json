  "claims": [
    {
      "claimId": "MLS-CLM-08AB136E4CF1AFCE3B86C629",
      "sectionKey": "En pocas palabras",
      "summary": "El participio es una forma no personal que puede presentar una situación como completada o como resultado, según la construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2A9C2D1629D6B1884E0C5819",
      "sectionKey": "En pocas palabras",
      "summary": "El participio no tiene interpretación temporal absoluta y su lectura depende del auxiliar, predicado y contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-944C9DABB264A1F487140974",
      "sectionKey": "Cómo funciona",
      "summary": "Con haber, el participio forma tiempos compuestos y permanece invariable.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F52161E18E26737EBF35DAC7",
      "sectionKey": "Cómo funciona",
      "summary": "En los tiempos compuestos, el participio sitúa el evento respecto del punto de referencia aportado por el auxiliar.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4180F4AC299F17F8FB656BB0",
      "sectionKey": "Cómo funciona",
      "summary": "La pasiva con ser + participio permite concordancia del participio con el sujeto paciente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CC365ECCEEDB9B974CE57A67",
      "sectionKey": "Cómo funciona",
      "summary": "Con estar, ciertos participios describen estados resultantes y concuerdan con el sujeto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4F9FAD1BC4F2413A9DECD1A2",
      "sectionKey": "Cómo funciona",
      "summary": "El participio suele presentar una perspectiva perfectiva o resultativa, pero la clase verbal y la construcción influyen en la lectura.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-DFA5577CAC481260DA178F54",
      "sectionKey": "Ejemplos",
      "summary": "Marta ha terminado el informe ejemplifica un participio dentro de un tiempo compuesto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C1BC5C39D467A2FC37D99322",
      "sectionKey": "Ejemplos",
      "summary": "Marta había salido sitúa una situación anterior respecto de un punto pasado mediante el tiempo compuesto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-51BD38DB36E355546A1DA5FE",
      "sectionKey": "Ejemplos",
      "summary": "La ventana fue abierta por el guardia ejemplifica una pasiva con participio concordado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-36D2711F481E0D83A9097947",
      "sectionKey": "Ejemplos",
      "summary": "La ventana está abierta ejemplifica un participio concordado en una construcción de estado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E23E954A60B147FB2CD92E97",
      "sectionKey": "Observación importante",
      "summary": "El participio no equivale simplemente a pasado: intervienen auxiliares, construcción y contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-ABFAB5BC69F3DF175D9C3832",
      "sectionKey": "Observación importante",
      "summary": "La forma quiero estudiar contiene infinitivo y no constituye ejemplo del participio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
