  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-1285168DA915BEB78D148D6D",
      "sectionKey": "En pocas palabras",
      "summary": "Las perífrasis escalares sitúan una situación en un grado o punto de una escala de culminación, cantidad o logro.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F80CF1CFEF6043ADBF43CB2C",
      "sectionKey": "Cómo funciona",
      "summary": "Llegar a + infinitivo puede expresar culminación o un resultado alcanzado y no desplazamiento físico.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-67D00FD961C3FC059A22F387",
      "sectionKey": "Cómo funciona",
      "summary": "La escala puede ser cuantitativa o cualitativa y queda configurada por construcción y contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5BDF982218A71EEB1A4C496E",
      "sectionKey": "Cómo funciona",
      "summary": "No toda secuencia con llegar forma perífrasis; el uso locativo conserva significado de desplazamiento y toma complemento nominal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B91EFDD646BFA54531590592",
      "sectionKey": "Cómo funciona",
      "summary": "En llegar a + infinitivo, el auxiliar aporta lectura escalar y el infinitivo conserva el contenido léxico principal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8CC84A2557672A9528751F6E",
      "sectionKey": "Cómo funciona",
      "summary": "La negación de llegar a + infinitivo puede presentar el límite o resultado como no alcanzado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2E62742D8DBF6FD2AC7187CD",
      "sectionKey": "Ejemplos",
      "summary": "Llegó a ganar tres premios presenta el evento como logro alcanzado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D2327FD365EE0974663B9F5A",
      "sectionKey": "Ejemplos",
      "summary": "La temperatura llegó a superar los cuarenta grados sitúa la cantidad en una escala.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AFEA140A1001BBBFC3C2B695",
      "sectionKey": "Ejemplos",
      "summary": "No llegó a terminar el informe presenta el límite esperado como no alcanzado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BDBAA1696C8D50D814954803",
      "sectionKey": "Observación importante",
      "summary": "La escala implícita no requiere que se enumeren expresamente las etapas precedentes.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0C3EF2AF5AB222FE84C95E15",
      "sectionKey": "Observación importante",
      "summary": "La clasificación depende de lectura gramaticalizada, no solo de la forma llegar a.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
