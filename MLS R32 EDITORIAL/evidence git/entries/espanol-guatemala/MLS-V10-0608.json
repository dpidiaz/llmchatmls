  "claims": [
    {
      "claimId": "MLS-CLM-E4C851A57ACB55C408C314AE",
      "sectionKey": "En pocas palabras",
      "summary": "Los atributos aparecen en construcciones copulativas y en construcciones semicopulativas, en las que el verbo conserva parte de su significado léxico.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-16A60719A672C343C796E54F",
      "sectionKey": "Cómo funciona",
      "summary": "Verbos semicopulativos como ponerse, quedar, hacerse, seguir y continuar pueden enlazar al sujeto con una propiedad y aportar valores como cambio, resultado o continuidad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E6C349DD84CDBAACB513E65F",
      "sectionKey": "Cómo funciona",
      "summary": "Con un verbo plenamente léxico, un complemento predicativo puede atribuir una propiedad secundaria al sujeto sin convertir la construcción en una oración copulativa.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FFC35E26660ACFC917693847",
      "sectionKey": "Cómo funciona",
      "summary": "Algunos complementos predicativos se predican del objeto, como ocurre en construcciones de nombramiento, y no constituyen por ello el atributo copulativo del sujeto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-460CBE999A40BC7ED852275F",
      "sectionKey": "Observación importante",
      "summary": "La distinción entre atributo semicopulativo y complemento predicativo depende de la estructura y del contenido que conserva el verbo; ciertos análisis describen zonas próximas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
