  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-4A2748FF3D2B70AC4C267267",
      "sectionKey": "En pocas palabras",
      "summary": "Un gerundio puede tener sujeto tácito cuya referencia se recupera del verbo principal o del contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-14087DE06F51BAAF2130823C",
      "sectionKey": "Cómo funciona",
      "summary": "El gerundio carece de marcas propias de persona y número, por lo que la identificación de su sujeto depende de otros elementos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-59401446D47B2FE69642B1DE",
      "sectionKey": "Cómo funciona",
      "summary": "En numerosos usos predicativos, el sujeto tácito del gerundio coincide con el sujeto de la oración principal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B4B53E40421F1DAA1CF22C5D",
      "sectionKey": "Cómo funciona",
      "summary": "En construcciones circunstanciales antepuestas, el sujeto tácito suele identificarse con el sujeto principal si la sintaxis y contexto lo permiten.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CAFDF355D5FF4081AAC296C6",
      "sectionKey": "Cómo funciona",
      "summary": "La correferencia con el sujeto principal no se impone automáticamente en todos los gerundios; la interpretación requiere un vínculo contextual adecuado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-75C5F049B5C41CD4FDF65ACC",
      "sectionKey": "Cómo funciona",
      "summary": "Los gerundios de interpretación genérica pueden tener un sujeto no específico.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BA311F2DCB15DFCAEB0E03E5",
      "sectionKey": "Cómo funciona",
      "summary": "El gerundio predicativo también puede atribuirse a un complemento de percepción, como Ana en Vi a Ana cruzando.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3002721DA3A868136B533C4C",
      "sectionKey": "Observación importante",
      "summary": "Aunque el sujeto sea tácito, el gerundio mantiene un participante semántico que se recupera interpretativamente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5BA027BED102DDCCD825EA63",
      "sectionKey": "Observación importante",
      "summary": "Un sujeto tácito del gerundio se distingue de un sujeto expreso propio de una construcción absoluta.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
