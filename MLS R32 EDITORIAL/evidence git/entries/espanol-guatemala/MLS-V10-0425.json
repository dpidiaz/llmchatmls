    "title": "Relevancia del modo de acción. La oposición canté / cantaba",
    "level": "G2",
    "part": "Tiempo y aspecto / Tense and aspect",
    "chapter": "Tiempo y aspecto verbal / Verbal tense and aspect"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 4,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-27971D7DCDD4AE80F2935C46",
      "sectionKey": "En pocas palabras",
      "summary": "Canté y cantaba suelen situar la situación en el pasado, pero difieren en su presentación aspectual: el perfecto simple la delimita y el imperfecto la presenta sin enfocar necesariamente sus límites.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4BED84B952DDBA69FEBD0659",
      "sectionKey": "En pocas palabras",
      "summary": "El modo de acción caracteriza predicados completos y puede depender tanto del significado verbal como de sus complementos.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-779B90AF13B812D17B283FC9",
      "sectionKey": "Cómo funciona",
      "summary": "Estados, actividades, realizaciones y logros difieren en rasgos como duración y delimitación; saber, correr, escribir una carta y llegar ilustran esos tipos.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-03FF5CB3930976265CF44984",
      "sectionKey": "Cómo funciona",
      "summary": "El pretérito simple puede presentar una situación como completa o delimitada; los predicados atélicos también pueden aparecer con límites externos.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-16DB28B19D38F93AF2003E2D",
      "sectionKey": "Cómo funciona",
      "summary": "El imperfecto presenta una situación en curso o como fondo y puede contrastar con el perfecto simple según se enfoquen o no sus límites.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-31A4D5E6661610891F4C89F5",
      "sectionKey": "Cómo funciona",
      "summary": "El imperfecto puede expresar hábitos con series abiertas de eventos, mientras el pretérito simple puede presentar una visita concreta o una serie cerrada.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CF7883808DCC72357B9FC0F4",
      "sectionKey": "Ejemplos",
      "summary": "Predicados de estado como vivir pueden aparecer en perfecto simple con un intervalo delimitado y durar muchos años.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2C65789144762B04A422F690",
      "sectionKey": "Ejemplos",
      "summary": "La interpretación aspectual depende también de complementos y contexto, por lo que una expresión temporal puede favorecer una lectura habitual del imperfecto.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-DE425617A9F190BDFD646C65",
      "sectionKey": "Observación importante",
      "summary": "La duración cronológica no separa por sí sola canté y cantaba; importan la aspectualidad del predicado, los límites y el marco de referencia.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
