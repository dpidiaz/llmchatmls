  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-C104BD61B3C0C25541FE7843",
      "sectionKey": "En pocas palabras",
      "summary": "El participio puede funcionar verbalmente en tiempos compuestos o pasivas y adjetivalmente en otras construcciones.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2FA25CD88D0F3C4B0D3F9429",
      "sectionKey": "Cómo funciona",
      "summary": "Con haber, el participio forma un tiempo compuesto y no concuerda con sujeto ni complemento.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4D0A304D521B4E3CD071822F",
      "sectionKey": "Cómo funciona",
      "summary": "Los adjetivos suelen concordar con el sustantivo; también concuerdan participios adjetivales y algunos participios pasivos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A99078594607A96AAE3BB1CE",
      "sectionKey": "Cómo funciona",
      "summary": "La concordancia por sí sola no demuestra que el participio tenga categoría adjetival, pues hay pasivas con concordancia.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B23327B50E3F3FD0C9A97C70",
      "sectionKey": "Cómo funciona",
      "summary": "Los participios verbales pueden conservar complementos relacionados con el verbo, como un complemento agente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F07CA4C6803DCF3507F6054F",
      "sectionKey": "Cómo funciona",
      "summary": "Algunos participios en uso adjetival admiten modificadores de grado, aunque otros los rechazan o restringen.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7AED11A0DAC318D394CBAD02",
      "sectionKey": "Cómo funciona",
      "summary": "La lectura resultativa puede mantener relación con el evento verbal, aunque en usos lexicalizados esa relación se debilite.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5227F929342A4F991EB03931",
      "sectionKey": "Ejemplos",
      "summary": "He cerrado la puerta presenta participio invariable en tiempo compuesto con haber.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E1DDB3E702FF7B203615CE70",
      "sectionKey": "Ejemplos",
      "summary": "Las cartas fueron escritas por Ana presenta participio concordado dentro de pasiva y complemento agente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B176193EC3C2DD9BDEA61AF2",
      "sectionKey": "Ejemplos",
      "summary": "Marta está muy cansada muestra un participio con uso adjetival y modificador de grado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-51F16E2074DD0716DBE82EE3",
      "sectionKey": "Observación importante",
      "summary": "No hay una sola prueba que separe todos los participios de todos los adjetivos; se evalúan forma, complementos, auxiliares y significado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1B3ED6E155B5A8F329176FF3",
      "sectionKey": "Observación importante",
      "summary": "La misma forma puede comportarse de manera verbal o adjetival en construcciones diferentes.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
