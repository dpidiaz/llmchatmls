      "sectionKey": "Cómo funciona",
      "summary": "Las conjunciones coordinantes pueden relacionar nombres, adjetivos, grupos verbales u oraciones.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-51B8F58ECEDB5756E1CD0747",
      "sectionKey": "Cómo funciona",
      "summary": "Y/e/ni, o/u y pero expresan relaciones copulativas, disyuntivas o adversativas respectivamente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-13385085FAE5B572C23F936D",
      "sectionKey": "Cómo funciona",
      "summary": "Sin embargo funciona como conector discursivo, no como conjunción coordinante prototípica.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-05ECD63603A9920D84359AA6",
      "sectionKey": "Ejemplos",
      "summary": "Los ejemplos ilustran coordinación de oraciones, infinitivos y predicaciones negativas o adversativas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
