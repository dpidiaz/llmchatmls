      "sectionKey": "En pocas palabras",
      "summary": "La elipsis en coordinación omite material recuperable por paralelismo o contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6985ED46650A686C2D0417D1",
      "sectionKey": "Cómo funciona",
      "summary": "Puede omitirse el verbo o grupo verbal repetido en el segundo miembro de una coordinación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A3EBF6938A783FC3C7D33968",
      "sectionKey": "Cómo funciona",
      "summary": "La puntuación puede señalar en la escritura el lugar de material elidido, sin crear el fenómeno sintáctico.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D9D663F89B73B54C8F65DF1C",
      "sectionKey": "Cómo funciona",
      "summary": "La claridad de la elipsis depende de paralelismo y recuperabilidad estructural y semántica.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0809B34C14AFD90C6C9EBD20",
      "sectionKey": "Ejemplos",
      "summary": "Los ejemplos muestran elipsis verbal y contraste con repetición expresa del verbo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4F430EE693295CE69936D600",
      "sectionKey": "Observación importante",
      "summary": "La elipsis omite forma, pero deja contenido recuperable; no toda ausencia de palabras es elipsis.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
