      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-47C2F4F73955EAAC41C5A307",
      "sectionKey": "Cómo funciona",
      "summary": "Haber + participio de tiempo compuesto no concuerda, frente a algunas construcciones resultativas con participio.",
