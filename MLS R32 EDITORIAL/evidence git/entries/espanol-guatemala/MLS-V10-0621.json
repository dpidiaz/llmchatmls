      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-69B2B5A76575410F3E2D7E47",
      "sectionKey": "Cómo funciona",
      "summary": "Las cópulas prototípicas aportan un contenido léxico reducido, mientras los semicopulativos añaden matices semánticos al enlace predicativo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8F6451E04B7A1D83FDC7E613",
      "sectionKey": "Cómo funciona",
      "summary": "Los semicopulativos pueden aportar significados de cambio, resultado, permanencia o continuidad según el verbo y la construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-470C22B48EBE685D1F7ECE01",
      "sectionKey": "Cómo funciona",
      "summary": "En las construcciones semicopulativas, el elemento predicativo caracteriza al sujeto y se combina con la contribución semántica del verbo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-EB210E519EF472479C0E15DC",
      "sectionKey": "Observación importante",
      "summary": "Los verbos semicopulativos se comportan como tales solo en determinados usos, por lo que su clasificación depende de la construcción.",
