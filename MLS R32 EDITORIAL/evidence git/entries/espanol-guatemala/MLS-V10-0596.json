      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-10CFE37BE9581D96761CB3AA",
      "sectionKey": "Concordancia e implicación",
      "summary": "El dativo ético puede no ser correferente con el sujeto, mientras que el concordado sí; no deben confundirse automáticamente con el reflexivo ordinario.",
