  "claims": [
    {
      "claimId": "MLS-CLM-E386559FE8752F736F3C197D",
      "sectionKey": "En pocas palabras",
      "summary": "Una oración impersonal carece de sujeto sintáctico, aunque el hablante pueda inferir quién causa o experimenta la situación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4C0DED85353997E07903A0FD",
      "sectionKey": "Cómo funciona",
      "summary": "Un sujeto tácito recuperable no convierte la oración en impersonal; debe distinguirse la ausencia de expresión del sujeto de la ausencia de sujeto sintáctico.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0BE67110F5B72BFCAF1CE75A",
      "sectionKey": "Cómo funciona",
      "summary": "El haber existencial impersonal aparece en tercera persona singular y el grupo nominal que lo acompaña no funciona como sujeto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A7F368707625FB656E38FFDE",
      "sectionKey": "Cómo funciona",
      "summary": "Las oraciones con verbos meteorológicos pueden ser impersonales porque no contienen un sujeto sintáctico que concuerde con el verbo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3624DD0969C4B5DC03FCB4EC",
      "sectionKey": "Observación importante",
      "summary": "La impersonalidad es una propiedad sintáctica y no significa simplemente que se ignore la identidad del agente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
