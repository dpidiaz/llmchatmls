  "claims": [
    {
      "claimId": "MLS-CLM-DE3927F32297B9EDA08050C7",
      "sectionKey": "En pocas palabras",
      "summary": "Las conjunciones subordinantes introducen oraciones dependientes y pueden seleccionar modo estable o permitir alternancias según construcción, tiempo y perspectiva.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-656C480608B21ACF817CF33E",
      "sectionKey": "En pocas palabras",
      "summary": "La selección modal no se reduce a irrealidad y depende de semántica, tiempo y presentación discursiva.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-201BAE5B214056B5F5EFE3B2",
      "sectionKey": "Conjunciones que favorecen subjuntivo",
      "summary": "Las construcciones finales introducidas por para que se construyen con subjuntivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CB13F46698599C7A472FC2B9",
      "sectionKey": "Conjunciones que favorecen subjuntivo",
      "summary": "Antes de que selecciona subjuntivo en la subordinada temporal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-85C1A00176F7D7D2F468A2B5",
      "sectionKey": "Conjunciones temporales",
      "summary": "Cuando con referencia a evento pasado realizado puede aparecer en indicativo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A49D814AF94B2593923E6373",
      "sectionKey": "Conjunciones temporales",
      "summary": "Cuando con referencia futura pendiente suele llevar subjuntivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6F2FFD12BAFA404222570C4E",
      "sectionKey": "Aunque y la alternancia modal",
      "summary": "Aunque admite indicativo y subjuntivo con diferencias de interpretación y perspectiva sobre la información subordinada.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0F86D26E2111CDA8235EE871",
      "sectionKey": "Conjunciones condicionales",
      "summary": "En condiciones abiertas con si se emplea indicativo; las hipótesis contrafácticas pueden usar imperfecto de subjuntivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2C9F5ECE5AB9C503AC01A741",
      "sectionKey": "Causa y concesión",
      "summary": "Las causales afirmadas con porque suelen aparecer en indicativo; la negación o rechazo de la causa puede alterar el patrón.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BE46E94E502840E8AD615024",
      "sectionKey": "Nexos que imponen un modo",
      "summary": "Para que y antes de que seleccionan subjuntivo, mientras aunque presenta alternancia.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6064C37D5F601F2651853D8F",
      "sectionKey": "Observación importante",
      "summary": "La selección depende de la construcción y no de que una conjunción tenga una etiqueta fija de modo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
