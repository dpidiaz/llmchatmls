      "claimId": "MLS-CLM-D2BD4A6BB67747B516D37C97",
      "sectionKey": "En pocas palabras",
      "summary": "Las conjunciones son palabras invariables que relacionan unidades sintácticas y se clasifican en coordinantes o subordinantes.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1F4E76388E59BD0A92836335",
      "sectionKey": "Cómo funciona",
      "summary": "Las conjunciones coordinantes relacionan elementos de nivel sintáctico equivalente y se dividen en clases como copulativas, disyuntivas y adversativas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BB2D8074096A6D137E1BBC6E",
      "sectionKey": "Cómo funciona",
      "summary": "Las conjunciones subordinantes introducen oraciones dependientes de otra estructura.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5B7428808A35060443B4D476",
      "sectionKey": "Cómo funciona",
      "summary": "Que, si y aunque ilustran subordinación declarativa, condicional y concesiva.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6CAAD00265B5CF1A6E28DD54",
      "sectionKey": "Cómo funciona",
      "summary": "Las locuciones conjuntivas pluriverbales pueden desempeñar funciones semejantes a conjunciones.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-38188EAE82B85CF8D29F96C7",
      "sectionKey": "Ejemplos",
      "summary": "Los ejemplos distinguen coordinación y subordinación en palabras, grupos y oraciones.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D5F8715D3E3FD56A21BD2135",
      "sectionKey": "Observación importante",
      "summary": "La coordinación relaciona unidades de nivel equivalente; la subordinación integra una oración dependiente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
