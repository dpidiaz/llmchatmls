  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-4204E5E00C9CA72236E8685B",
      "sectionKey": "En pocas palabras",
      "summary": "Habré cantado es el futuro compuesto y habría cantado es el condicional compuesto; son tiempos compuestos del modo indicativo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-575885838506FB482857FA21",
      "sectionKey": "Cómo funciona",
      "summary": "El futuro compuesto y el condicional compuesto se forman con la forma correspondiente del auxiliar haber y el participio invariable del verbo principal.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D4D841692EE6DF81958182C4",
      "sectionKey": "En pocas palabras",
      "summary": "El futuro compuesto presenta una situación anterior a otro punto posterior al momento del habla.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-ED7A11F7BB7ECFD78C2EBD1C",
      "sectionKey": "En pocas palabras",
      "summary": "El condicional compuesto presenta una situación anterior a un punto posterior a un momento pasado.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8E7929AE239ED4E8DC07AF47",
      "sectionKey": "Cómo funciona",
      "summary": "El condicional compuesto aparece en construcciones hipotéticas irreales, incluidas las apódosis de períodos condicionales con condiciones no realizadas.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4EEF6C641277809C185232BC",
      "sectionKey": "Observación importante",
      "summary": "El futuro compuesto admite una interpretación de conjetura sobre un hecho anterior, además de su lectura temporal.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-75484E9D4CE560A69AFB98EF",
      "sectionKey": "Observación importante",
      "summary": "El condicional compuesto también admite interpretaciones modales, incluidas la conjetura y ciertos usos de cortesía, por lo que no se reduce a posterioridad relativa.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-81AC1B15FA39AA6B3CEAB5C9",
      "sectionKey": "Observación importante",
      "summary": "La interpretación temporal o modal de las formas compuestas depende de la construcción y del contexto.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
