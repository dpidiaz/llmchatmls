  "claims": [
    {
      "claimId": "MLS-CLM-FCDDA504B9003C186D3C8DF5",
      "sectionKey": "En pocas palabras",
      "summary": "El futuro simple de subjuntivo incluye formas como cantare y el futuro compuesto se forma con hubiere más participio, como hubiere cantado.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BA30B24F33564E9833ACC50C",
      "sectionKey": "En pocas palabras",
      "summary": "El futuro simple no expresa exclusivamente un hecho posterior al momento del habla: en prótasis puede presentar una eventualidad futura o una situación hipotética presente.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-407AF94B384594BB6B3622A9",
      "sectionKey": "Cómo funciona",
      "summary": "El futuro simple de subjuntivo aparece en prótasis condicionales y concesivas, relativas y como término de algunas conjunciones subordinantes, no en las subordinadas sustantivas características de la inducción modal.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7B0A4AB8552D459399318A36",
      "sectionKey": "Cómo funciona",
      "summary": "En una subordinada temporal prospectiva con cuando, el presente de subjuntivo es una forma moderna usual, como en Cuando llegue el mensajero, nos iremos.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-161AEBC0FA595154E51812E7",
      "sectionKey": "Uso actual",
      "summary": "El futuro simple de subjuntivo perdió vigencia y hoy está en desuso en el habla de casi todas las áreas, con excepciones regionales limitadas; fue sustituido progresivamente por otros tiempos, incluido el imperfecto de subjuntivo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-71E1BE97F1E972E48F27419B",
      "sectionKey": "Uso actual",
      "summary": "El futuro simple de subjuntivo se mantiene en textos jurídicos, normas y otros documentos oficiales de estilo arcaizante.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5B736B224F033F351B5F31BD",
      "sectionKey": "Uso actual",
      "summary": "El futuro de subjuntivo sobrevive en fórmulas rituales, refranes y expresiones fijadas, como sea cual fuere y venga de donde viniere.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4039D90D4E967F8FA455B312",
      "sectionKey": "Ejemplos",
      "summary": "El ejemplo Quien incumpliere esta disposición será responsable representa un uso normativo y jurídico marcado del futuro simple de subjuntivo.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-929D8994C93B399CE83DA58A",
      "sectionKey": "Ejemplos",
      "summary": "El futuro compuesto de subjuntivo es perfectivo y presenta una situación eventual anterior a otra situación posterior al punto de referencia.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-9F106C1173B7D7714FC44A21",
      "sectionKey": "Observación importante",
      "summary": "El futuro compuesto se sustituye mayoritariamente en el español actual por el pluscuamperfecto de subjuntivo y conserva usos restringidos, en particular en textos jurídicos.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
