    {
      "claimId": "MLS-CLM-0AA0A639C321E99C74A29D39",
      "sectionKey": "En pocas palabras",
      "summary": "Los grupos preposicionales deben analizarse según la función que desempeñan y la palabra que los selecciona; un régimen verbal difiere de un adjunto y de los complementos seleccionados por sustantivos o adjetivos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-78F7109E27E6C5F450F21CF3",
      "sectionKey": "Cómo funciona",
      "summary": "En un atributo como orgulloso de tu trabajo, el grupo de tu trabajo complementa al adjetivo orgulloso dentro del atributo completo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D8C3A44BA0CA2004742A05E8",
      "sectionKey": "Cómo funciona",
      "summary": "Los sustantivos y adjetivos también pueden seleccionar complementos de régimen; en esos casos la dependencia corresponde al nombre o adjetivo y no al verbo de la oración.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-012097717EDAE1E3A2B4D14F",
      "sectionKey": "Observación importante",
      "summary": "Selección y obligatoriedad no son equivalentes: un complemento seleccionado puede quedar implícito en ciertos contextos sin perder la relación léxica establecida por la construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
