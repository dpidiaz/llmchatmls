  "claims": [
    {
      "claimId": "MLS-CLM-E5EA28F294DBB0BA6099DD0F",
      "sectionKey": "En pocas palabras",
      "summary": "En la duplicación del complemento indirecto, el clítico dativo y el grupo con a tienen la misma referencia y forman una sola función, no dos complementos indirectos independientes.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5A93E15C79CD10BABD5B1563",
      "sectionKey": "Cómo funciona",
      "summary": "La duplicación puede alternar con grupos preposicionales sin clítico en ciertas construcciones; con algunos verbos y con pronombres tónicos el clítico es obligatorio o está fuertemente exigido, y las opciones varían por variedad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1898BB81E793072AFEB52027",
      "sectionKey": "Cómo funciona",
      "summary": "Los grupos duplicados pueden aparecer pospuestos o antepuestos; la estructura y el predicado condicionan la presencia del clítico y la organización informativa.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7E83A58E538FB6CC6A66B24C",
      "sectionKey": "Ejemplos",
      "summary": "En el voseo americano, vos es término de preposición y te es el clítico átono usado con esa forma pronominal; Guatemala pertenece al área de voseo centroamericano.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A207555E3ED6EEB403EC4BD8",
      "sectionKey": "Cómo funciona",
      "summary": "En las combinaciones de clíticos, se ocupa la posición de dativo ante un clítico de complemento directo de tercera persona, como en se lo di.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
