    "title": "El modo en las interrogativas indirectas",
    "level": "G3",
    "part": "Subjuntivo y modo / Subjunctive and mood",
    "chapter": "Modo, indicativo y subjuntivo / Mood, indicative, and subjunctive"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 4,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-DDAB6550B1B5C13B98F6A067",
      "sectionKey": "En pocas palabras",
      "summary": "Las interrogativas indirectas son subordinadas sustantivas interrogativas que suelen llevar indicativo incluso bajo predicados de desconocimiento; la interrogatividad no impone por sí sola subjuntivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CCBED16C63633222C337B029",
      "sectionKey": "Interrogativas con palabras interrogativas",
      "summary": "Las interrogativas indirectas parciales pueden encabezarse con pronombres, determinantes y adverbios interrogativos, con formas verbales tanto en indicativo como en subjuntivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-62B0B627DBC5A3ECEB141755",
      "sectionKey": "Interrogativas con palabras interrogativas",
      "summary": "Las palabras interrogativas conservan la tilde diacrítica en interrogativas indirectas.",
      "claimType": "orthography",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-677389B60D8D8D3C2A061E37",
      "sectionKey": "Interrogativas con «si»",
      "summary": "Si introduce interrogativas indirectas totales que plantean alternativas polares y son distintas de las subordinadas declarativas con que.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-67FE6C8CBC02F14FFF7BB546",
      "sectionKey": "Interrogativas con «si»",
      "summary": "El indicativo es frecuente o general en interrogativas indirectas con si, aunque se documenta alternancia regional con subjuntivo.",
      "claimType": "regional_variation",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-20634B1207D1F6778162B1FA",
      "sectionKey": "Duda no equivale a subjuntivo",
      "summary": "Dudar que + subordinada declarativa selecciona normalmente subjuntivo, mientras que dudar si + interrogativa indirecta suele construirse en indicativo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-013CAEE873609E8DF416458E",
      "sectionKey": "Futuro y referencia temporal",
      "summary": "El tiempo verbal en interrogativas indirectas se interpreta según la relación temporal de la pregunta integrada.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-08E1E3391379E1D6AC1A495F",
      "sectionKey": "Futuro y referencia temporal",
      "summary": "Las subordinadas temporales futuras con cuando pueden llevar subjuntivo y no son interrogativas indirectas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BE237FF92899FFCF0CBCDFDD",
      "sectionKey": "Variación con subjuntivo",
      "summary": "No sé si te gusta/guste es una variación regional documentada: indicativo es común en España y el área rioplatense, subjuntivo natural en México y áreas caribeña y andina.",
      "claimType": "regional_variation",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2D5A2E73ECE30662C7D7E196",
      "sectionKey": "Observación importante",
      "summary": "La tilde de las formas interrogativas indirectas distingue su valor interrogativo de usos relativos o conjuntivos átonos sin tilde.",
      "claimType": "orthography",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-07DBCD682F9CF054907414EA",
      "sectionKey": "Observación importante",
      "summary": "Una subordinada sustantiva de voluntad con que no es interrogativa indirecta; la pregunta integrada requiere un constituyente interrogativo o la conjunción si.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
