  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-BB7C3E334DDC09822ED5CE3F",
      "sectionKey": "En pocas palabras",
      "summary": "El sujeto tácito de una oración de infinitivo no aparece expresado y se interpreta mediante la estructura sintáctica y el contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-93B20D37A3B688B5B2D113AB",
      "sectionKey": "En pocas palabras",
      "summary": "El infinitivo puede carecer de un sujeto pronunciado y mantener una interpretación de sujeto no expreso vinculada a otro argumento.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3B7FECC9BB83A8B68B576520",
      "sectionKey": "Cómo funciona",
      "summary": "Las formas no personales carecen de flexión personal; la referencia del sujeto del infinitivo se establece por relaciones sintácticas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BED3971B937997429CBD87F6",
      "sectionKey": "Cómo funciona",
      "summary": "En construcciones como Marta quiere viajar, Marta puede determinar por correferencia la referencia del sujeto tácito del infinitivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3E8010F676405A33EDD711CA",
      "sectionKey": "Cómo funciona",
      "summary": "El sujeto tácito de infinitivos con predicados de voluntad puede ser correferente con un argumento de la principal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-19DC9A8C380AA37FF68B56FF",
      "sectionKey": "Cómo funciona",
      "summary": "Los sujetos tácitos de infinitivos también pueden tener referencia interpretada desde otro argumento según la construcción y el predicado rector.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BE444E7124C4719ACA3EAC06",
      "sectionKey": "Cómo funciona",
      "summary": "Algunas oraciones de infinitivo admiten interpretación genérica, sin identificar un individuo concreto como agente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-29146C4A6AAB46785898CC9F",
      "sectionKey": "Cómo funciona",
      "summary": "El infinitivo mantiene carácter verbal y admite complementos propios del verbo aunque su sujeto sea tácito.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-DB45C34F1D7976508E3CA019",
      "sectionKey": "Ejemplos",
      "summary": "Quiero salir y Marta decidió estudiar ilustran sujetos tácitos interpretados en relación con un argumento de la principal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E28471EC95F1A183458A603B",
      "sectionKey": "Observación importante",
      "summary": "Sujeto tácito significa sujeto no pronunciado o sobrentendido, no ausencia de sujeto en la representación interpretativa.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-978B2B78FE98F2D1566637A9",
      "sectionKey": "Observación importante",
      "summary": "La referencia del sujeto de infinitivo puede ser correferente con distintos argumentos y depende del tipo de estructura.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
