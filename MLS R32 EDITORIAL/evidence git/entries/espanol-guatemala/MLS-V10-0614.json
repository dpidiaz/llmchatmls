      "claimId": "MLS-CLM-F4ACA7F12FEF71632DD8CC43",
      "sectionKey": "En pocas palabras",
      "summary": "Los atributos adjetivales suelen concordar en género y número con el sujeto, mientras el pronombre neutro lo que los sustituye permanece invariable.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-DB0729C9D931C7567BE26A7B",
      "sectionKey": "Cómo funciona",
      "summary": "En sujetos coordinados, la forma del atributo refleja las pautas de concordancia de género y número aplicables al conjunto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1E7AD8B8119D57AC00935008",
      "sectionKey": "Cómo funciona",
      "summary": "El pronombre lo puede sustituir al atributo en construcciones copulativas sin concordar con el género ni el número del sujeto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B305392B54E0A8D66C3FE96F",
      "sectionKey": "Cómo funciona",
      "summary": "Los atributos nominales no muestran necesariamente la misma concordancia morfológica que los adjetivales.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5E4748BB865D41832C3B4BEE",
      "sectionKey": "Observación importante",
      "summary": "La concordancia ayuda a reconocer relaciones atributivas, pero su expresión depende de la categoría y la forma del atributo.",
