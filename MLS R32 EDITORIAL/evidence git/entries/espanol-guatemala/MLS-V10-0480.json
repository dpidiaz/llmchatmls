      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-57824B1116A6F409084217FA",
      "sectionKey": "Cómo funciona",
      "summary": "Un participio puede coordinarse con un adjetivo cuando ambos comparten una función descriptiva.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-61FDB4803291559F0F527D31",
      "sectionKey": "Cómo funciona",
      "summary": "Con haber en tiempos compuestos, el participio permanece invariable y mantiene comportamiento verbal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
