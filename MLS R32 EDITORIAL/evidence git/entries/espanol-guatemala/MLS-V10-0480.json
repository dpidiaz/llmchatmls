      "sectionKey": "Cómo funciona",
      "summary": "Fuera de tiempos compuestos, muchos participios admiten variación de género y número.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1D1D9F131C8333E811E36113",
      "sectionKey": "Cómo funciona",
      "summary": "Los participios adjetivales y adjetivos pueden modificar sustantivos y atribuirles propiedades.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
