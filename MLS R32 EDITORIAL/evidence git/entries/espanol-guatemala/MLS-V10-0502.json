  "claims": [
    {
      "claimId": "MLS-CLM-3FEEDA596653FF3060736581",
      "sectionKey": "En pocas palabras",
      "summary": "Una locución preposicional es una expresión pluriverbal que funciona como unidad equivalente funcionalmente a una preposición.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8AB0791A25024E748A781025",
      "sectionKey": "Cómo funciona",
      "summary": "Muchas locuciones se forman con adverbio más preposición, como delante de, detrás de y cerca de.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0A0F89EA449201D626F21FE7",
      "sectionKey": "Cómo funciona",
      "summary": "Otras contienen un sustantivo dentro de una secuencia preposicional, como a causa de y de acuerdo con.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B8A2666105413EEFD6A7A039",
      "sectionKey": "Cómo funciona",
      "summary": "La preposición final de muchas locuciones introduce el término de la expresión.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-87CBA856191CC35D45BF8DAE",
      "sectionKey": "Cómo funciona",
      "summary": "La fijación y el comportamiento unitario ayudan a distinguir locuciones de combinaciones libres.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-93C063B7066A704FFC80C593",
      "sectionKey": "Ejemplos",
      "summary": "Delante de, cerca de, a causa de y de acuerdo con funcionan en bloque para introducir un término.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-30ABB211AB547F1155623AD9",
      "sectionKey": "Observación importante",
      "summary": "Las locuciones pueden tener estructuras internas distintas y no se reducen al inventario de preposiciones simples.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
