  "claims": [
    {
      "claimId": "MLS-CLM-1350C4D1BC6D3E68A566E6EF",
      "sectionKey": "En pocas palabras",
      "summary": "Una construcción absoluta contiene una predicación relativamente autónoma, con un participante y un predicado que expresa su estado o situación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-33B556868DB8B012EED79CFE",
      "sectionKey": "Cómo funciona",
      "summary": "En muchas construcciones absolutas, un grupo nominal identifica al participante del que se predica algo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-28C023B0D9C93CF08C0A191F",
      "sectionKey": "Cómo funciona",
      "summary": "El predicado de una construcción absoluta puede realizarse mediante un participio, un gerundio, un adjetivo u otras expresiones predicativas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AFD190044EB19AEC3D715857",
      "sectionKey": "Cómo funciona",
      "summary": "Cuando el predicado absoluto es un participio o adjetivo concordante, sus marcas de género y número se relacionan con el participante nominal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AD2BA684166E982D9BFC6E42",
      "sectionKey": "Observación importante",
      "summary": "La construcción absoluta forma una predicación interna propia y no debe confundirse con un grupo nominal aislado o con un complemento seleccionado por el verbo principal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
