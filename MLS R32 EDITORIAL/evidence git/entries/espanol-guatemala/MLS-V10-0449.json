  "claims": [
    {
      "claimId": "MLS-CLM-3E449F1A774761FF4DA1D552",
      "sectionKey": "En pocas palabras",
      "summary": "Las subordinadas sustantivas desempeñan funciones nominales y la selección del modo varía por el predicado rector, la negación y la interpretación de la subordinada.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7079E89DE286457032F9F735",
      "sectionKey": "Afirmación y conocimiento",
      "summary": "Los predicados afirmativos de conocimiento, certeza y comunicación suelen seleccionar indicativo en la subordinada declarativa.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-29283DDFC3A0CF14F27799BE",
      "sectionKey": "Duda y negación",
      "summary": "Los predicados de duda favorecen subjuntivo; la negación puede modificar la selección modal de predicados de opinión como creer.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3E18FF35F44E5C71AE905949",
      "sectionKey": "Verbos de voluntad y valoración",
      "summary": "Los predicados de voluntad, influencia, afección y valoración seleccionan o favorecen subjuntivo en subordinadas sustantivas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6ECDE6C89A3D4DE7B7A34B2E",
      "sectionKey": "Alternancias con cambio de significado",
      "summary": "Decir que alterna entre indicativo cuando comunica una aserción y subjuntivo cuando expresa mandato o influencia.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4976889FEEFE90C93B47BE04",
      "sectionKey": "La importancia de la perspectiva",
      "summary": "Bajo negación, la elección entre indicativo y subjuntivo puede reflejar si la subordinada se presenta como afirmada o suspendida, con distribución dependiente del contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A1DEE4EB74D31B9152AC2DF4",
      "sectionKey": "Ejemplos",
      "summary": "Creo que viene y No creo que venga ilustran la alternancia asociada a la negación del predicado creer.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4ED05564C37799F16680BFD0",
      "sectionKey": "Observación importante",
      "summary": "La selección modal no se reduce a la dicotomía indicativo=hecho y subjuntivo=opinión; también hay subjuntivo con contenido asumido e indicativo con probabilidad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
