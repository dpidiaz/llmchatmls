  "claims": [
    {
      "claimId": "MLS-CLM-8998DD0B93FC55BDF2527799",
      "sectionKey": "En pocas palabras",
      "summary": "Las relativas de infinitivo aparecen vinculadas a un antecedente indefinido o inespecífico, bajo restricciones sintácticas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CFE5A1BD9DBDE71E5D492125",
      "sectionKey": "En pocas palabras",
      "summary": "Relativas como nada que decir y libros que leer incluyen infinitivo con antecedente nominal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F1E5B82D24CB12AD3900C6F6",
      "sectionKey": "Cómo funciona",
      "summary": "Antecedentes indefinidos y algunos antecedentes sin determinante admiten relativas de infinitivo con lectura inespecífica.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F4A1729DBA195CD79B999584",
      "sectionKey": "Cómo funciona",
      "summary": "Las formas relativas quien, que y donde pueden introducir o enlazar construcciones de infinitivo según la estructura.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2C5B0112C6DFC2877E5D1B3B",
      "sectionKey": "Cómo funciona",
      "summary": "El infinitivo de una relativa puede recibir una lectura prospectiva o modal, como libro que leer, es decir, libro que poder leer.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-313865EE3A96E65A8778DF50",
      "sectionKey": "Cómo funciona",
      "summary": "Los verbos intensionales buscar y necesitar favorecen antecedentes contingentes o inespecíficos en relativas de infinitivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4ADF33600A43F7D09B9FF411",
      "sectionKey": "Cómo funciona",
      "summary": "El sujeto del infinitivo en una relativa puede quedar tácito y recuperarse de la construcción o el contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-349941517A75DE00117D8527",
      "sectionKey": "Cómo funciona",
      "summary": "Tener y haber admiten relativas de infinitivo incluso fuera de contextos negativos, irreales o intensionales.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-32A08C248D4CF9FA7C38B9C4",
      "sectionKey": "Ejemplos",
      "summary": "No tengo nada que decir y Necesitamos un lugar donde descansar ilustran relativas de infinitivo con antecedente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F9938CC2291E78E46AE95174",
      "sectionKey": "Ejemplos",
      "summary": "Marta busca a alguien con quien hablar conserva la preposición que requiere hablar con en la relativa.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C61DF7BC37AF2D6FCE381A4B",
      "sectionKey": "Observación importante",
      "summary": "Las relativas de infinitivo se distinguen de las subordinadas sustantivas porque modifican un antecedente nominal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6DF2FF33BB6FAF53AB7BCAEE",
      "sectionKey": "Observación importante",
      "summary": "No todo nombre seguido por infinitivo forma relativa; debe haber vínculo entre antecedente y elemento relativo, y la construcción está restringida.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
