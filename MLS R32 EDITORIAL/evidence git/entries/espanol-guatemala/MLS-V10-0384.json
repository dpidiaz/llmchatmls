  "claims": [
    {
      "claimId": "MLS-CLM-1CED513E84FC76FE28E548D7",
      "sectionKey": "En pocas palabras",
      "summary": "El carácter numeral no equivale a una categoría gramatical única, pues las expresiones relacionadas con números pueden actuar como adjetivos, pronombres o sustantivos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E97B38DE383F710E99044E2D",
      "sectionKey": "Cómo funciona",
      "summary": "Tres libros muestra un cardinal que modifica al sustantivo, Compré tres un uso sin nombre pronunciado, tercer lugar un ordinal adjetival, un tercio un sustantivo fraccionario y el doble una expresión nominal multiplicativa.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-9BE9305F096917AD79C0BF3C",
      "sectionKey": "Observación importante",
      "summary": "Se deben separar significado, forma y función: un cardinal que cuenta entidades y el sustantivo que designa un guarismo comparten relación con números pero requieren análisis distintos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
