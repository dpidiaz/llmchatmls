  "claims": [
    {
      "claimId": "MLS-CLM-6FF9D4BFC08779D5E4B7C43E",
      "sectionKey": "En pocas palabras",
      "summary": "Los cuantificadores admiten combinaciones distintas con artículos, demostrativos y posesivos según su clase: todos los libros, estos dos libros y mis tres amigos siguen pautas diferentes.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F7AD3BCBE29B87161689048E",
      "sectionKey": "Cómo funciona",
      "summary": "Los numerales siguen con naturalidad al artículo, al demostrativo o al posesivo; todo precede al grupo nominal definido; algunos cuantificadores evaluativos admiten un artículo anterior bajo condiciones particulares.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2952AF63C86F7C543F539241",
      "sectionKey": "Observación importante",
      "summary": "Muchos, pocos y varios suelen introducir el sustantivo directamente en la lectura cuantitativa neutra, pero también existen secuencias definidas restringidas como los pocos recursos o los varios intentos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
