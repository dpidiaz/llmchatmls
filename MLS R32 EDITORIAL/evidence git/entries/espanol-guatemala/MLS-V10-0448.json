  "claims": [
    {
      "claimId": "MLS-CLM-F1E8409E77D49749BC2E247E",
      "sectionKey": "En pocas palabras",
      "summary": "Numerosos predicados y partículas inducen subjuntivo en subordinadas, pero la elección depende de la construcción.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4B074A29441CA699279C7875",
      "sectionKey": "Voluntad e influencia",
      "summary": "Los predicados de voluntad e intención, como querer, seleccionan subjuntivo en sus complementos.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D4F68FF12DDD63A5762CA588",
      "sectionKey": "Voluntad e influencia",
      "summary": "Los predicados de influencia como pedir y ordenar seleccionan subjuntivo en subordinadas.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-683C0127D51E0192E05BD3DB",
      "sectionKey": "Voluntad e influencia",
      "summary": "La NGLE reconoce vení como imperativo voseante y diferencia esa forma de subjuntivos negativos.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-795CE28C21D33355860CCF86",
      "sectionKey": "Valoración y reacción",
      "summary": "Los predicados de afección o reacción emocional suelen construirse con subjuntivo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-59E9F520F2FCF80137482918",
      "sectionKey": "Valoración y reacción",
      "summary": "El subjuntivo con predicados factivos de afección puede presuponer que el contenido subordinado es verdadero.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4105628A4D5D140AFECEE5B3",
      "sectionKey": "Duda, negación y posibilidad",
      "summary": "Dudar induce subjuntivo en su complemento, con excepciones contextuales.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-750886526BCCBB49A3DC5D97",
      "sectionKey": "Duda, negación y posibilidad",
      "summary": "La negación puede inducir subjuntivo, pero la selección interactúa con el predicado y la estructura.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-87ED3C538D7CBCE5C9FA4403",
      "sectionKey": "Duda, negación y posibilidad",
      "summary": "Adverbios de posibilidad y duda pueden inducir subjuntivo también en oraciones no subordinadas.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4A116ED5F4FF63C26B0603C6",
      "sectionKey": "Finalidad y otras conjunciones",
      "summary": "Para que aparece entre los inductores del subjuntivo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BA317D4EFADA1206984D5CAE",
      "sectionKey": "Finalidad y otras conjunciones",
      "summary": "La selección modal con conjunciones subordinantes puede variar según el nexo y la interpretación.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-EA3ED504C802A7B3ACB9DBA7",
      "sectionKey": "Temporales futuras y relativas no identificadas",
      "summary": "Un evento temporal futuro pendiente puede aparecer en subjuntivo bajo un inductor temporal.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CE3EB13840ADD60673653E81",
      "sectionKey": "Temporales futuras y relativas no identificadas",
      "summary": "Los contextos prospectivos y los grupos nominales inespecíficos pueden inducir subjuntivo en relativas.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6F77455FE4539340F0C5C1A1",
      "sectionKey": "El ejemplo de Guatemala",
      "summary": "El DPD describe el voseo en Guatemala y registra formas verbales propias del voseo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A10B4081E695578648C1931E",
      "sectionKey": "Observación importante",
      "summary": "El subjuntivo no equivale a irrealidad, pues puede aparecer con complementos factivos que se dan por ciertos.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5658B9DC9C04103D8B3D53BD",
      "sectionKey": "Observación importante",
      "summary": "La selección modal depende de factores léxicos, sintácticos y de la referencia del antecedente.",
      "claimType": "general",
      "materiality": "substantial"
    },
