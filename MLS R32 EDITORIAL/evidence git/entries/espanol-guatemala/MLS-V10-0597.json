  "claims": [
    {
      "claimId": "MLS-CLM-B3D2440B14536F6C0BAB46D3",
      "sectionKey": "En pocas palabras",
      "summary": "El complemento de régimen está encabezado por una preposición seleccionada por el verbo u otro predicado conforme a su estructura léxica y al sentido de la construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CDA4D97FF26DD8BE2276E322",
      "sectionKey": "Cómo funciona",
      "summary": "Los predicados establecen pautas preposicionales determinadas, como confiar en, depender de o insistir en; cambiar la preposición puede alterar o impedir la construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-98838466E083109F591FC402",
      "sectionKey": "Cómo funciona",
      "summary": "El complemento de régimen puede realizarse mediante grupos nominales, pronombres u oraciones; la preposición seleccionada se conserva al sustituir el término.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-9452725E805CDBC7B9FD844C",
      "sectionKey": "En pocas palabras",
      "summary": "Un complemento de régimen debe distinguirse de los adjuntos locativos: el primero está seleccionado por el predicado, mientras que un adjunto locativo añade una circunstancia no seleccionada.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8838B73451A70A96811AF544",
      "sectionKey": "Ejemplos",
      "summary": "Vos puede funcionar como término de preposición en el voseo americano, incluido el uso guatemalteco.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
