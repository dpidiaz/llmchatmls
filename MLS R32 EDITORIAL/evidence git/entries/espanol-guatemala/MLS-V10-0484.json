  "claims": [
    {
      "claimId": "MLS-CLM-F86BA69B8316194A5713DE92",
      "sectionKey": "En pocas palabras",
      "summary": "Las combinaciones verbo + forma no personal incluyen perífrasis, construcciones próximas y combinaciones no perifrásticas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CF0DA73086A5CCCB38482523",
      "sectionKey": "Cómo funciona",
      "summary": "En perífrasis prototípicas, el auxiliar pierde parte de su autonomía léxica y aporta información gramatical o aspectual.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0A449D6D0BABC5E9D4807ED3",
      "sectionKey": "Cómo funciona",
      "summary": "Las semiperífrasis constituyen una zona de transición cuyo análisis puede variar según criterios descriptivos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CFDA631168225ED5026C6016",
      "sectionKey": "Cómo funciona",
      "summary": "Verbos de fase pueden formar construcciones con distinto grado de auxiliaridad, como empezar a + infinitivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7BC9400BFFA97051B2893F05",
      "sectionKey": "Cómo funciona",
      "summary": "Querer + infinitivo puede conservar el significado léxico de voluntad y alternar con subordinación finita.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-51FA9DED15C1C8F9590E0106",
      "sectionKey": "Cómo funciona",
      "summary": "La posibilidad de sujetos distintos en una subordinada es un indicio de mayor independencia respecto de una perífrasis con sujeto compartido.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-855ADA6341E34EB5D9CF1B6D",
      "sectionKey": "Cómo funciona",
      "summary": "Clíticos, sustitución por subordinadas, significado léxico e inserción de elementos son diagnósticos que se valoran conjuntamente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5A03198147F21C65CDFAE1A0",
      "sectionKey": "Ejemplos",
      "summary": "Empezó a llover ejemplifica una construcción de inicio con forma no personal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4E6275F92221FFEEB4B32CCD",
      "sectionKey": "Ejemplos",
      "summary": "Empezó el trabajo contiene el verbo empezar con complemento nominal, no una perífrasis de infinitivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6A183B071A45A4243422B459",
      "sectionKey": "Ejemplos",
      "summary": "Marta tiene que salir ejemplifica una perífrasis modal con sujeto compartido.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D5CEB0EA9EFD6DFDA1766D8F",
      "sectionKey": "Ejemplos",
      "summary": "Marta quiere viajar conserva un significado volitivo léxico y admite complemento de infinitivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AC770F3369169B9BFC864EA2",
      "sectionKey": "Observación importante",
      "summary": "La oposición entre perífrasis y no perífrasis puede incluir construcciones intermedias y no siempre presenta límites discretos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CB0CD28B6E0B8892FD027569",
      "sectionKey": "Observación importante",
      "summary": "La presencia de dos formas verbales no basta para identificar una perífrasis.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
