  "claims": [
    {
      "claimId": "MLS-CLM-76CEE59119E15AAC725A1295",
      "sectionKey": "En pocas palabras",
      "summary": "El pretérito imperfecto presenta una situación en desarrollo interno y no enfoca necesariamente su inicio ni su final.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7554A27662AE18356A5A3611",
      "sectionKey": "En pocas palabras",
      "summary": "El análisis de copretérito relaciona una situación en imperfecto con un marco pasado; ese marco puede estar expresado o ser evocado por el contexto.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-EFEEEAF630FBCBD7602AFBE8",
      "sectionKey": "Cómo funciona",
      "summary": "El imperfecto puede expresar una serie habitual de acciones dentro de un intervalo pasado, incluso con expresiones como de niño.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6B528960AC5CE4F68EAE303C",
      "sectionKey": "Cómo funciona",
      "summary": "Los imperfectos de fondo pueden presentar un estado o proceso que coincide parcialmente con otro hecho pasado.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E9054C557B23D1DACD4EA0DB",
      "sectionKey": "Ejemplos",
      "summary": "El imperfecto de cortesía puede introducir como presente una petición o deseo y atenuar su formulación mediante distanciamiento retórico.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FC8D8D060A7CF98744AE8C86",
      "sectionKey": "Ejemplos",
      "summary": "El imperfecto puede establecer escenarios soñados, imaginados o lúdicos que no describen hechos pasados reales.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-DDB708663463E52BBFD99CF7",
      "sectionKey": "Observación importante",
      "summary": "Los valores temporales, habituales, de cortesía y de ficción del imperfecto dependen de construcciones y contextos distintos; no constituyen un significado modal único.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4178A7E0BF90F324EA2C2990",
      "sectionKey": "Observación importante",
      "summary": "El imperfecto de cortesía puede referirse a un deseo actual y no implica por sí mismo que el deseo haya terminado.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
