  "claims": [
    {
      "claimId": "MLS-CLM-AA5754CE80A9CF88109E9D3C",
      "sectionKey": "En pocas palabras",
      "summary": "Las perífrasis pueden clasificarse por su significado modal o aspectual y por la forma no personal que las integra.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-55A1FD00CBC1198BAA2737BF",
      "sectionKey": "Cómo funciona",
      "summary": "Las perífrasis modales pueden expresar obligación, necesidad, posibilidad, capacidad o probabilidad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-DB8BE8BA8DEAB89E0B89F1AA",
      "sectionKey": "Cómo funciona",
      "summary": "Las perífrasis aspectuales presentan fases o desarrollo, como inicio, continuidad, repetición o terminación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BB147BCB00196A47086BED09",
      "sectionKey": "Cómo funciona",
      "summary": "Las perífrasis se clasifican también por la forma no personal: infinitivo, gerundio y participio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-975174BF2DFCB6661BC6681A",
      "sectionKey": "Cómo funciona",
      "summary": "La clasificación semántica y la clasificación formal se cruzan y no son excluyentes.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-213D9A8E2C4B1C52F228B26C",
      "sectionKey": "Cómo funciona",
      "summary": "Ir a + infinitivo puede combinar prospectividad con valores temporales, modales o aspectuales según el contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-403DEC351CF1396036354194",
      "sectionKey": "Ejemplos",
      "summary": "Tener que salir es una perífrasis modal de infinitivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-54A27C2329335EAF9702F67E",
      "sectionKey": "Ejemplos",
      "summary": "Estar leyendo es una perífrasis de gerundio con valor progresivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-09C02DB3BD054AD9F17D1FBE",
      "sectionKey": "Ejemplos",
      "summary": "Volver a llamar puede expresar repetición mediante una construcción aspectual.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-89B23384031A72B242DDC1C9",
      "sectionKey": "Observación importante",
      "summary": "Las categorías descriptivas organizan tendencias; algunas construcciones admiten más de una lectura.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3BF39F42B6DF2FE94EB60BB1",
      "sectionKey": "Observación importante",
      "summary": "Modal y aspectual describen significado; infinitivo y gerundio identifican la forma no personal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
