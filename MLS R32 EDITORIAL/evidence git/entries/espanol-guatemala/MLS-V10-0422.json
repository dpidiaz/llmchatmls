  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-A5F9D548F8781A54CEFDDD6C",
      "sectionKey": "En pocas palabras",
      "summary": "Canté es el pretérito perfecto simple, mientras que he cantado es el pretérito perfecto compuesto; ambas formas refieren a hechos anteriores al habla.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-62CFDCABFF0198343BF5ECA0",
      "sectionKey": "En pocas palabras",
      "summary": "La oposición canté/he cantado muestra variación geográfica y no tiene una sola distribución uniforme en todas las comunidades hispanohablantes.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3E9C0ADBBDE84B985983E65B",
      "sectionKey": "Cómo funciona",
      "summary": "En muchas variedades el compuesto evalúa un hecho desde un intervalo que incluye el presente, mientras el simple presenta eventos pasados concluidos.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7B90AB46C6CFA35EC4461ADF",
      "sectionKey": "Cómo funciona",
      "summary": "En Guatemala los estudios reseñados describen uso mayoritario del pretérito simple para acciones pasadas; esto sustenta el ejemplo Hoy canté como compatible con la variedad, sin convertir una muestra en regla universal.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-680C1FA9A561FC5C8F154423",
      "sectionKey": "Ejemplos",
      "summary": "El perfecto compuesto puede expresar experiencias que se evalúan sobre el intervalo de vida hasta el momento de habla.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-763B9F057228ED1C7EFFF38B",
      "sectionKey": "Observación importante",
      "summary": "La oposición no se reduce a una regla fija de distancia temporal; también depende del sistema regional y del tipo de relación con el presente.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D7A82E53835BBECAB4533F33",
      "sectionKey": "Observación importante",
      "summary": "Las formas se describen como variantes del sistema verbal con distribuciones regionales distintas, no como una forma universalmente superior.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
