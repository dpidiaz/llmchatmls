  "claims": [
    {
      "claimId": "MLS-CLM-27095FEFD6FD1B1CE3A2FAA6",
      "sectionKey": "En pocas palabras",
      "summary": "Un adjetivo o grupo adjetival puede funcionar como atributo y predicar una propiedad, estado o valoración del sujeto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4C55FB13EBDC25442C9FF57C",
      "sectionKey": "Cómo funciona",
      "summary": "El atributo adjetival suele concordar en género y número con el sujeto, como muestran las alternancias entre singular y plural.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6EF44647C3895B75C55B4775",
      "sectionKey": "Cómo funciona",
      "summary": "El atributo puede ser un adjetivo simple o un grupo adjetival que incluya modificadores de grado y complementos del adjetivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0DC18F06378628A91D7511E5",
      "sectionKey": "Cómo funciona",
      "summary": "Los valores de los adjetivos con ser y estar dependen de la construcción, del léxico y del contexto, y no se reducen a permanente frente a temporal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-EBF2694A7FEA2925D359898F",
      "sectionKey": "Cómo funciona",
      "summary": "Los adjetivos también aparecen como predicados en construcciones semicopulativas, donde el verbo puede expresar cambio, resultado o continuidad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-936E59573682CF77E6CCA2EC",
      "sectionKey": "Observación importante",
      "summary": "En numerosas copulativas, un atributo adjetival puede ser sustituido por el pronombre neutro invariable lo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
