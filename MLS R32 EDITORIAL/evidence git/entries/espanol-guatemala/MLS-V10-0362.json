  "claims": [
    {
      "claimId": "MLS-CLM-94A7283C23FAD81C8CD85202",
      "sectionKey": "En pocas palabras",
      "summary": "La clasificación semántica distingue cuantificadores fuertes, como todo, cada y ambos, de los débiles, entre los que hay existenciales, numerales, evaluativos y comparativos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1E21FB369136CA141AF75BFD",
      "sectionKey": "Cómo funciona",
      "summary": "Todo y cada aportan totalidad o distribución; alguno y ninguno expresan existencia o ausencia; los cardinales fijan un cómputo, mucho y poco evalúan cantidad, y más y menos expresan comparación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-637F1AB9E7266092C27A35EA",
      "sectionKey": "Observación importante",
      "summary": "La división semántica no equivale a una categoría gramatical: los numerales son débiles aunque expresen cantidades exactas, y una misma forma puede adoptar varios usos sintácticos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
