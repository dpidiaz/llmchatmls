  "claims": [
    {
      "claimId": "MLS-CLM-B6ABF615C065CB16175A66DE",
      "sectionKey": "En pocas palabras",
      "summary": "Los complementos de régimen pueden aparecer con distintas preposiciones seleccionadas por verbos, nombres o adjetivos; el inventario no se limita a unas pocas formas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A05A8CC72206A484CEC417C6",
      "sectionKey": "Cómo funciona",
      "summary": "Los adjuntos expresan circunstancias más libres, como lugar o tiempo, mientras el régimen se integra en una pauta léxica de la palabra rectora.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D5B8896C1780884F77B72D99",
      "sectionKey": "Cómo funciona",
      "summary": "La posibilidad de omitir un grupo no basta por sí sola para distinguirlo de un adjunto, pues algunos complementos seleccionados pueden quedar implícitos según el contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7A961B6AC1B188C5E8149100",
      "sectionKey": "Cómo funciona",
      "summary": "Una misma preposición puede introducir un complemento de régimen o un adjunto; la clasificación requiere considerar la selección léxica y el significado de la construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C9B43FAF92C191A33703544A",
      "sectionKey": "Observación importante",
      "summary": "No existe una prueba única que separe siempre régimen y adjunto; varios indicios pueden concurrir y algunos casos admiten análisis descriptivos próximos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
