    "title": "Contextos de modo dependiente",
    "level": "G3",
    "part": "Subjuntivo y modo / Subjunctive and mood",
    "chapter": "Modo, indicativo y subjuntivo / Mood, indicative, and subjunctive"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 2,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-FA00B2132EFE091DE41FB8CB",
      "sectionKey": "En pocas palabras",
      "summary": "El modo dependiente es inducido por un elemento gramatical, que puede ser un predicado u otro inductor.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7E19FA6896AE07AA6FEA58D4",
      "sectionKey": "En pocas palabras",
      "summary": "Hay contextos subordinados dependientes tanto en subjuntivo como en indicativo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1FCC5F552EA10BB0DAED6E03",
      "sectionKey": "Selección por el predicado principal",
      "summary": "Los predicados afirmativos de conocimiento como saber suelen seleccionar indicativo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F19D2DAF036807352F2A8FBE",
      "sectionKey": "Selección por el predicado principal",
      "summary": "Predicados de voluntad como querer seleccionan subjuntivo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BEB438EB4AA6DC15D0DB223E",
      "sectionKey": "Selección por el predicado principal",
      "summary": "Predicados de influencia como pedir y ordenar seleccionan subjuntivo en la subordinada.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4737863043BD4FD5E0FBEEBD",
      "sectionKey": "Selección por el predicado principal",
      "summary": "Predicados de afección como alegrar suelen seleccionar subjuntivo aunque el contenido se presuponga cierto.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FDFF2D68AB9C165CFDBAB9F8",
      "sectionKey": "Negación y modo",
      "summary": "La negación puede ser un inductor modal y afectar la selección del subjuntivo en la subordinada.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6E3CAA9962939301ED13FBF2",
      "sectionKey": "Negación y modo",
      "summary": "La alternancia modal con un predicado como creer depende de la polaridad y la interpretación, no de una regla automática aplicable a toda negación.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-33A2A2918480F22F5E33C186",
      "sectionKey": "Conjunciones y locuciones",
      "summary": "La conjunción para que induce subjuntivo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6EB5068AAC69E3D0779E12F1",
      "sectionKey": "Conjunciones y locuciones",
      "summary": "Las conjunciones subordinantes pueden imponer un modo o permitir alternancia según el contexto.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AA34E0986C051061EE98B899",
      "sectionKey": "Conjunciones y locuciones",
      "summary": "Los nexos temporales permiten seleccionar modos distintos según el evento se presente como realizado, habitual o prospectivo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AF2B65134DE9894B7D0E292A",
      "sectionKey": "Relativas y referencia",
      "summary": "En las relativas, verbos intensionales como buscar favorecen subjuntivo cuando el grupo nominal es inespecífico.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-64E82EB037B49CF3F804E200",
      "sectionKey": "Relativas y referencia",
      "summary": "Un antecedente identificado puede llevar indicativo, en contraste con una relativa inespecífica en subjuntivo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8B093FBB832149B2F106FEA5",
      "sectionKey": "El ejemplo condicional",
      "summary": "El modo de una subordinada condicional depende del tipo de construcción, y no todas las cláusulas con si llevan subjuntivo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F5C6916E046D26B3294346B4",
      "sectionKey": "Observación importante",
      "summary": "La negación, el tipo de subordinada y la referencia del antecedente interactúan en la selección modal.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FFC0B69A53EFEBB6F6B19DC7",
      "sectionKey": "Ejemplos",
      "summary": "Dudar induce subjuntivo en su complemento oracional.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-826D0564CBAA21B0C65D10BE",
      "sectionKey": "Ejemplos",
      "summary": "Los adverbios de duda pueden inducir subjuntivo sin que la oración sea subordinada.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B5107644002C671F05184A0F",
      "sectionKey": "Ejemplos",
      "summary": "El indicativo también puede estar inducido en una subordinada dependiente.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
