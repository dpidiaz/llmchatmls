  "claims": [
    {
      "claimId": "MLS-CLM-8951DA41D5700FE1D72FEBBF",
      "sectionKey": "En pocas palabras",
      "summary": "El complemento indirecto puede constituirse como un grupo preposicional encabezado por a; esta forma debe reconocerse por su comportamiento sintáctico, no solo por la preposición.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-79FA1DB60F1D18B5B6643EE0",
      "sectionKey": "Cómo funciona",
      "summary": "El grupo con a y un clítico dativo pueden concurrir con el mismo referente; con ciertos predicados la duplicación es obligatoria y sus opciones varían entre variedades.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AC2792DB7A29695A980B9A5B",
      "sectionKey": "Cómo funciona",
      "summary": "Los complementos indirectos de transferencia expresan destinatario y pueden aparecer como grupo con a, clítico dativo o ambos; la opción depende del predicado y de la construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4EC8038FADF80587D16E4F60",
      "sectionKey": "Grupo preposicional y función",
      "summary": "Un grupo con a también puede ser complemento directo de persona; los grupos con para que indican destino o beneficio no son automáticamente complementos indirectos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-98F35E2F1A46D83FA1625813",
      "sectionKey": "Ejemplos",
      "summary": "En el voseo americano, vos puede ser término de preposición y el clítico átono correspondiente puede ser te; el DPD documenta su uso en Guatemala.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
