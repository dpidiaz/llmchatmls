      "summary": "Llevar + gerundio puede medir la duración hasta un punto de referencia.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1F2E2B5EFE2FFC68503C6814",
      "sectionKey": "Cómo funciona",
      "summary": "Ir + gerundio puede presentar evolución progresiva o gradual.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-04D9E78F3FB740D1BCA3102D",
      "sectionKey": "Cómo funciona",
      "summary": "Las perífrasis de gerundio suelen compartir sujeto entre auxiliar y gerundio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-13BB3D65871F411919794B55",
