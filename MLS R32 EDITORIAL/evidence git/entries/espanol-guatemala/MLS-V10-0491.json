      "sectionKey": "Cómo funciona",
      "summary": "En la perífrasis, el auxiliar aporta flexión y valor gramatical/aspectual mientras el gerundio aporta el contenido léxico.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B86BF786A7C9B6CC8135C35A",
      "sectionKey": "Cómo funciona",
      "summary": "Estar + gerundio presenta el evento dentro de su desarrollo y el auxiliar sitúa temporalmente la construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-EFD61B0D232DE56D1E47C8CC",
      "sectionKey": "Cómo funciona",
      "summary": "Seguir + gerundio expresa continuidad de una situación comenzada antes.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B0A9385AA68ABAEBC97B81A7",
