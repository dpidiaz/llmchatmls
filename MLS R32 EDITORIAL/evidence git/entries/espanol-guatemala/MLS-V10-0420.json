  "claims": [
    {
      "claimId": "MLS-CLM-7E5424CC9BD6607558894A60",
      "sectionKey": "En pocas palabras",
      "summary": "El perfecto de hechos recientes presenta hechos anteriores al habla dentro de un intervalo que incluye el momento del habla; su distancia temporal admisible varía.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8C44039B8E012ADC924C3844",
      "sectionKey": "En pocas palabras",
      "summary": "El uso del perfecto compuesto de hechos recientes está restringido geográficamente y las variedades centroamericanas difieren en cómo distribuyen el perfecto simple y el compuesto.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7A180BE6380BA3BB8FA8096C",
      "sectionKey": "Cómo funciona",
      "summary": "Expresiones de tiempo como hoy, esta mañana y hace un momento pueden localizar el hecho dentro de un periodo abierto o del día en curso en las variedades que admiten el perfecto reciente.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FC5A64912C45E6907904134D",
      "sectionKey": "Cómo funciona",
      "summary": "Los estudios de habla de Guatemala describen preferencia por el pretérito perfecto simple para acciones pasadas; ejemplos con vi, hablé y llegó son compatibles con ese patrón.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-94221B6648469536F4164D97",
      "sectionKey": "Ejemplos",
      "summary": "En Guatemala, recién puede preceder o seguir a un verbo conjugado con el sentido de poco tiempo antes o hace muy poco.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-50AA31C84D3A09363467D060",
      "sectionKey": "Observación importante",
      "summary": "El perfecto compuesto puede expresar experiencias evaluadas sobre un periodo que suele abarcar la vida hasta el habla, así como estados resultantes vigentes.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A1E2C4F5E3F29244A87317E2",
      "sectionKey": "Observación importante",
      "summary": "El perfecto compuesto puede evaluar una situación dentro de un intervalo temporal abierto que termina en el momento del habla, como este año.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
