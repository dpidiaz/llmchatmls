      "claimId": "MLS-CLM-DFF3B7651625DBEE04DB7464",
      "sectionKey": "En pocas palabras",
      "summary": "Los tópicos pueden aparecer en posiciones periféricas iniciales o finales, y su función no se determina únicamente por su orden lineal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-57AE9948AD222E074B26E906",
      "sectionKey": "Cómo funciona",
      "summary": "La dislocación a la izquierda sitúa un tópico antes de la oración y puede asociarlo con un pronombre que lo retoma dentro de ella.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-54D1010B417D6BE86DE84A41",
      "sectionKey": "Cómo funciona",
      "summary": "Un tópico puede aparecer en posición final como segmento periférico y relacionarse con la oración previa mediante la estructura informativa.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-DDEE63D024D09AB1E53FA730",
      "sectionKey": "Cómo funciona",
      "summary": "La prosodia y la organización discursiva contribuyen a reconocer los tópicos y a distinguirlos de otros constituyentes.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FE588EF217D6B0D6F01AD75D",
      "sectionKey": "Observación importante",
      "summary": "La posición inicial o final por sí sola no basta para identificar un tópico; también se consideran el contexto y sus vínculos con la oración.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
