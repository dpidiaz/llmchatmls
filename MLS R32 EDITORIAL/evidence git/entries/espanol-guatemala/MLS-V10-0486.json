  "claims": [
    {
      "claimId": "MLS-CLM-7324623299367756F03A2079",
      "sectionKey": "En pocas palabras",
      "summary": "Las perífrasis modales de infinitivo combinan auxiliar conjugado e infinitivo y expresan una relación modal respecto de la situación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-36C6FBE4F969A7D6F302D8A7",
      "sectionKey": "Cómo funciona",
      "summary": "El auxiliar modal aporta valores como obligación, necesidad, posibilidad, capacidad, permiso o probabilidad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-43C2A27CA53BFE7194686F21",
      "sectionKey": "Cómo funciona",
      "summary": "El infinitivo aporta el contenido léxico y no lleva flexión personal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CD2DF6E2D8C24F69762D45E2",
      "sectionKey": "Cómo funciona",
      "summary": "El auxiliar mantiene flexión de persona, número, tiempo y modo mientras adquiere función modal en la construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CB559707D57A5793AE2AD4F5",
      "sectionKey": "Cómo funciona",
      "summary": "Querer + infinitivo puede conservar significado léxico y no se clasifica automáticamente como perífrasis modal prototípica.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A9A1A146532B47758402EBCD",
      "sectionKey": "Ejemplos",
      "summary": "Debes estudiar expresa obligación o recomendación según el contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6DBD696E06C68E4EA10B7AFF",
      "sectionKey": "Ejemplos",
      "summary": "Puedes pasar admite lectura de posibilidad, capacidad o permiso.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E4EA35CA1D70F31761C8E3F7",
      "sectionKey": "Ejemplos",
      "summary": "Tienes que terminar presenta necesidad u obligación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-9479D97309739F243E896F5A",
      "sectionKey": "Observación importante",
      "summary": "La presencia de auxiliar conjugado e infinitivo no basta para identificar una perífrasis modal: se evalúan propiedades de la construcción completa.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-95C0B5ADE69F63FA403957EE",
      "sectionKey": "Observación importante",
      "summary": "Tener posesivo y tener que + infinitivo tienen análisis y significados distintos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
