    "title": "Definición y composición de las perífrasis verbales",
    "level": "G2",
    "part": "Formas no personales y perífrasis / Non-finite forms and periphrases",
    "chapter": "Perífrasis verbales / Verbal periphrases"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 4,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-5462E0CDCE02DC6F4DA3B77F",
      "sectionKey": "En pocas palabras",
      "summary": "Una perífrasis verbal combina un verbo auxiliar conjugado con una forma no personal que aporta el contenido léxico principal del predicado complejo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6B3085D8D3EED3A340D8AEBD",
      "sectionKey": "Cómo funciona",
      "summary": "El auxiliar manifiesta flexión personal, temporal y modal, mientras la forma no personal no se flexiona como verbo personal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C4E4ED5B6015D4BD862F327B",
      "sectionKey": "Cómo funciona",
      "summary": "Algunas perífrasis incluyen un enlace, como tener que + infinitivo o empezar a + infinitivo, y otras carecen de él.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2DF96498CA7E6B624B7AA2D6",
      "sectionKey": "Cómo funciona",
      "summary": "Las perífrasis pueden expresar modalidad, fase o aspecto según el esquema y la construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-30E8EEF1AE9EB486D5D7E376",
      "sectionKey": "Cómo funciona",
      "summary": "En tener que + infinitivo, el conjunto expresa obligación y no posesión de una entidad nominal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B1BD59669D8A6A21472EFA06",
      "sectionKey": "Cómo funciona",
      "summary": "Los auxiliares pueden perder parte de su significado léxico y expresar valores gramaticales, sin que todas las construcciones muestren el mismo grado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-67B2008AEF087088C0F9AEF2",
      "sectionKey": "Cómo funciona",
      "summary": "No toda secuencia verbo + forma no personal es perífrasis; querer + infinitivo puede conservar significado léxico y seleccionar una subordinada.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-590B7710392F7F9EABEBD326",
      "sectionKey": "Ejemplos",
      "summary": "Tengo que salir ejemplifica perífrasis modal de obligación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AE5153EEB176AB15CF67893C",
      "sectionKey": "Ejemplos",
      "summary": "Puede venir ejemplifica una perífrasis de infinitivo con valor modal contextual.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4DA81BBD3EE97716AD6EA7F9",
      "sectionKey": "Ejemplos",
      "summary": "Empezó a llover ejemplifica una construcción de fase o inicio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CA4FC0A42FE1D0D9B79D342D",
      "sectionKey": "Ejemplos",
      "summary": "Está leyendo ejemplifica una perífrasis con gerundio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-EC09DAE747A9646FC8C65659",
      "sectionKey": "Observación importante",
      "summary": "Una definición semántica amplia de perífrasis no basta para distinguirla de combinaciones no perifrásticas; se consideran conjuntamente criterios sintácticos y semánticos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
