    "title": "Características del gerundio",
    "level": "G2",
    "part": "Formas no personales y perífrasis / Non-finite forms and periphrases",
    "chapter": "El gerundio / The gerund"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 2,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-84549C661848511047B07145",
      "sectionKey": "En pocas palabras",
      "summary": "El gerundio es una forma no personal del verbo que suele presentar terminaciones en -ando o -iendo según la conjugación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-DA2AA9253556CEC46C5CC016",
      "sectionKey": "En pocas palabras",
      "summary": "El gerundio puede establecer relaciones temporales o circunstanciales con otra situación y su lectura depende del contexto y la construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C46A8134D30EEC8220A75512",
      "sectionKey": "Cómo funciona",
      "summary": "El gerundio no marca persona, número, tiempo o modo y la interpretación del sujeto se recupera de otros elementos de la oración o el discurso.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0DBD0060E8472B1AF8D82DBB",
      "sectionKey": "Cómo funciona",
      "summary": "El gerundio simple puede recibir interpretación simultánea o anterior respecto de la situación principal, según el aspecto y el contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-74CA8770D3BA54D91CB77031",
      "sectionKey": "Cómo funciona",
      "summary": "Los gerundios pueden expresar manera, como en salió corriendo, y otras relaciones semánticas además de simultaneidad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2FD405B5007B299594394A0D",
      "sectionKey": "Cómo funciona",
      "summary": "El gerundio compuesto se forma con habiendo más participio y suele situar la situación subordinada antes de la principal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-55C7090E280AE2A302FEB159",
      "sectionKey": "Cómo funciona",
      "summary": "Estar + gerundio es una perífrasis verbal que presenta la situación en curso.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-72BAAE67075C09B571DB446D",
      "sectionKey": "Cómo funciona",
      "summary": "El gerundio aparece en funciones adverbiales y también puede desempeñar función predicativa.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8A197619FDC7558C7BBB2E7C",
      "sectionKey": "Ejemplos",
      "summary": "Entró sonriendo ejemplifica un gerundio con sujeto correferente y lectura simultánea con la entrada.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D9C175E5BD8C241CB092AA39",
      "sectionKey": "Ejemplos",
      "summary": "Salió corriendo ejemplifica una interpretación de manera del gerundio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A7D9C0F738C0A35F10A1D288",
      "sectionKey": "Ejemplos",
      "summary": "Marta está leyendo ejemplifica estar + gerundio como perífrasis aspectual.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4E2C75C0D25184E38C703633",
      "sectionKey": "Ejemplos",
      "summary": "Habiendo terminado el trabajo, cerró la computadora ejemplifica anterioridad del gerundio compuesto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0C0C38F0A91DA6F839CFE65C",
      "sectionKey": "Observación importante",
      "summary": "El gerundio tiene valores que no se reducen al desarrollo de una acción; puede expresar relaciones temporales y otros significados.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-690D29D77002F6646A8B344C",
      "sectionKey": "Observación importante",
      "summary": "El gerundio es una forma no personal con propiedades morfológicas y sintácticas propias, distinta del infinitivo y del participio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
