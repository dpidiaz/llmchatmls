  "claims": [
    {
      "claimId": "MLS-CLM-7E77F709121103010E0AB326",
      "sectionKey": "En pocas palabras",
      "summary": "Cantaría es el condicional simple y uno de sus valores temporales sitúa una situación después de un punto pasado.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AEFAA31A663A2B8091B9EFE1",
      "sectionKey": "Cómo funciona",
      "summary": "El condicional puede interpretarse como posterior respecto de un punto pasado, aunque esa relación temporal no determina su relación con el momento actual.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B989D7F3B1877EAAED6340B4",
      "sectionKey": "Cómo funciona",
      "summary": "El condicional simple se describe como futuro del pasado o pospretérito cuando se interpreta respecto de un punto pasado.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F867382F39AFD6C2054CDD70",
      "sectionKey": "Cómo funciona",
      "summary": "El condicional de conjetura es análogo al futuro de conjetura, pero se refiere al pasado en vez de al presente.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-69F574A8D5B6FC6534AE3FC6",
      "sectionKey": "Ejemplos",
      "summary": "Serían las diez puede expresar una estimación de que eran aproximadamente las diez en un momento pasado.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-882399A8E63F02177F8DA7A0",
      "sectionKey": "Ejemplos",
      "summary": "Tendría veinte años puede expresar una estimación de la edad que alguien tenía en un momento pasado.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1EE89F80D9091E684BFE0678",
      "sectionKey": "Ejemplos",
      "summary": "Un futuro con mañana, como mañana tendrá veinte años, puede tener interpretación temporal de posterioridad y no de conjetura presente.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AA46C185AE4B10B63BBA1D25",
      "sectionKey": "Observación importante",
      "summary": "El condicional puede expresar contenidos no factuales además de relaciones temporales, y su interpretación depende de factores contextuales.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-851BE662A8474F5AC4524F31",
      "sectionKey": "Observación importante",
      "summary": "El condicional compuesto habría cantado es un tiempo compuesto que expresa anterioridad respecto de otro punto condicional.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
