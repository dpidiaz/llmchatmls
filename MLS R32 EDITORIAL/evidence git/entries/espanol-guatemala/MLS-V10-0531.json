      "sectionKey": "Ejemplos",
      "summary": "Los ejemplos ilustran locuciones adverbiales de manera, frecuencia y conexión discursiva.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-05F6FC4B3F5A81BDFECF3C4B",
      "sectionKey": "Observación importante",
      "summary": "Un grupo adverbial productivo como bastante bien no constituye por sí solo una locución fija.",
