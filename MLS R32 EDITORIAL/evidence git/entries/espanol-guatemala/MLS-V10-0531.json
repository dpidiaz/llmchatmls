      "sectionKey": "Cómo funciona",
      "summary": "Las locuciones adverbiales presentan grados de fijación y su función global no equivale a la suma libre de sus componentes.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BC7A7CBF56FABC1A4C1073F4",
      "sectionKey": "Cómo funciona",
      "summary": "Locuciones como de repente, a menudo y de vez en cuando pueden expresar tiempo, frecuencia o manera.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4752DA3EB584CC68CF4D2778",
      "sectionKey": "Cómo funciona",
      "summary": "Algunas locuciones adverbiales tienen función discursiva conectiva además de estructura pluriverbal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-24BFD0E8EF21F5126486FAD6",
      "sectionKey": "Cómo funciona",
      "summary": "Las combinaciones libres pueden tener valor circunstancial sin constituir locuciones fijadas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
