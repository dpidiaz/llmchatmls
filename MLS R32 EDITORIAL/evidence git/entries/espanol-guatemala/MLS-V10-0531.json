      "sectionKey": "En pocas palabras",
      "summary": "Una locución adverbial es un grupo pluriverbal que funciona en conjunto de manera semejante a un adverbio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
