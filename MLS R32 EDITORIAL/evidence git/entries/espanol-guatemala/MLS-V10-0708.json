      "sectionKey": "Cómo funciona",
      "summary": "Los vocativos pueden aparecer en distintas posiciones y formar una unidad prosódica separada del resto del enunciado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
