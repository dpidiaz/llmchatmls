      "sectionKey": "Cómo funciona",
      "summary": "Un sujeto puede aparecer antes o después del verbo y mantener la misma función sintáctica.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2CB102CFA6EE0F6D5A40154A",
      "sectionKey": "Cómo funciona",
      "summary": "Los sujetos pueden ser expresos o tácitos; la interpretación de los no expresos se apoya en la flexión verbal y el contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-9DB64BEC864F339DA423BF3C",
      "sectionKey": "Cómo funciona",
      "summary": "La función de sujeto no equivale necesariamente al papel semántico de agente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
