  "claims": [
    {
      "claimId": "MLS-CLM-E5874B592C9F9FF3A68EC63D",
      "sectionKey": "En pocas palabras",
      "summary": "El atributo es una función sintáctica que predica una propiedad, clasificación, identidad o estado del sujeto en construcciones copulativas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7A678DD1269240C1F94CE228",
      "sectionKey": "Cómo funciona",
      "summary": "Ser, estar y parecer enlazan al sujeto con un atributo y presentan relaciones atributivas con diferencias semánticas y sintácticas propias.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4F038A2E6B7B5BBFB09A3B3C",
      "sectionKey": "Cómo funciona",
      "summary": "La función de atributo puede realizarse mediante expresiones de distintas categorías, incluidos grupos adjetivales, nominales y preposicionales.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2144BDBE1B95D3A40AA1B443",
      "sectionKey": "Cómo funciona",
      "summary": "Los atributos adjetivales suelen concordar en género y número con el sujeto, aunque la concordancia no es una señal visible en todas las formas atributivas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5BBBFBC4A63CC5050A0DD7B9",
      "sectionKey": "Cómo funciona",
      "summary": "En numerosas copulativas, el pronombre neutro lo puede sustituir al atributo y permanece invariable frente al género y el número del sujeto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-9B8B19543DE9976E10B54E0F",
      "sectionKey": "Observación importante",
      "summary": "Las expresiones locativas con ser o estar requieren considerar su construcción específica y no se identifican automáticamente con los atributos prototípicos de propiedad o clasificación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
