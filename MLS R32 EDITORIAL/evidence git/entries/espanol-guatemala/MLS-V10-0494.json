      "sectionKey": "Ejemplos",
      "summary": "Tiene preparada la cena presenta un resultado con concordancia.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-EE367A651617FBBD24B87854",
      "sectionKey": "Ejemplos",
      "summary": "Las ventanas quedaron cerradas presenta un estado resultante concordado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-55532B7DBE9B3ADDC489D2EA",
      "sectionKey": "Ejemplos",
      "summary": "Ha leído tres capítulos forma tiempo compuesto con participio invariable.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
