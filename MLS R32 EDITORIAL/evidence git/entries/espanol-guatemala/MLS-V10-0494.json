  "claims": [
    {
      "claimId": "MLS-CLM-E51349279AF3E224E4145DFB",
      "sectionKey": "En pocas palabras",
      "summary": "Las construcciones verbo conjugado + participio pueden expresar resultado, estado alcanzado o cantidad acumulada y varían en cohesión.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5CA7EDF12656C3EA0357005D",
      "sectionKey": "Cómo funciona",
      "summary": "Participios en usos adjetivales o predicativos pueden concordar en género y número con el elemento al que se atribuye el resultado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-585276999A8861C3255C6191",
      "sectionKey": "Cómo funciona",
      "summary": "En haber + participio de tiempo compuesto, el participio es invariable.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5E30CD23DCFEE976F53B4CF2",
      "sectionKey": "Cómo funciona",
      "summary": "Llevar + participio puede expresar una cantidad acumulada y concordar con el grupo nominal medido.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E353502C21B437F275B2A972",
      "sectionKey": "Cómo funciona",
      "summary": "Tener + participio puede presentar un resultado vigente con concordancia.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8977A71A8E93733E9C0B78C7",
      "sectionKey": "Cómo funciona",
      "summary": "Dejar + participio y quedar + participio pueden presentar estados resultantes.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-064F384B2FEB993DBF378C16",
      "sectionKey": "Cómo funciona",
      "summary": "El tiempo gramatical procede del verbo conjugado y no del participio aislado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E981DB8EEE3D881E03B0DF5A",
      "sectionKey": "Ejemplos",
      "summary": "Lleva leídos tres capítulos presenta cantidad acumulada y concordancia del participio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
