  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-32DFBCCFABA6A16A5F4B5BE4",
      "sectionKey": "En pocas palabras",
      "summary": "Los verbos de percepción y los de influencia o causación pueden construirse con grupos verbales de infinitivo que expresan otra situación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-EC5274EF1A9FF0C5D807B095",
      "sectionKey": "En pocas palabras",
      "summary": "En Vi salir a Marta, Marta se interpreta como sujeto semántico de salir y como complemento del verbo ver, con análisis sintáctico objeto de discusión.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-EB724F5452B4E8E3E8BE477F",
      "sectionKey": "Cómo funciona",
      "summary": "Verbos de percepción como ver y oír admiten infinitivos predicativos cuyo contenido puede ser una acción o suceso percibido.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-039A9D289C58E8A1D90FB5E1",
      "sectionKey": "Cómo funciona",
      "summary": "El participante de la construcción perceptiva puede tener doble función interpretativa: argumento del verbo rector y sujeto de la situación infinitiva.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FF7F07AC1660DF22AB710D62",
      "sectionKey": "Cómo funciona",
      "summary": "El orden de los participantes y el infinitivo se relaciona con varios análisis sintácticos debatidos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0708D0A8401F969839855F12",
      "sectionKey": "Cómo funciona",
      "summary": "Hacer y dejar son verbos de influencia/causación que forman construcciones de infinitivo con interpretación causativa o permisiva.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1233C22C0C849B90495B383C",
      "sectionKey": "Cómo funciona",
      "summary": "En construcciones con hacer, el sujeto/causante y el participante que realiza la acción infinitiva corresponden a funciones diferenciadas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-971C547504A9EEF21F4FC793",
      "sectionKey": "Cómo funciona",
      "summary": "Los pronombres átonos pueden realizar o sustituir argumentos en construcciones con verbos de percepción y causación, aunque su análisis depende del verbo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B165DE945CF75847A02369A5",
      "sectionKey": "Ejemplos",
      "summary": "Vi salir a Marta y Oí a Carlos cantar muestran construcciones de percepción con infinitivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D22750FEF10811C175E7A9F6",
      "sectionKey": "Ejemplos",
      "summary": "Hacer entrar y dejar pasar ejemplifican construcciones de influencia o causación con infinitivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-325E49876A2CBA2C3C71D6EC",
      "sectionKey": "Observación importante",
      "summary": "Los verbos de percepción expresan una situación percibida, mientras los de causación expresan que se provoca o permite otra situación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-DBCF7B76B3C2D3D37E4EA83E",
      "sectionKey": "Observación importante",
      "summary": "No toda combinación de verbo más infinitivo sigue este patrón; la interpretación del sujeto depende de la construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
