  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-3FFE096176210528E21CCE92",
      "sectionKey": "En pocas palabras",
      "summary": "Indicativo, subjuntivo e imperativo son modos del español y la selección del modo depende de la sintaxis, el significado de los predicados y la perspectiva discursiva.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E50814ABE23DE94953752938",
      "sectionKey": "En pocas palabras",
      "summary": "El subjuntivo no se limita a duda o irrealidad y aparece en contextos de hechos conocidos, voluntad, valoración, finalidad, negación, futuro y antecedentes no identificados.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A918E288836D9655B045D88D",
      "sectionKey": "Indicativo",
      "summary": "El indicativo aparece frecuentemente bajo predicados de conocimiento, aserción o presentación de contenido como información asumida.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FF6BAF197E3EAA53551FF4C9",
      "sectionKey": "Indicativo",
      "summary": "El indicativo también puede expresar probabilidad y no implica certeza absoluta.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-47F2C79A9C68FE009FF501E0",
      "sectionKey": "Subjuntivo",
      "summary": "Los predicados de voluntad, influencia, valoración, posibilidad y finalidad suelen inducir subjuntivo en sus complementos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-73B29B8DB4B241B7A376AF8E",
      "sectionKey": "Subjuntivo",
      "summary": "El subjuntivo puede aparecer en una subordinada cuyo contenido se presupone verdadero, por ejemplo con predicados de afección.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-DE125E94D841FFA8144A5C92",
      "sectionKey": "Negación y modo",
      "summary": "Creo que viene frente a No creo que venga ejemplifica el efecto de la negación en la selección modal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D29EBE0BBB4CDEF2D840A2F2",
      "sectionKey": "Negación y modo",
      "summary": "La negación no fuerza subjuntivo en todas las subordinadas: las interrogativas indirectas conservan normalmente indicativo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-485E7A3C7941A4F74E98C633",
      "sectionKey": "Conjunciones y subordinación",
      "summary": "Para que y antes de que seleccionan subjuntivo en las construcciones subordinadas correspondientes.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FF41D240BAAE8CDBE1B552E6",
      "sectionKey": "Conjunciones y subordinación",
      "summary": "En temporales con cuando, indicativo presenta un evento realizado y subjuntivo aparece con referencia futura no realizada.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-203BD3B884F1E9892B9A4EF8",
      "sectionKey": "Relativas y referencia",
      "summary": "En relativas, el indicativo favorece interpretación específica y el subjuntivo inespecífica, aunque la correlación exige matices.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-EF1CC71119C7BBD2372DFE7D",
      "sectionKey": "Ejemplos",
      "summary": "La concesiva aunque puede aparecer con subjuntivo o indicativo según la interpretación y el contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-20525D95FEA538D612E5C404",
      "sectionKey": "Observación importante",
      "summary": "La elección modal emerge de interacciones sintácticas, semánticas y discursivas y no de equivalencias absolutas realidad/indicativo frente a duda/subjuntivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
