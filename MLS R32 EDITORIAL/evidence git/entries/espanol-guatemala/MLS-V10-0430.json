  "claims": [
    {
      "claimId": "MLS-CLM-510C32BA3E6C1CA5F172174D",
      "sectionKey": "En pocas palabras",
      "summary": "El pretérito pluscuamperfecto presenta una situación pasada como anterior a otro punto pasado.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-04AE0E6F3474F88BCDD3E3CE",
      "sectionKey": "En pocas palabras",
      "summary": "En Cuando llegué, Ana ya había salido, la salida es anterior al punto pasado de la llegada.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-545D2D2CB2091E63EC13B062",
      "sectionKey": "Cómo funciona",
      "summary": "El pluscuamperfecto se forma con el imperfecto de haber y el participio, que es invariable en los tiempos compuestos.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2251FE199A95879268D57199",
      "sectionKey": "Cómo funciona",
      "summary": "El punto pasado de referencia puede expresarse explícitamente o recuperarse del contexto discursivo.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-80C3BACFE67A11DBC6D912BA",
      "sectionKey": "Ejemplos",
      "summary": "El pluscuamperfecto sitúa acontecimientos anteriores a otro punto pasado que organiza el relato.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FFA6AADDABAEEB2E69B0DB93",
      "sectionKey": "Observación importante",
      "summary": "El pluscuamperfecto no depende de que el intervalo cronológico sea largo; su relación gramatical es de anterioridad respecto de un punto pasado.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-827A8F18A6D558110C094041",
      "sectionKey": "Observación importante",
      "summary": "El pluscuamperfecto se ancla en un punto pasado, mientras el pretérito perfecto compuesto puede anclarse en el momento del habla.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AD2E809882884D6393EA164C",
      "sectionKey": "Ejemplos",
      "summary": "El pretérito perfecto simple presenta un hecho pasado sin la relación de anterioridad relativa propia del pluscuamperfecto.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
