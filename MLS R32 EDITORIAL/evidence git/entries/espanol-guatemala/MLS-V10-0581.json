      "sectionKey": "Cómo funciona",
      "summary": "Los usos absolutos pueden describir actividades habituales o propiedades genéricas, con un objeto implícito o generalizador.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
