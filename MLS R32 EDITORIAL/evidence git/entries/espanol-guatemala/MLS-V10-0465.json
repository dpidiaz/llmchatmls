  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-C92B89A7B95CDB2E8C78E1FE",
      "sectionKey": "En pocas palabras",
      "summary": "Las subordinadas sustantivas de infinitivo pueden desempeñar funciones propias de un grupo nominal, como sujeto, complemento directo o término de preposición.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-86F77EA6961B4A285545A1CE",
      "sectionKey": "En pocas palabras",
      "summary": "El infinitivo conserva estructura verbal y admite complementos verbales dentro de una subordinada sustantiva.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-9DCED06A2CCD398E5B7CE221",
      "sectionKey": "Cómo funciona",
      "summary": "Las subordinadas sustantivas de infinitivo se construyen con verbos, adjetivos y sustantivos rectores.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2D37B7E7CE5668E80B5056F7",
      "sectionKey": "Cómo funciona",
      "summary": "Una subordinada de infinitivo puede contener complementos directos y circunstanciales mientras desempeña externamente función nominal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6E8127AAAB3CE0AD73F493D9",
      "sectionKey": "Cómo funciona",
      "summary": "El sujeto del infinitivo suele ser tácito y puede ser correferente con un argumento del verbo rector.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2E933A551F67065370E8FCF3",
      "sectionKey": "Cómo funciona",
      "summary": "Las oraciones sustantivas de infinitivo pueden funcionar como sujeto o complemento de otra oración.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-46598F33FF50A0C897DF9DCF",
      "sectionKey": "Cómo funciona",
      "summary": "Las subordinadas sustantivas de infinitivo pueden aparecer como término de preposición seleccionada por un verbo, adjetivo o sustantivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F1A7A3F3D4504C34E723AD1F",
      "sectionKey": "Cómo funciona",
      "summary": "Algunas expresiones introducidas por preposiciones no seleccionadas también admiten subordinadas sustantivas de infinitivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3499751A37E4AC53AAB5A77E",
      "sectionKey": "Cómo funciona",
      "summary": "Las perífrasis con auxiliar e infinitivo se distinguen de subordinadas sustantivas, aunque ambas contengan infinitivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-921338D503A88CCC6D18237E",
      "sectionKey": "Ejemplos",
      "summary": "Me gusta leer, Marta decidió viajar y Resolver el problema requiere tiempo ejemplifican complementos y sujetos de infinitivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6F30DDCB510E98EB2318BC9C",
      "sectionKey": "Ejemplos",
      "summary": "Insistieron en revisar los datos ejemplifica un infinitivo como término de preposición seleccionado por el predicado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D72FA24A92C355AB20272DE3",
      "sectionKey": "Observación importante",
      "summary": "Una oración de infinitivo que desempeña función nominal conserva estructura verbal y no se convierte por ello en infinitivo léxico.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
