    "languageName": "Español de Guatemala",
    "title": "Características fundamentales de la concordancia de tiempos. Predicados restrictivos y no restrictivos",
    "level": "G3",
    "part": "Subjuntivo y modo / Subjunctive and mood",
    "chapter": "Tiempos del subjuntivo y relaciones temporales / Subjunctive tenses and temporal relations"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 3,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-C3FB835211BF39875723040A",
      "sectionKey": "En pocas palabras",
      "summary": "La concordancia temporal es la correspondencia entre formas verbales cuando V1 aparece en una oración principal y V2 en una subordinada.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-437C15ED7FA94760AFEF9911",
      "sectionKey": "En pocas palabras",
      "summary": "En las subordinadas, la dependencia temporal suele orientar V2 respecto de V1 y puede suspender el anclaje independiente de V2 al momento del habla.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E833EB0BF32B7DF4C31FC46C",
      "sectionKey": "En pocas palabras",
      "summary": "Las relaciones temporales entre V2 y V1 se describen como anterioridad, simultaneidad o posterioridad.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F3A20D4DC240DF0879DE4833",
      "sectionKey": "Cómo funciona",
      "summary": "En contextos no marcados, los pretéritos subordinados suelen denotar situaciones anteriores a las expresadas por los verbos de los que dependen.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8846F3C7E657B7B46FC93799",
      "sectionKey": "Cómo funciona",
      "summary": "En contextos no marcados, los futuros subordinados suelen denotar situaciones posteriores al predicado principal.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-703C3796B02DE0095FBFB45A",
      "sectionKey": "Predicados restrictivos",
      "summary": "Las propiedades semánticas de V1 pueden determinar de forma esencial la dependencia temporal de V2; la NGLE clasifica estos predicados en restrictivos y no restrictivos.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B08293C32A61B00732B1D033",
      "sectionKey": "Predicados restrictivos",
      "summary": "Los predicados restrictivos orientan la interpretación temporal de sus complementos.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8547DF750E353564A91D6850",
      "sectionKey": "Predicados restrictivos",
      "summary": "Los predicados de influencia, voluntad, predicción, resolución o determinación y modales suelen orientar prospectivamente los complementos, aunque algunos admiten simultaneidad o anterioridad en contextos particulares.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AF63BD4B00A09012C4AF3953",
      "sectionKey": "Predicados restrictivos",
      "summary": "Los predicados de influencia como ordenar favorecen complementos posteriores, como en Le ordenaron que saliera.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CF3363BAB7B65F00B08CFB61",
      "sectionKey": "Predicados restrictivos",
      "summary": "Predicados como reprochar y criticar suelen referirse a actuaciones ya realizadas, aunque la anterioridad no es una restricción absoluta.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D4859A0B7838390351DC592D",
      "sectionKey": "Predicados restrictivos",
      "summary": "Los predicados de percepción como ver favorecen la simultaneidad entre el evento percibido y la percepción, como en Vio que cruzaban la calle.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-05CC97A4B1C4A1C24AA26810",
      "sectionKey": "Predicados no restrictivos",
      "summary": "Los predicados no restrictivos no imponen una restricción temporal léxica única a V2.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-269D8545CFF1CCEC01B0483D",
      "sectionKey": "Predicados no restrictivos",
      "summary": "Sentir puede admitir en su subordinada tiempos con interpretación anterior, simultánea o prospectiva, como en Siento que hayas tenido, tengas o vayas a tener problemas.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-91310344561040172736A1AB",
      "sectionKey": "Predicados no restrictivos",
      "summary": "Entre los predicados no restrictivos característicos se encuentran verbos de lengua y algunos de pensamiento, que admiten varias orientaciones temporales en sus subordinadas.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-102297234F0F91D2EEADD41C",
      "sectionKey": "Observación importante",
      "summary": "La concordancia temporal no se reduce a copiar el tiempo verbal principal: participan las relaciones entre eventos, las propiedades léxicas del predicado y la perspectiva temporal de la subordinada.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
