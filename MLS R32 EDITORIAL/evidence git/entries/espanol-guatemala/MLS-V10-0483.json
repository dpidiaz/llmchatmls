  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-1B5302035EC734D45CD52470",
      "sectionKey": "En pocas palabras",
      "summary": "Las perífrasis presentan cohesión sintáctica entre auxiliar y forma no personal, aunque sus componentes conservan algunas propiedades propias.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CC4D26BE069DEBE7B25B3391",
      "sectionKey": "En pocas palabras",
      "summary": "La posibilidad de subida de clíticos es uno de varios indicios de unidad perifrástica y no una prueba única.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-9B213C5D0A452503161181C7",
      "sectionKey": "Cómo funciona",
      "summary": "Los pronombres átonos pueden aparecer junto al auxiliar o adjuntos a infinitivos y gerundios en determinadas perífrasis.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-52F81AB1034BADCF39FE5303",
      "sectionKey": "Cómo funciona",
      "summary": "La disponibilidad de subida de clíticos depende de la perífrasis y otros factores gramaticales.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-640A9845C08A546AE0E5FB80",
      "sectionKey": "Cómo funciona",
      "summary": "El sujeto suele compartirse entre auxiliar y forma no personal dentro de una perífrasis.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E80C4725C7DF753796B02E81",
      "sectionKey": "Cómo funciona",
      "summary": "El auxiliar de una perífrasis no siempre conserva la selección nominal propia de su uso léxico.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-23D492D2098E3F648384AA62",
      "sectionKey": "Cómo funciona",
      "summary": "Las perífrasis muestran restricciones de sustitución y cohesión que ayudan a distinguirlas de subordinadas finitas, pero no son pruebas absolutas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-92FD3D5C3F85BD339E313FDF",
      "sectionKey": "Ejemplos",
      "summary": "Lo tengo que hacer y Tengo que hacerlo ilustran alternancia de posición del clítico en una perífrasis.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D598B00C0A96511E10C7921A",
      "sectionKey": "Ejemplos",
      "summary": "La están revisando y Están revisándola ilustran posiciones del pronombre con estar + gerundio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2DBE901EF0094233F8EBE003",
      "sectionKey": "Ejemplos",
      "summary": "Marta debe salir temprano comparte sujeto entre auxiliar e infinitivo en la lectura perifrástica.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5A6F8921025F1C46782CB05A",
      "sectionKey": "Observación importante",
      "summary": "Ningún diagnóstico sintáctico aislado clasifica de forma concluyente todas las combinaciones verbales.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B56C15428BC0F6D1878A8C97",
      "sectionKey": "Observación importante",
      "summary": "La cercanía formal entre verbos no basta: la identificación combina significado, sintaxis y léxico.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
