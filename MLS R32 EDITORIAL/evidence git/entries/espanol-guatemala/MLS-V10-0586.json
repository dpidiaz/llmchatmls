      "sectionKey": "En pocas palabras",
      "summary": "Las locuciones verbales formadas con verbos transitivos pueden incluir un grupo nominal que funciona como complemento directo aunque el grupo verbal esté lexicalizado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
