      "sectionKey": "Cómo funciona",
      "summary": "Las preposiciones pueden introducir grupos nominales, pronombres y oraciones de infinitivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2EE36594DAEF3824892CBB74",
      "sectionKey": "Cómo funciona",
      "summary": "Tras preposición se usan formas tónicas como mí y vos, y con admite formas amalgamadas como conmigo y contigo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C835CF22555262919CE5C2AA",
      "sectionKey": "Cómo funciona",
      "summary": "El voseo pronominal emplea vos como término de preposición y es un tratamiento de uso general en Guatemala, con variación social y de formalidad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-995390A8140CE6A51A49A14B",
      "sectionKey": "Ejemplos",
      "summary": "Para mí, de vos, conmigo y con vos ilustran formas pronominales en complementos preposicionales.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6AC51064272CBD9088560F8B",
      "sectionKey": "Observación importante",
      "summary": "El término puede ser un grupo completo y las posibilidades dependen de la preposición, locución y variedad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
