    {
      "claimId": "MLS-CLM-50AF5D05F46D77CE6D4D1E6D",
      "sectionKey": "En pocas palabras",
      "summary": "Las construcciones absolutas pueden expresar relaciones temporales, causales, condicionales, concesivas u otras circunstancias según la estructura y el contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E77BE8951B3FC4A0A0C8C4E4",
      "sectionKey": "Cómo funciona",
      "summary": "Con participios, las construcciones absolutas suelen establecer una relación temporal o resultativa con el evento de la oración principal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-41507BB0D04B084D999AD308",
      "sectionKey": "Cómo funciona",
      "summary": "Las construcciones absolutas de gerundio pueden presentar una situación simultánea al evento principal, aunque la relación exacta depende del contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F372BB922D4D4C8511E7CDC0",
      "sectionKey": "Cómo funciona",
      "summary": "La interpretación semántica de una construcción absoluta procede de su predicación y de la relación contextual con la oración principal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-01FA0869632ADA8E4AB7FB24",
      "sectionKey": "Observación importante",
      "summary": "Una construcción absoluta no expresa siempre una sola relación semántica ni lleva necesariamente un nexo que determine su interpretación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
