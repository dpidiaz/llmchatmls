  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-62744726CAAB25A18FE6135E",
      "sectionKey": "En pocas palabras",
      "summary": "El pretérito imperfecto de subjuntivo tiene las variantes en -ra y en -se, que alternan en la mayoría de los contextos.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6D2ED0DA7ACC8D476698A6AE",
      "sectionKey": "En pocas palabras",
      "summary": "En el español americano se prefiere cantara, pero cantase se usa ampliamente, en especial en la lengua escrita; la valoración oral varía por región.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C39C4E31695A4A129EEFCD17",
      "sectionKey": "En pocas palabras",
      "summary": "El pretérito pluscuamperfecto de subjuntivo se forma con hubiera o hubiese más participio, como hubiera cantado / hubiese cantado.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-449F8A4CC250D0FE412F5525",
      "sectionKey": "Cómo funciona",
      "summary": "El imperfecto de subjuntivo puede corresponder a varios tiempos del indicativo y su interpretación temporal depende de la construcción y del anclaje.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E39BE8750560EE0160D689C7",
      "sectionKey": "Cómo funciona",
      "summary": "En una prótasis condicional, tuviera puede expresar una condición hipotética presente o futura, no un hábito pasado.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5715B16E03B2031ADB9BC8AA",
      "sectionKey": "Cómo funciona",
      "summary": "El pluscuamperfecto de subjuntivo puede expresar anterioridad pasada o una situación irreal, según el contexto.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5C825C3B98E64236F10FC3F7",
      "sectionKey": "Ejemplos",
      "summary": "En Si hubieses llamado antes, te habría esperado, la condición se interpreta como pasada e irreal.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CFF76070561361DE151C171A",
      "sectionKey": "Ejemplos",
      "summary": "Ojalá estuvieras aquí usa el imperfecto de subjuntivo en una construcción desiderativa cuyo deseo se refiere a la situación actual.",
      "claimType": "example",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-023E1B320FD10FF20EBB7080",
      "sectionKey": "Observación importante",
      "summary": "La oposición entre tuviera y hubiera tenido incluye diferencias de aspecto y de anclaje temporal, no solo de distancia cronológica.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
