    "title": "Aspectos morfológicos del gerundio",
    "level": "G2",
    "part": "Formas no personales y perífrasis / Non-finite forms and periphrases",
    "chapter": "El gerundio / The gerund"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 2,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-AF2EEFDE4C715333768185DF",
      "sectionKey": "En pocas palabras",
      "summary": "Los gerundios regulares suelen terminar en -ando en la primera conjugación y en -iendo en la segunda y tercera.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-49EB4FDB78A74203524067BE",
      "sectionKey": "En pocas palabras",
      "summary": "El gerundio es invariable en género y número y carece de flexión personal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B256E609A951A91ACE7809A6",
      "sectionKey": "Cómo funciona",
      "summary": "Los verbos en -ar forman normalmente gerundio con -ando.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-96B1E732961E0387FA155DDB",
      "sectionKey": "Cómo funciona",
      "summary": "Los verbos en -er e -ir forman normalmente gerundio con -iendo, con alternancias en algunas raíces.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-28A3D3229E679784E99E9160",
      "sectionKey": "Cómo funciona",
      "summary": "Cuando la raíz termina en vocal pueden aparecer gerundios en -yendo, como leyendo y oyendo; ir tiene yendo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5671868C5CDFE56D5E8F029B",
      "sectionKey": "Cómo funciona",
      "summary": "Algunos verbos en -ir presentan cambios vocálicos en el gerundio, como dormir y pedir.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F5FF4B879A7131F599F40940",
      "sectionKey": "Cómo funciona",
      "summary": "El gerundio puede ser simple o compuesto; el compuesto se forma con habiendo más participio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-062C636E8BA9F9618C10F116",
      "sectionKey": "Cómo funciona",
      "summary": "Pronombres átonos pueden posponerse a formas no personales, incluido el gerundio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-169D0FF7946C7377D369A8FD",
      "sectionKey": "Cómo funciona",
      "summary": "Las formas con enclíticos se acentúan de acuerdo con las reglas generales aplicadas a la palabra resultante.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B35228AA52E28A5E729B39F1",
      "sectionKey": "Ejemplos",
      "summary": "Hablar forma hablando; comer y vivir forman comiendo y viviendo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7FD556B5B7B36604351A5669",
      "sectionKey": "Ejemplos",
      "summary": "Leer forma leyendo y dormir forma durmiendo con alternancia de raíz.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6B0FB8B30C8B7ECE1ED3B01A",
      "sectionKey": "Ejemplos",
      "summary": "Decir forma diciendo y con el enclítico lo se escribe diciéndolo según la acentuación de la palabra resultante.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-170985B8018DBB1F6E5D2815",
      "sectionKey": "Observación importante",
      "summary": "Aspectos morfológicos del gerundio se refiere a la formación de esta forma verbal, no al aspecto semántico de tiempos personales.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5D3EC06D3AF480E6D8E4F759",
      "sectionKey": "Observación importante",
      "summary": "Las terminaciones del gerundio no codifican por sí solas persona, número ni tiempo personal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
