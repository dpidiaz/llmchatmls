  "claims": [
    {
      "claimId": "MLS-CLM-6668C5D0F641ADC9A6DB503F",
      "sectionKey": "En pocas palabras",
      "summary": "El gerundio puede expresar manera, causa, condición, concesión y otros valores; la interpretación surge de la construcción y el contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D1A4EDF8E56D1C637C149C3D",
      "sectionKey": "Cómo funciona",
      "summary": "El gerundio puede expresar manera y simultaneidad, como en salió corriendo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E8A8A6A4AD38B9D775552BBC",
      "sectionKey": "Cómo funciona",
      "summary": "Un gerundio antepuesto puede recibir lectura causal cuando el contexto relaciona esa situación con la decisión principal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-9596ACFF164F4D24C9CB5F7E",
      "sectionKey": "Cómo funciona",
      "summary": "Ciertas construcciones permiten interpretación condicional contextual del gerundio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-228FD15B6489410C92CD156B",
      "sectionKey": "Cómo funciona",
      "summary": "Aun + gerundio puede aparecer en construcciones concesivas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A5C608E1591450C8B64434B5",
      "sectionKey": "Cómo funciona",
      "summary": "La posterioridad del gerundio está sujeta a restricciones y se distingue la consecuencia inmediata del hecho posterior autónomo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5E7F13E84F972A959B0D0AA3",
      "sectionKey": "Cómo funciona",
      "summary": "El gerundio compuesto favorece anterioridad y puede combinarla con relaciones causales o circunstanciales.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3FE6EBBB07D2D8454BA7520D",
      "sectionKey": "Observación importante",
      "summary": "No existe una correspondencia rígida entre gerundio y una única relación semántica; la lectura depende del verbo, construcción y contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-137242E8F58F0B95A8B94161",
      "sectionKey": "Observación importante",
      "summary": "El gerundio puede establecer relaciones semánticas variadas sin convertirse por ello en tiempo verbal personal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
