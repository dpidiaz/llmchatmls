  "claims": [
    {
      "claimId": "MLS-CLM-A287560015C2E8E7308D63D1",
      "sectionKey": "En pocas palabras",
      "summary": "La sustitución del complemento directo por pronombres átonos está condicionada por rasgos como género, número y tipo de referente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3492BD3306D18E1F5D4DF597",
      "sectionKey": "Cómo funciona",
      "summary": "Los complementos directos nominales se sustituyen prototípicamente por lo, la, los o las, mientras que lo neutro puede recuperar contenidos oracionales.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5F4CC01E472B5CF138BEE34B",
      "sectionKey": "Cómo funciona",
      "summary": "El leísmo constituye una variación en el uso de pronombres átonos de tercera persona y requiere distinguir los usos con referentes personales masculinos de los demás contextos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-039EABEF97D77382C3121694",
      "sectionKey": "Cómo funciona",
      "summary": "Los pronombres átonos pueden ser proclíticos o enclíticos; su posición depende de la forma verbal y de la estructura.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-70832E6B5EBAC0B58FAE2770",
      "sectionKey": "Sustitución y función",
      "summary": "El contraste entre pronombres acusativos y dativos ayuda a distinguir complemento directo e indirecto, aunque los fenómenos de leísmo, laísmo y loísmo introducen variación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
