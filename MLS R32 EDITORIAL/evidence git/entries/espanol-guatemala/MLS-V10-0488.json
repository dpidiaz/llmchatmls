  "claims": [
    {
      "claimId": "MLS-CLM-EB7B3580DEB5180D8382B79B",
      "sectionKey": "En pocas palabras",
      "summary": "Ir a + infinitivo presenta una situación desde un punto de referencia anterior como proyectada, futura o prospectiva.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-557B449408BCE5270B4995F2",
      "sectionKey": "Cómo funciona",
      "summary": "Ir a + infinitivo puede situar el evento después del presente y no requiere que ir denote desplazamiento físico.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-571FFE7D8EF197548A4C87DF",
      "sectionKey": "Cómo funciona",
      "summary": "La referencia de ir a + infinitivo puede ser futura respecto de un punto pasado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-060C0467971D18BF207498C4",
      "sectionKey": "Cómo funciona",
      "summary": "La construcción admite lecturas de predicción, inminencia, plan o intención según contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A5FB4038EF02B831D2574F0F",
      "sectionKey": "Cómo funciona",
      "summary": "La perífrasis combina valores temporales prospectivos con matices modales o aspectuales.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7CB2119614CDCFA958279631",
      "sectionKey": "Cómo funciona",
      "summary": "El sujeto suele compartirse entre auxiliar ir e infinitivo en la perífrasis.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7A993FB25ABF7ABE58B1B6B0",
      "sectionKey": "Cómo funciona",
      "summary": "Los clíticos pueden aparecer junto a ir o unidos al infinitivo en esta construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CB0B4A98992FC0D59CAA6E26",
      "sectionKey": "Ejemplos",
      "summary": "Voy a llamar mañana sitúa la llamada después del momento actual.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C6A21D0C4A5165AC057DC0A6",
      "sectionKey": "Ejemplos",
      "summary": "Iba a salir cuando empezó a llover proyecta la salida desde un punto de referencia pasado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E88D333A6E8C444527F2013D",
      "sectionKey": "Ejemplos",
      "summary": "Va a llover puede expresar predicción prospectiva.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2F054C6C9697598159CE1156",
      "sectionKey": "Observación importante",
      "summary": "El futuro morfológico, el presente con valor futuro y la perífrasis ir a + infinitivo son recursos distintos aunque puedan coincidir en algunos contextos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1A38E8A5A30CC39F31AD7466",
      "sectionKey": "Observación importante",
      "summary": "Ir a + infinitivo no equivale siempre a futuro inmediato: admite lecturas prospectivas no inmediatas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
