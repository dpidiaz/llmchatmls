  "claims": [
    {
      "claimId": "MLS-CLM-37A46FA18B2F9B31EB3360EE",
      "sectionKey": "En pocas palabras",
      "summary": "Las preposiciones a y ante pueden introducir complementos seleccionados por verbos, sustantivos y adjetivos; la relación depende de la construcción y de la palabra rectora.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-987278724294677818CDC799",
      "sectionKey": "Cómo funciona",
      "summary": "La preposición a se mantiene cuando cambia el término del complemento, incluido en expresiones con contracción al; la relación de régimen permanece.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-08D2F3DA5B532AAE16248A27",
      "sectionKey": "Cómo funciona",
      "summary": "Los sustantivos y adjetivos también seleccionan complementos con a o ante, de modo que la dependencia se establece con la palabra que rige el grupo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-334E9F0450F9C5E18EF5CF83",
      "sectionKey": "Observación importante",
      "summary": "La misma preposición a o ante puede introducir un complemento seleccionado o expresar destino, situación o espacio; la forma de la preposición no basta para identificar régimen.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
