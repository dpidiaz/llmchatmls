    "title": "Significado de los infinitivos verbales",
    "level": "G2",
    "part": "Formas no personales y perífrasis / Non-finite forms and periphrases",
    "chapter": "El infinitivo / The infinitive"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 3,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-A42D20DF81A276F7D2C97F3B",
      "sectionKey": "En pocas palabras",
      "summary": "Los infinitivos verbales mantienen propiedades semánticas y sintácticas del verbo y pueden denotar acciones, estados o procesos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5ED275C8514599640D21CE1C",
      "sectionKey": "En pocas palabras",
      "summary": "El infinitivo no expresa flexión de persona, tiempo o modo; la interpretación se obtiene en gran medida del contexto y del predicado rector.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-767D56F5835AE534B5664F9D",
      "sectionKey": "Cómo funciona",
      "summary": "El infinitivo simple carece de las oposiciones temporales personales y su referencia temporal depende de la construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5F16A8D2D7C2D39DC6201DC6",
      "sectionKey": "Cómo funciona",
      "summary": "Los predicados de voluntad, temor, solicitud o influencia pueden dar interpretación prospectiva al infinitivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D99AB2CCF6B84C4738D0D2B2",
      "sectionKey": "Cómo funciona",
      "summary": "Con verbos de percepción, el infinitivo puede tener lectura temporal simultánea respecto del predicado principal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-859CE6C90B7EAF57B48BAA8F",
      "sectionKey": "Cómo funciona",
      "summary": "El infinitivo compuesto haber + participio puede expresar una situación anterior a la del predicado principal y aportar interpretación perfectiva.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-774CCEC8159002C8CE70D986",
      "sectionKey": "Cómo funciona",
      "summary": "Los infinitivos verbales pueden seleccionar complementos directos, indirectos, de régimen y circunstanciales propios de su verbo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-37E15321286CAC4BE8119768",
      "sectionKey": "Cómo funciona",
      "summary": "La referencia del sujeto tácito del infinitivo puede recuperarse por correferencia con un argumento expreso del predicado principal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-05E64632728A56DD331AFD05",
      "sectionKey": "Cómo funciona",
      "summary": "Los infinitivos verbales forman parte de perífrasis verbales, aunque también aparecen en otras construcciones dependientes y no toda secuencia verbal es por ello perífrasis.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5776B04393211276F182F07D",
      "sectionKey": "Ejemplos",
      "summary": "Quiero viajar puede recibir interpretación prospectiva a partir del predicado querer y del contexto temporal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-349247F7AF7C0EF40CEA5902",
      "sectionKey": "Ejemplos",
      "summary": "Lamenta haber llegado emplea infinitivo compuesto con interpretación retrospectiva respecto del lamento.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B982FBC2C4DED1CA22FA2837",
      "sectionKey": "Observación importante",
      "summary": "Decir que el infinitivo no tiene tiempo es una simplificación: no posee flexión temporal personal, pero la construcción le asigna relaciones temporales.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C0AF5ADF4A8ECBE238F5756B",
      "sectionKey": "Observación importante",
      "summary": "Una secuencia de infinitivo puede conservar sintaxis verbal y desempeñar externamente una función nominal sin ser un sustantivo léxico.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
