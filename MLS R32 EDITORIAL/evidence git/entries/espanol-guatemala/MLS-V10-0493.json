      "claimId": "MLS-CLM-497D86992174AECE674B5807",
      "sectionKey": "En pocas palabras",
      "summary": "Andar y venir + gerundio pueden formar perífrasis con valores de repetición/distribución o de desarrollo desde un punto anterior.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7B1A08641C608F4364E57582",
      "sectionKey": "Cómo funciona",
      "summary": "Andar + gerundio suele presentar actividad repetida, distribuida o extendida en varios momentos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0477E6F706ADE9AD6650551F",
      "sectionKey": "Cómo funciona",
      "summary": "En verbos de habla, andar + gerundio puede sugerir repetición o difusión.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-DA1F7A4F34AE4AC105161B4B",
      "sectionKey": "Cómo funciona",
      "summary": "Venir + gerundio puede presentar evolución iniciada antes y prolongada hasta el punto de referencia.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D1C7BF754D98350A5C53C3E3",
      "sectionKey": "Cómo funciona",
      "summary": "Venir + gerundio suele ofrecer una perspectiva retrospectiva de un proceso acumulado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5895AD02888999D0C5D1B611",
      "sectionKey": "Cómo funciona",
      "summary": "Acabar + gerundio puede presentar un desenlace después de un proceso, con clasificación dependiente de la construcción.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-90ED054909A877E7A22D9165",
      "sectionKey": "Cómo funciona",
      "summary": "El auxiliar conjugado lleva las marcas de tiempo y persona, mientras el gerundio permanece invariable.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-97924478130C5E31D7A23302",
      "sectionKey": "Ejemplos",
      "summary": "Anda buscando trabajo presenta actividad distribuida durante un período.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4C4ECE23B5763A3F2B159A6E",
      "sectionKey": "Ejemplos",
      "summary": "Anda diciendo que se va puede presentar repetición o difusión de lo dicho.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2FEAF48D5D0D0B9AFBA67B8E",
      "sectionKey": "Ejemplos",
      "summary": "Los precios vienen aumentando desde enero presenta evolución iniciada previamente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7F827465D0C56A3718C9659F",
      "sectionKey": "Observación importante",
      "summary": "Andar, venir y estar + gerundio aportan matices distintos y no se intercambian libremente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-41CFBBC5AE56E973564EDE1A",
      "sectionKey": "Observación importante",
      "summary": "No toda combinación de verbo y gerundio es perifrástica; se evalúan cohesión y debilitamiento del significado léxico.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
