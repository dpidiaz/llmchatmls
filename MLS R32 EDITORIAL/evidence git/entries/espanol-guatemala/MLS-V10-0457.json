    "title": "Infinitivos nominales e infinitivos verbales",
    "level": "G2",
    "part": "Formas no personales y perífrasis / Non-finite forms and periphrases",
    "chapter": "El infinitivo / The infinitive"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 2,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-89F8B27B3E466ED84286671D",
      "sectionKey": "En pocas palabras",
      "summary": "El infinitivo puede formar grupos verbales y también aparecer como infinitivo nominal; algunos usos combinan propiedades nominales y verbales.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6625709E8E35C7EC583E33E9",
      "sectionKey": "En pocas palabras",
      "summary": "La clasificación entre infinitivo verbal y nominal depende de rasgos estructurales, no únicamente de que aparezca artículo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E424183F75B8E25B94E43FFE",
      "sectionKey": "Cómo funciona",
      "summary": "El infinitivo verbal conserva complementos del verbo como objeto directo y modificador adverbial.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0BE396E8F1C88F1A770F57F2",
      "sectionKey": "Cómo funciona",
      "summary": "Una oración completa de infinitivo puede funcionar como sujeto conservando los complementos verbales internos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-331C0182E1B6EA901D23D45C",
      "sectionKey": "Cómo funciona",
      "summary": "Se distinguen infinitivos nominales de naturaleza léxica y de naturaleza sintáctica.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C66E841B5D6A98B2EBC7D9FE",
      "sectionKey": "Cómo funciona",
      "summary": "Los infinitivos nominales léxicos se comportan como nombres y algunos admiten plural y aparecen como tales en diccionarios.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6BFA90B210068BB5CB656E81",
      "sectionKey": "Cómo funciona",
      "summary": "Algunos infinitivos de naturaleza sintáctica admiten determinantes y adjetivos, pero no necesariamente plural.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A616CCF6C0FAA3F47853837E",
      "sectionKey": "Cómo funciona",
      "summary": "Hay usos híbridos con propiedades verbales y nominales simultáneas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1AC5EBBED5F4945AF854A2EE",
      "sectionKey": "Ejemplos",
      "summary": "Preparar la cena funciona como oración de infinitivo y admite el complemento directo la cena.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6A314604939E3F242C5EA621",
      "sectionKey": "Ejemplos",
      "summary": "Un infinitivo precedido por artículo puede ser verbal si conserva complementación verbal y estructura oracional.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-62DC84D5A3E6A96ABB42E1EF",
      "sectionKey": "Observación importante",
      "summary": "Que el infinitivo ocupe función sintáctica nominal, por ejemplo sujeto, no lo convierte automáticamente en sustantivo léxico.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7E8F82E885D45959BC5E8848",
      "sectionKey": "Observación importante",
      "summary": "La división entre usos nominales sintácticos y léxicos describe distintos grados y propiedades de nominalización.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
