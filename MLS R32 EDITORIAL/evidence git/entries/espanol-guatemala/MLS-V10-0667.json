  "claims": [
    {
      "claimId": "MLS-CLM-6053154A6758F5D676DE2A07",
      "sectionKey": "En pocas palabras",
      "summary": "Los adverbios particularizadores destacan una alternativa como precisa o especialmente pertinente, mientras las expresiones aproximativas acercan un valor a un límite.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-514BB43BC576E27AAF4C4461",
      "sectionKey": "Cómo funciona",
      "summary": "Casi y otras expresiones aproximativas presentan una cantidad o grado como cercano a un valor sin identificarlo como exacto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BBF38ED0756B2091AA2865EE",
      "sectionKey": "Cómo funciona",
      "summary": "Precisamente y formas semejantes pueden seleccionar una alternativa como la que resulta especialmente exacta o relevante.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-50D24F81954DE9E72204FEA0",
      "sectionKey": "Cómo funciona",
      "summary": "La expresión aproximativa incide sobre cantidades, grados u otras magnitudes y su alcance depende de la estructura.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E3145542160D77F177371134",
      "sectionKey": "Observación importante",
      "summary": "La aproximación y la particularización no son equivalentes: una indica cercanía a un valor y la otra resalta una alternativa precisa.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
