  "claims": [
    {
      "claimId": "MLS-CLM-5DA2663FE3D38A7A9E8B8D98",
      "sectionKey": "En pocas palabras",
      "summary": "El complemento indirecto es una función sintáctica expresada por pronombres átonos de dativo o por grupos preposicionales con a que pueden sustituirse por esos pronombres.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E5493845A3FD1F0B11622276",
      "sectionKey": "Cómo funciona",
      "summary": "Los complementos indirectos pueden expresar destinatario, experimentante, origen, beneficiario o persona afectada; estos son papeles semánticos distintos de la función sintáctica.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B55A29EACD7FA7EFA54F0253",
      "sectionKey": "Cómo funciona",
      "summary": "El complemento indirecto puede aparecer duplicado por un pronombre correferente; en ciertos verbos la duplicación es obligatoria y sus posibilidades varían entre variedades.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-92357B0D3FB45901AFA3A866",
      "sectionKey": "Observación importante",
      "summary": "Un grupo con para no constituye por sí solo un complemento indirecto: no admite las mismas propiedades de sustitución y duplicación, y puede coexistir con un indirecto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
