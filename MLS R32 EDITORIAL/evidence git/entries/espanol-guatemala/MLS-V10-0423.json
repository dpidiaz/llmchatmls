  "claims": [
    {
      "claimId": "MLS-CLM-ACD2202FB2ED44AEE1F3CFB5",
      "sectionKey": "En pocas palabras",
      "summary": "El tiempo verbal localiza una situación en relación con un punto de referencia y el aspecto presenta cómo se desarrolla o delimita esa situación.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8C8826C52BE2F43F05D4B65A",
      "sectionKey": "En pocas palabras",
      "summary": "Una forma verbal puede combinar información temporal y aspectual; el aspecto léxico se atribuye al predicado completo y depende también del contexto sintáctico.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-D8EEDF0EE5CFAFC027A7E658",
      "sectionKey": "Cómo funciona",
      "summary": "El pretérito perfecto simple sitúa un evento en el pasado y lo presenta con sus límites, mientras el imperfecto lo muestra en desarrollo o como marco pasado.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-FC04643A56201BF3E4CEB8E9",
      "sectionKey": "Cómo funciona",
      "summary": "La oposición entre llegué y leía en una subordinación temporal puede expresar un evento puntual que ocurre dentro de una situación pasada en curso.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4F0A71F97A04D09CD3FE0BDE",
      "sectionKey": "Cómo funciona",
      "summary": "El futuro compuesto habré terminado presenta la terminación como anterior a un punto futuro.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C5E4C4A48779DCB8218D7A0A",
      "sectionKey": "Ejemplos",
      "summary": "El pluscuamperfecto había cerrado sitúa el cierre antes de otro punto pasado y admite una interpretación resultativa vinculada con ese marco.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-1178E18A6BD14556CB7E3691",
      "sectionKey": "Observación importante",
      "summary": "Adverbios, complementos y contexto contribuyen a fijar la lectura temporal y aspectual de la construcción completa.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
