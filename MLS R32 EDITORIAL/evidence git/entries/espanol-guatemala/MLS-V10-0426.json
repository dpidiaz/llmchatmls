  "claims": [
    {
      "claimId": "MLS-CLM-B9111DF235DB4178B6B276BF",
      "sectionKey": "En pocas palabras",
      "summary": "El futuro simple presenta una situación posterior al momento de enunciación.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E9AE9230FD10DDA3B86C5F98",
      "sectionKey": "Cómo funciona",
      "summary": "Las formas regulares de futuro mantienen el infinitivo como base y reciben terminaciones propias; las conjugaciones documentan las formas cantaré, comerás y viviremos.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0A800C50C706250D5BA508CF",
      "sectionKey": "Cómo funciona",
      "summary": "Algunos verbos frecuentes tienen bases irregulares en el futuro, como tendré, podré, haré y vendré.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BFA44F527C9F39BCB5E2CFAB",
      "sectionKey": "Cómo funciona",
      "summary": "El futuro sintético puede expresar predicciones, promesas y compromisos, con la interpretación determinada en parte por la persona y el contexto.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E37450C11B5B8C67892C840E",
      "sectionKey": "Ejemplos",
      "summary": "El futuro sintético es común a las variedades del español para referirse a acontecimientos venideros, aunque las formas analíticas son más características y estadísticamente más frecuentes en el español americano.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-499FE7697E6BF81680FBE7C7",
      "sectionKey": "Ejemplos",
      "summary": "El presente puede aludir a hechos posteriores cuando un complemento temporal sitúa la acción en el futuro, como en mañana salgo o mañana tengo cita.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5445AAF78FEAA8AECC3A97ED",
      "sectionKey": "Observación importante",
      "summary": "La selección entre futuro sintético, ir a más infinitivo y presente prospectivo depende de las propiedades de la construcción y del contexto; el presente prospectivo normalmente requiere un complemento que ubique la situación después del habla.",
      "claimType": "general",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-960106D06F62754FDA8DC9DC",
      "sectionKey": "Observación importante",
      "summary": "El futuro sintético también tiene un valor de conjetura que puede referirse al presente, distinto de su uso temporal de posterioridad.",
      "claimType": "general",
      "materiality": "substantial"
    }
  ],
