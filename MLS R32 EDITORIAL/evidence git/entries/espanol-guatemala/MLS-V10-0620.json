  "claims": [
    {
      "claimId": "MLS-CLM-FBB14664879F9460A95FB8B3",
      "sectionKey": "En pocas palabras",
      "summary": "Parecer puede introducir una oración subordinada que expresa una proposición valorada como probable, aparente o digna de consideración, sin funcionar como cópula con atributo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-91ACA51592EF35B2FBAF58F0",
      "sectionKey": "Cómo funciona",
      "summary": "En construcciones como «Me parece que…», el pronombre átono suele representar a la persona que experimenta la impresión o valoración.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-66B05B75013C07F94DF1309E",
      "sectionKey": "Cómo funciona",
      "summary": "La subordinada introducida por que expresa el contenido de la opinión o impresión asociada al verbo parecer.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-945BE59482592E9CF22224DD",
      "sectionKey": "Cómo funciona",
      "summary": "El uso no copulativo de parecer con una oración subordinada se distingue de la construcción copulativa con atributo, como «Ana parece cansada».",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-519BB7040EEDCDB26B5ECF20",
      "sectionKey": "Observación importante",
      "summary": "Parecerse expresa semejanza en una construcción pronominal y no debe confundirse con el parecer copulativo ni con la valoración proposicional.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
