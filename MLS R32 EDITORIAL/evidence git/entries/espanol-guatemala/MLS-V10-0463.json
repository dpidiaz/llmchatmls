  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-F7F97E3B2DA05CF31F09FB72",
      "sectionKey": "En pocas palabras",
      "summary": "Los infinitivos pueden tener sujetos expresos, aunque el infinitivo carezca de flexión de persona y número.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2FACD4D1B91C837C965FDF3F",
      "sectionKey": "En pocas palabras",
      "summary": "En una oración de infinitivo no dependiente, un sujeto expreso puede aparecer junto al infinitivo, a menudo pospuesto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4556A79ECF47A25CAC314E3B",
      "sectionKey": "Cómo funciona",
      "summary": "Las subordinadas de infinitivo suelen tener sujeto tácito, pero determinados entornos aceptan un sujeto expreso.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-60FCC97B9E64E29346B139D4",
      "sectionKey": "Cómo funciona",
      "summary": "En infinitivos de construcciones no dependientes y subordinadas no argumentales se documentan sujetos expresos pospuestos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-664850BFE8B788F70454EE32",
      "sectionKey": "Cómo funciona",
      "summary": "Los infinitivos introducidos por antes y después pueden admitir sujetos expresos, con variación de frecuencia por área lingüística.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-ECB55634A357E58371DC9072",
      "sectionKey": "Cómo funciona",
      "summary": "La presencia de sujeto expreso muestra que el infinitivo puede formar una predicación con sujeto aunque no tenga flexión personal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-887FFC9287C5132404724126",
      "sectionKey": "Cómo funciona",
      "summary": "En ciertas construcciones nominales pueden aparecer sujetos expresos pospuestos del infinitivo, con restricciones sintácticas.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5822261B89E0D641BDDD6190",
      "sectionKey": "Ejemplos",
      "summary": "Después de salir Carlos y antes de llegar los invitados ejemplifican sujetos pospuestos en infinitivos bajo preposición o adverbio.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4DF1347E8753B732C1E9618A",
      "sectionKey": "Ejemplos",
      "summary": "Marta decidió salir permite interpretar un sujeto tácito del infinitivo correferente con Marta.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F664417EFE6210C298668E6D",
      "sectionKey": "Observación importante",
      "summary": "No todo grupo nominal próximo al infinitivo funciona como su sujeto; la relación se fija por la estructura.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B39D9E5AD4F8417BF0C6FBE3",
      "sectionKey": "Observación importante",
      "summary": "Los infinitivos con verbos de percepción y causación presentan propiedades particulares y no se equiparan sin más a otros sujetos expresos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
