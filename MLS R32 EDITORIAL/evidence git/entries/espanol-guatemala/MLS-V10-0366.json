      "claimId": "MLS-CLM-E646842534E0F6F84B4906A3",
      "sectionKey": "En pocas palabras",
      "summary": "Los cuantificadores de grado inciden sobre adjetivos, adverbios y procesos verbales, y ciertos cuantificadores pueden combinarse con otros modificadores de grado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C2D815B596393306A80BCF40",
      "sectionKey": "Cómo funciona",
      "summary": "Muy pocos muestra intensificación de poco; bastante alto cuantifica una propiedad; demasiado lejos modifica un adverbio; comparativos como más y menos admiten mucho más o algo menos.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-ADA6F5C907E56AEE0C28B16E",
      "sectionKey": "Observación importante",
      "summary": "La negación no implica siempre inexistencia: no mucha gente niega cantidad elevada, no equivale a nadie; combinaciones con poco y demasiado están sujetas a restricciones y al alcance de no.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
