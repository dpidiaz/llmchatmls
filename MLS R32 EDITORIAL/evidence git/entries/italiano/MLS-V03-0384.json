      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F2D46C42EB0C9D6C415C7D90",
      "sectionKey": "Cómo funciona",
      "summary": "Potrei appartiene al condizionale presente di potere e può esprimere possibilità o proposta; dovrei appartiene al condizionale di dovere e può esprimere raccomandazione, convenienza o obbligo attenuato.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-0706E907CCE08E069D2012F5",
      "sectionKey": "Observación importante",
      "summary": "Il valore pragmatico di consiglio o proposta non appartiene automaticamente alla forma verbale: dipende dalla persona, dall’infinito retto, dal contesto e dall’intonazione.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
