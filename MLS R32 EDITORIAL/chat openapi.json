    "/api/wiki/editorial/chat/status": {
      "get": {
        "operationId": "estadoMLS",
        "summary": "Consultar progreso del lote sin publicar entradas.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "runId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Identificador del lote; omitir para consultar el activo."
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado y progreso confirmado del servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    },
                    "run": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "requested": {
                          "type": "integer"
                        },
                        "selected": {
                          "type": "integer"
                        },
                        "status": {
                          "type": "string"
                        },
                        "published": {
                          "type": "integer"
                        },
                        "alreadyPublishedElsewhere": {
                          "type": "integer"
                        },
                        "remaining": {
                          "type": "integer"
                        },
                        "entries": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "position": {
                                "type": "integer"
                              },
                              "code": {
                                "type": "string"
                              },
                              "status": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    },
                    "contextId": {
                      "type": "string"
                    },
                    "context": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "editorialRules": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "valid": {
                      "type": "boolean"
                    },
                    "draftId": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "published": {
                      "type": "boolean"
                    },
                    "preservedExisting": {
                      "type": "boolean"
                    },
                    "reused": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "articleUrl": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Clave ausente o incorrecta."
          },
          "409": {
            "description": "Conflicto de lote, orden o contexto; consultar estado."
          },
          "422": {
            "description": "Borrador no válido; corregir antes de publicar."
          },
          "503": {
            "description": "Conexión editorial sin configurar."
          }
        }
