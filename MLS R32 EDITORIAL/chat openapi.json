                          "type": "string"
                        },
                        "requested": {
                          "type": "integer"
                        },
                        "selected": {
                          "type": "integer"
                        },
                        "status": {
                          "type": "string"
                        },
                        "published": {
                          "type": "integer"
                        },
                        "alreadyPublishedElsewhere": {
