{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llmchatmls",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "WIKI_DB" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "WIKI_STORE", "class_name": "WikiStore" }
    ]
  },
  "migrations": [
    { "tag": "revision-31-wiki-store", "new_sqlite_classes": ["WikiStore"] }
  ],
  "queues": {
    "producers": [
      { "binding": "WIKI_QUEUE", "queue": "mls-wiki-jobs" }
    ],
    "consumers": [
      {
        "queue": "mls-wiki-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 20,
        "max_concurrency": 25,
        "retry_delay": 120,
        "dead_letter_queue": "mls-wiki-jobs-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "upload_source_maps": true
}
