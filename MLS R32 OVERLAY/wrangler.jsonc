{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llmchatmls",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "WIKI_DB"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WIKI_STORE",
        "class_name": "WikiStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "revision-31-wiki-store",
      "new_sqlite_classes": [
        "WikiStore"
      ]
    }
  ],
  "vars": {
    "AUTOOPT_ENABLED": "true",
    "AUTOOPT_HISTORY_ENABLED": "true",
    "MLS_STAGING_GITHUB_OWNER": "dpidiaz",
    "MLS_STAGING_GITHUB_REPO": "llmchatmls",
    "MLS_STAGING_GITHUB_BRANCH": "mls-staging",
    "MLS_CANONICAL_GITHUB_BRANCH": "mls-canonical"
  },
  "upload_source_maps": true,
  "triggers": {
    "crons": []
  }
}
