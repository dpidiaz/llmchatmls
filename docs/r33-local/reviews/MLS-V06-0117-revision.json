  "claims": [
    {
      "sectionKey": "En pocas palabras",
      "summary": "The Japan Foundation’s Grammar Notes explain that 前に marks action order, attaches to a verb’s dictionary form, and contrasts with あと attaching to the た-form; they give the exact example 1日1回、寝る前に飲んでください.",
      "claimId": "MLS-CLM-FEBAC9B3D8DBAB6257F69476",
      "sourceIds": [
        "MLS-SRC-1D3620C027F26CE37757"
      ],
      "locators": [
        {
          "description": "PDF, Lección 15, punto 4, p. 112, apartado V-る前に: la nota dice que 前に se conecta a verbos en forma diccionario y あと a forma た; ejemplo 1日1回、寝る前に飲んでください."
        }
      ]
    }
  ],
