          ],
          "pages": []
        }
      ]
    },
    {
      "summary": "El condicional en discurso indirecto puede presentar una situación posterior respecto del momento pasado expresado por dijo.",
      "source_ids": [
        "MLS-SRC-4FD19E7F1FE011BD0049"
      ],
