            "25.2b"
          ],
          "pages": []
        }
      ]
    },
    {
      "summary": "Los usos desiderativos del subjuntivo pueden construirse con que o sin esa conjunción.",
      "source_ids": [
        "MLS-SRC-4FD19E7F1FE011BD0049"
      ],
      "locators": [
        {
          "url": "https://www.rae.es/gram%C3%A1tica/sintaxis/inductores-del-modo",
          "sections": [
            "25.2e"
          ],
          "pages": []
        }
      ]
    },
    {
      "summary": "Ojalá induce subjuntivo en una oración no subordinada y no admite alternancia con indicativo.",
