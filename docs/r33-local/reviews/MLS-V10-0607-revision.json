    {
      "sectionKey": "En pocas palabras",
      "summary": "El atributo es una función sintáctica que predica una propiedad, clasificación, identidad o estado del sujeto en construcciones copulativas.",
      "claimId": "MLS-CLM-E5874B592C9F9FF3A68EC63D",
      "sourceIds": [
        "MLS-SRC-5489C23D3680489CAAAE"
      ],
      "locators": [
