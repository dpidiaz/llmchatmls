    {
      "sectionKey": "En pocas palabras",
      "summary": "Los atributos aparecen en construcciones copulativas y en construcciones semicopulativas, en las que el verbo conserva parte de su significado léxico.",
      "claimId": "MLS-CLM-E4C851A57ACB55C408C314AE",
