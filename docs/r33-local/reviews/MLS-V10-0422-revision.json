    },
    {
      "summary": "El perfecto compuesto puede expresar experiencias que se evalúan sobre el intervalo de vida hasta el momento de habla.",
      "source_ids": [
        "MLS-SRC-4FD19E7F1FE011BD0049"
      ],
      "locators": [
        {
          "url": "https://www.rae.es/gram%C3%A1tica/sintaxis/el-pret%C3%A9rito-perfecto-compuesto-he-cantado-i-relevancia-actual-de-los-hechos-pret%C3%A9ritos",
