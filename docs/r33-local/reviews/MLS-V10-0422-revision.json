          ],
          "pages": []
        }
      ]
    },
    {
      "summary": "En muchas variedades el compuesto evalúa un hecho desde un intervalo que incluye el presente, mientras el simple presenta eventos pasados concluidos.",
      "source_ids": [
        "MLS-SRC-4FD19E7F1FE011BD0049"
      ],
      "locators": [
        {
