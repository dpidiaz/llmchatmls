    {
      "summary": "El imperfecto puede expresar una serie habitual de acciones dentro de un intervalo pasado, incluso con expresiones como de niño.",
      "source_ids": [
        "MLS-SRC-4FD19E7F1FE011BD0049"
      ],
      "locators": [
        {
