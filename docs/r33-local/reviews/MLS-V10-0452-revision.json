  "claims": [
    {
      "sectionKey": "En pocas palabras",
      "summary": "Indicativo, subjuntivo e imperativo son modos del español y la selección del modo depende de la sintaxis, el significado de los predicados y la perspectiva discursiva.",
      "claimId": "MLS-CLM-3FFE096176210528E21CCE92",
      "sourceIds": [
        "MLS-SRC-4FD19E7F1FE011BD0049"
      ],
      "locators": [
        {
          "sections": [
            "25.1",
            "25.2"
          ]
        }
      ]
    },
    {
      "sectionKey": "En pocas palabras",
      "summary": "El subjuntivo no se limita a duda o irrealidad y aparece en contextos de hechos conocidos, voluntad, valoración, finalidad, negación, futuro y antecedentes no identificados.",
      "claimId": "MLS-CLM-E50814ABE23DE94953752938",
      "sourceIds": [
        "MLS-SRC-4FD19E7F1FE011BD0049"
      ],
      "locators": [
