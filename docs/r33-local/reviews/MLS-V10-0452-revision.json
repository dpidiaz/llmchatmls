            "25.14"
          ]
        }
      ]
    },
    {
      "sectionKey": "Indicativo",
      "summary": "El indicativo aparece frecuentemente bajo predicados de conocimiento, aserción o presentación de contenido como información asumida.",
      "claimId": "MLS-CLM-A918E288836D9655B045D88D",
      "sourceIds": [
        "MLS-SRC-4FD19E7F1FE011BD0049"
      ],
      "locators": [
        {
          "sections": [
            "25.3"
          ]
        }
      ]
    },
    {
      "sectionKey": "Indicativo",
      "summary": "El indicativo también puede expresar probabilidad y no implica certeza absoluta.",
      "claimId": "MLS-CLM-FF6BAF197E3EAA53551FF4C9",
      "sourceIds": [
        "MLS-SRC-4FD19E7F1FE011BD0049"
      ],
      "locators": [
        {
          "sections": [
            "25.2"
          ]
        }
      ]
    },
    {
      "sectionKey": "Subjuntivo",
      "summary": "Los predicados de voluntad, influencia, valoración, posibilidad y finalidad suelen inducir subjuntivo en sus complementos.",
      "claimId": "MLS-CLM-47F2C79A9C68FE009FF501E0",
      "sourceIds": [
        "MLS-SRC-4FD19E7F1FE011BD0049"
      ],
      "locators": [
        {
          "sections": [
            "25.3",
            "25.14"
          ]
        }
      ]
    },
    {
      "sectionKey": "Subjuntivo",
      "summary": "El subjuntivo puede aparecer en una subordinada cuyo contenido se presupone verdadero, por ejemplo con predicados de afección.",
      "claimId": "MLS-CLM-73B29B8DB4B241B7A376AF8E",
      "sourceIds": [
        "MLS-SRC-4FD19E7F1FE011BD0049"
      ],
