            "23.15c"
          ],
          "pages": []
        }
      ]
    },
    {
      "summary": "El condicional puede interpretarse como posterior respecto de un punto pasado, aunque esa relación temporal no determina su relación con el momento actual.",
      "source_ids": [
        "MLS-SRC-4FD19E7F1FE011BD0049"
      ],
      "locators": [
        {
