        "title": "El relativo quien y el interrogativo-exclamativo quién",
        "level": "G2",
        "part": "Relativos, interrogativos y exclamativos / Relatives, interrogatives, and exclamatives",
        "chapter": "Relativos, interrogativos y exclamativos / Relatives, interrogatives, and exclamatives"
      },
      "evidenceVersion": "1.0",
      "evidenceRevision": 2,
      "status": "VERIFIED",
      "claims": [
        {
          "claimId": "MLS-CLM-8EDFA8195C72E2F55909EEAC",
          "sectionKey": "En pocas palabras",
          "summary": "El relativo quien/quienes tiene típicamente referente humano y se emplea sin tilde, mientras quién/quiénes introduce una variable personal en interrogativas o exclamativas, directas e indirectas.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-D4D47912DE2A676C006BE55B",
          "sectionKey": "Cómo funciona",
          "summary": "Quien puede aparecer con antecedente de persona y tras preposición o encabezar una relativa libre sin antecedente nominal expreso; quién interroga por la identidad de alguien y mantiene la tilde en la pregunta indirecta.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-A3BED70038F75B6D1018D387",
          "sectionKey": "Observación importante",
          "summary": "La preposición de la relación sintáctica debe mantenerse (con quien hablé); la tilde de quién indica el uso interrogativo-exclamativo habitual, pero no debe deducirse sin análisis que toda secuencia tónica con quién sea necesariamente una interrogativa.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
