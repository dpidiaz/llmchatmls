      "claims": [
        {
          "claimId": "MLS-CLM-74103A59AF7A9386CF071640",
          "sectionKey": "En pocas palabras",
          "summary": "Relativos, interrogativos y exclamativos comparten formas pronominales, determinativas o adverbiales, pero los interrogativos introducen incógnitas y los exclamativos expresan valoración o intensidad.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-DF6918B15B70A8DF405C983B",
          "sectionKey": "Cómo funciona",
          "summary": "Los interrogativos pueden constituir grupos solos o con sustantivos y preposiciones y también encabezar preguntas indirectas con tilde; las expresiones exclamativas incluyen usos valorativos o cuantificativos de qué, cuánto y cómo.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-C9138411AFCA20E361A4335A",
          "sectionKey": "Observación importante",
          "summary": "La distinción entre relativo e interrogativo-exclamativo exige atender tanto al antecedente o variable como a la tonicidad y a la función sintáctica: quien y quién no son intercambiables.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
