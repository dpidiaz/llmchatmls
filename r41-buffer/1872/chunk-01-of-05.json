        "language": "espanol-guatemala",
        "languageName": "Español de Guatemala",
        "title": "Clases de cuantificadores en función de su categoría gramatical",
        "level": "G1",
        "part": "Cuantificación y numerales / Quantification and numerals",
        "chapter": "Cuantificación y cuantificadores / Quantification and quantifiers"
      },
      "evidenceVersion": "1.0",
      "evidenceRevision": 2,
      "status": "VERIFIED",
      "claims": [
        {
          "claimId": "MLS-CLM-56A30D8943566F50918A6F9A",
          "sectionKey": "En pocas palabras",
          "summary": "Los cuantificadores constituyen una clase transversal: según su construcción, pueden tener uso adjetival o determinativo, pronominal y adverbial.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-551AA4F280953760CF7256F2",
          "sectionKey": "Cómo funciona",
          "summary": "En muchos libros, muchos modifica el nombre; Muchos llegaron admite análisis pronominal o nominal con núcleo tácito; trabaja mucho muestra el uso adverbial invariable.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-79754F7C284DDBF3BDB72924",
          "sectionKey": "Observación importante",
          "summary": "La clasificación depende de la función sintáctica concreta; una forma como mucho puede alternar entre usos con flexión nominal y usos adverbiales, y existen análisis gramaticales alternativos.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
      "links": [
