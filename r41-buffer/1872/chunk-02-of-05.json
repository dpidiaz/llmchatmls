      "claims": [
        {
          "claimId": "MLS-CLM-29F6D1BC609B5B141340404F",
          "sectionKey": "En pocas palabras",
          "summary": "La construcción partitiva selecciona una porción de un conjunto delimitado: el cuantificador expresa la parte y el complemento con de aporta el dominio de referencia definido.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-75140F6DB3A8F1F36A3DB224",
          "sectionKey": "Cómo funciona",
          "summary": "Las partitivas admiten cardinales e indefinidos con complemento definido o pronominal (tres de los libros; algunos de ellos), así como expresiones fraccionarias (la mitad de los estudiantes).",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-863402BE7F68CA44742B1D9D",
          "sectionKey": "Observación importante",
          "summary": "Tres libros cuantifica sin presuponer un conjunto definido; tres de los libros selecciona dentro de uno, y una pseudopartitiva como un centenar de libros no tiene la misma relación con el dominio.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
