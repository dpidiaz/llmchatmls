      "claims": [
        {
          "claimId": "MLS-CLM-E5588F4C5CB4EE8308B2885B",
          "sectionKey": "En pocas palabras",
          "summary": "Mucho, poco, bastante y demasiado son cuantificadores evaluativos, pues cuantifican en relación con una expectativa, norma o finalidad contextual; contrastan con los cardinales de cómputo exacto.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-FE1C76E6E8543A1A4D5A45A8",
          "sectionKey": "Cómo funciona",
          "summary": "Mucho y poco sitúan la cantidad sobre o bajo una expectativa; bastante alterna entre suficiente y apreciable y demasiado indica exceso, con flexión nominal cuando procede.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-3F026CEDC1B77D4F55771956",
          "sectionKey": "Observación importante",
          "summary": "La valoración cuantitativa depende de las circunstancias y no fija una cantidad absoluta: una magnitud puede resultar mucha o poca según la situación.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
