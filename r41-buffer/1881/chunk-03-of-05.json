      "claims": [
        {
          "claimId": "MLS-CLM-FC4087C849F457C43FDB144D",
          "sectionKey": "En pocas palabras",
          "summary": "El condicional simple cantaría organiza posteridad respecto de un punto pretérito, a diferencia del imperfecto cantaba, que puede presentar pasado habitual o de trasfondo.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-9D80A6047B38F74BCFF1C5A4",
          "sectionKey": "Cómo funciona",
          "summary": "En construcciones con plan previo, el imperfecto de indicativo (dijo que venía) puede referirse prospectivamente desde un momento pasado; el condicional (dijo que vendría) marca la posterioridad relativa.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-02D24078592CE25B356F8F82",
          "sectionKey": "Observación importante",
          "summary": "El imperfecto de cortesía y el condicional pueden mitigar peticiones, pero no existe sustitución indiscriminada entre ambas formas; usos hipotéticos del imperfecto pueden depender de variedad y registro.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
