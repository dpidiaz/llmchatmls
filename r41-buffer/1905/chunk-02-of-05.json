          "sectionKey": "Antecedentes no identificados",
          "summary": "Los predicados prospectivos como buscar, necesitar y desear inducen lecturas inespecíficas del antecedente y relativas con subjuntivo.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-6B4580287BD9902D0BFF08AC",
          "sectionKey": "Negación e inexistencia",
          "summary": "La negación, los cuantificadores negativos y la proyección modal intervienen en la inducción del subjuntivo de relativas junto con la interpretación referencial.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
