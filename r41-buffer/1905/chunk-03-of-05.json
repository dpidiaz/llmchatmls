      "claims": [
        {
          "claimId": "MLS-CLM-3E87735C9DFBB0795CA2613D",
          "sectionKey": "En pocas palabras",
          "summary": "La lexicalización nominal permite usar ciertos infinitivos como sustantivos con significado convencional.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-2349FFCD89C5BCF1357020FB",
          "sectionKey": "Cómo funciona",
          "summary": "Deber, saber y cantar pueden admitir plural, determinantes y adjetivos cuando actúan como nombres, a diferencia del infinitivo verbal.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-5DA46500A6C461252CD9C861",
          "sectionKey": "Observación importante",
          "summary": "El artículo el por sí solo no demuestra lexicalización: deben examinarse la estructura verbal o nominal, la modificación y el significado.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
