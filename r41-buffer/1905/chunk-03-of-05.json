      "claims": [
        {
          "claimId": "MLS-CLM-FAA0A264CEFEB7C41704A9BE",
          "sectionKey": "En pocas palabras",
          "summary": "Los infinitivos pueden tener sujetos no pronunciados cuya referencia se reconstruye por la sintaxis y el contexto.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-127B75B8C8B4061B73C50649",
          "sectionKey": "Cómo funciona",
          "summary": "El sujeto del infinitivo puede estar controlado por un argumento de la oración principal o recibir interpretación genérica.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-273B72D2953F80A608838AC4",
          "sectionKey": "Observación importante",
          "summary": "Sujeto tácito no equivale a ausencia de predicación: deben distinguirse control por sujeto, control por complemento y referencia genérica.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
      "links": [
        {
