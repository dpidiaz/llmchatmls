        "level": "G2",
        "part": "Formas no personales y perífrasis / Non-finite forms and periphrases",
        "chapter": "El gerundio / The gerund"
      },
      "evidenceVersion": "1.0",
      "evidenceRevision": 1,
      "status": "SOURCED",
      "claims": [
        {
          "claimId": "MLS-CLM-A6503F9C5704DAE2546525FD",
          "sectionKey": "En pocas palabras",
          "summary": "El gerundio predicativo forma una predicación secundaria atribuida a un participante de la oración mientras se desarrolla la eventualidad del verbo principal.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-7B8928349D274765A0495C9D",
          "sectionKey": "Cómo funciona",
          "summary": "Con verbos perceptivos puede predicarse del objeto («Vi a Ana cruzando»); también del sujeto («Marta llegó llorando»), con solapamiento temporal y posibles matices de manera.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-DE75B5558777FFB0B8821D67",
          "sectionKey": "Observación importante",
          "summary": "«Vi a Ana cruzando» mantiene ver como predicado de percepción, frente a «Ana está cruzando», donde estar + gerundio constituye una perífrasis; la predicación puede expresar actividad y no solo estado.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
