        "level": "G2",
        "part": "Formas no personales y perífrasis / Non-finite forms and periphrases",
        "chapter": "El infinitivo / The infinitive"
      },
      "evidenceVersion": "1.0",
      "evidenceRevision": 1,
      "status": "SOURCED",
      "claims": [
        {
          "claimId": "MLS-CLM-9955A654A98E541A117A6F86",
          "sectionKey": "En pocas palabras",
          "summary": "El infinitivo puede constituir un enunciado sin verbo finito principal; su valor ilocutivo se establece por patrón y contexto.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-0747E16FA1E96238D5089756",
          "sectionKey": "Cómo funciona",
          "summary": "«¡A comer!» es exhortativo, «No fumar» funciona como aviso, «mezclar los ingredientes» es posible en instrucciones, y «¡Haberlo sabido antes!» aporta una reacción retrospectiva.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-222D1F76E15F1F5CBEF40C26",
          "sectionKey": "Observación importante",
          "summary": "La independencia sintáctica no convierte al infinitivo en imperativo morfológico ni garantiza un único sentido para todos sus usos autónomos.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
      "links": [
        {
          "linkId": "MLS-LNK-2252A15F9895E4317B3113D5",
          "claimId": "MLS-CLM-9955A654A98E541A117A6F86",
          "sourceId": "MLS-SRC-4FD19E7F1FE011BD0049",
          "supportType": "supports",
