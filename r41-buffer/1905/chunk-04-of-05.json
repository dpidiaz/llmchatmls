      "claims": [
        {
          "claimId": "MLS-CLM-80D8D8289C1A31E58262A7D2",
          "sectionKey": "En pocas palabras",
          "summary": "Preposiciones y locuciones pueden introducir grupos de infinitivo y relacionarlos con el resto de la oración, sin que el infinitivo por sí solo codifique finalidad, tiempo o ausencia.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-D00F0FDFFFD6997C9BEBEAFE",
          "sectionKey": "Cómo funciona",
          "summary": "Para comprar suele aportar finalidad, sin despedirse expresa una eventualidad excluida, al llegar admite lectura temporal y verbos como insistir seleccionan régimen en + infinitivo.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-9A8275771B79BCCB7FE81406",
          "sectionKey": "Observación importante",
          "summary": "La preposición puede depender de la construcción o del núcleo rector: sin estudiar no tiene la misma estructura que sin que estudie.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
