      "claims": [
        {
          "claimId": "MLS-CLM-C67AAEAB1D479011E0483F56",
          "sectionKey": "En pocas palabras",
          "summary": "Una copulativa enfática condicional combina una prótasis introducida por si con una construcción identificativa de ser y un foco.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-4687F2E83F18CC61EA13D805",
          "sectionKey": "Cómo funciona",
          "summary": "Si alguien llamó, fue Ana presenta una alternativa abierta en la prótasis y la identifica en el segmento copulativo; difiere estructuralmente de Quien llamó fue Ana.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-B528492434CD23ADEB2B6631",
          "sectionKey": "Ejemplos",
          "summary": "Si algo necesito, es descanso focaliza descanso; Si en algún lugar quiero vivir, es en Antigua focaliza un constituyente locativo.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-00B244F8BBF7D3A57FF3A7FF",
          "sectionKey": "Observación importante",
          "summary": "Lo que necesito es descanso es pseudohendida de relativo, no copulativa condicional, porque no contiene la prótasis introducida por si.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
