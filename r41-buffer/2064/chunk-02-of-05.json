      "claims": [
        {
          "claimId": "MLS-CLM-6EB6997DA239DCFF7BE69F36",
          "sectionKey": "En pocas palabras",
          "summary": "Las copulativas enfáticas de relativo organizan ser, un constituyente focalizado y una estructura relativa para identificar o destacar una alternativa.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-CD45023F987EC7D7324FC033",
          "sectionKey": "Cómo funciona",
          "summary": "Fue Ana quien llamó ejemplifica la hendida; Quien llamó fue Ana ejemplifica la pseudohendida; Ana fue quien llamó presenta otro orden y las etiquetas varían entre gramáticas.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-D351B02F7D30C78F9BF80617",
          "sectionKey": "Ejemplos",
          "summary": "Fue ayer cuando llegó y Fue en Antigua donde se reunieron focalizan respectivamente una expresión temporal y una locativa mediante relativos congruentes.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-95B1ABACA34E959B455FB359",
          "sectionKey": "Observación importante",
          "summary": "La directora es Ana y Lo importante es esto no constituyen por sí solas copulativas enfáticas de relativo porque carecen de relativa característica.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
