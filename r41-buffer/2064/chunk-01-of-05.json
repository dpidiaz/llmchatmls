          "claimId": "MLS-CLM-8988281906835ADC1DD8C332",
          "sectionKey": "En pocas palabras",
          "summary": "No compré el libro ayer admite focos negativos distintos según contexto y prominencia, sin negar necesariamente cada alternativa por separado.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-EC1B50D451410B18EB9CA209",
          "sectionKey": "Cómo funciona",
          "summary": "Las correctivas con sino delimitan el elemento rechazado; el alcance del operador negativo y el foco informativo son conceptos relacionados pero distintos.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-AD88EEB4108E6810277D90DD",
          "sectionKey": "Ejemplos",
          "summary": "No compré el libro, sino la revista y No fui ayer, sino hoy expresan focos correctivos nominal y temporal respectivamente.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-8F864A48C663A734A9A7ACC8",
          "sectionKey": "Observación importante",
          "summary": "No vino nadie ejemplifica concordancia negativa; el español no interpreta no y nadie como cancelación automática de dos negaciones.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
