      "claims": [
        {
          "claimId": "MLS-CLM-AF19D5C5D322E28C4EF2F2EC",
          "sectionKey": "En pocas palabras",
          "summary": "Los adverbios de foco destacan una expresión respecto de alternativas contextuales; su valor depende del alcance.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-3E1E1840ED58471EF23B4627",
          "sectionKey": "Cómo funciona",
          "summary": "Solo excluye alternativas; también y tampoco son aditivos; incluso y ni siquiera expresan escala; precisamente particulariza.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-3D3A1D11ACEAE56B4E2C3545",
          "sectionKey": "Ejemplos",
          "summary": "Solo Marta llamó, Marta también llamó e Incluso Marta llamó contrastan exclusión, adición y escala con idéntico sujeto superficial.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-FE54EAAD64A988DC07D096A9",
          "sectionKey": "Observación importante",
          "summary": "La posición, entonación y contexto delimitan el foco; una construcción temática como Ese libro, ya lo leí no ejemplifica adverbio de foco.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
