      "claims": [
        {
          "claimId": "MLS-CLM-400C1C71328010F2FC5CA1C8",
          "sectionKey": "En pocas palabras",
          "summary": "El participio es una forma no personal que puede perfilar una situación concluida o un estado resultante; no codifica por sí solo una fecha absoluta.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-2E98A2B025E9B8578DA98AC8",
          "sectionKey": "Cómo funciona",
          "summary": "Con haber integra tiempos compuestos y permanece invariable; en pasivas con ser y usos predicativos con estar presenta otras relaciones de concordancia y de aspecto.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-3A0C3032974C9DEC7A286593",
          "sectionKey": "Observación importante",
          "summary": "La anterioridad se interpreta respecto del tiempo del auxiliar o de otro punto de referencia, por lo que no debe equipararse automáticamente participio con pretérito simple.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
