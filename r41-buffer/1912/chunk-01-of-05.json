      "claims": [
        {
          "claimId": "MLS-CLM-8FD6DF6FB63C2C3F2DD213F1",
          "sectionKey": "En pocas palabras",
          "summary": "Para distinguir un participio verbal de un adjetivo es necesario atender a la construcción, y no únicamente al parecido de su forma externa.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-68B196D42EE6A659B06A9548",
          "sectionKey": "Cómo funciona",
          "summary": "Haber selecciona un participio invariable en los tiempos compuestos, mientras las pasivas con ser pueden mostrar concordancia y conservar complementos verbales, incluido un agente.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-3775821D57DE5A7AFBBCDE7F",
          "sectionKey": "Observación importante",
          "summary": "Ni la concordancia ni la combinación con intensificadores sirven como prueba absoluta; los complementos, la interpretación y el grado de lexicalización ofrecen diagnósticos complementarios.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
      "links": [
