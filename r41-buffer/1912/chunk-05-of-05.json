      "claims": [
        {
          "claimId": "MLS-CLM-6E84FEF139C80C93D08140C8",
          "sectionKey": "En pocas palabras",
          "summary": "Las locuciones preposicionales son secuencias de varias palabras de cierta fijación que introducen un término y expresan una relación preposicional.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-17EA317565BA5ED17FD74ED8",
          "sectionKey": "Cómo funciona",
          "summary": "Entre sus pautas de formación figuran las secuencias de base adverbial seguida de de y las estructuras con sustantivo precedido de preposición, como delante de, a causa de o de acuerdo con.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-A7DD820EB95511EB4216D67D",
          "sectionKey": "Observación importante",
          "summary": "La mera contigüidad de varias palabras no basta para identificar una locución: deben atenderse la fijación y el análisis de su estructura.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
