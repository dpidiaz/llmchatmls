      "claims": [
        {
          "claimId": "MLS-CLM-496D4C92162EA7E21FCF1AC0",
          "sectionKey": "En pocas palabras",
          "summary": "La posición del sujeto puede alternar sin cambiar su función sintáctica ni constituir una alternancia de diátesis.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-58E187748995A9418EEF616B",
          "sectionKey": "Cómo funciona",
          "summary": "En Marta llegó y Llegó Marta el grupo nominal sigue siendo sujeto; la expresión u omisión del pronombre y el orden pueden responder a la estructura informativa, con concordancia verbal estable.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-752FD5D08E75273D01A99E2D",
          "sectionKey": "Observación importante",
          "summary": "Los cambios activo-pasivo sí reorganizan las funciones sintácticas, a diferencia de la simple anteposición o posposición del sujeto; Llegaron tres estudiantes ejemplifica un sujeto pospuesto.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
