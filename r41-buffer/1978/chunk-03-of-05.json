      "claims": [
        {
          "claimId": "MLS-CLM-2FDAAF66404604C89D77CD4D",
          "sectionKey": "En pocas palabras",
          "summary": "Las interjecciones presentan rasgos fónicos expresivos: la entonación, la intensidad y la duración contribuyen a matizar su interpretación.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-0245783CAE9EAA59D4A946B6",
          "sectionKey": "Cómo funciona",
          "summary": "La escritura de las interjecciones combina signos exclamativos, grafías convencionales y, en usos expresivos, repetición o alargamiento de letras.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-84BBDE7B5DA0E413BE1EE5D2",
          "sectionKey": "Observación importante",
          "summary": "Los recursos gráficos representan solo parcialmente los matices prosódicos y las onomatopeyas poseen una representación convencional del sonido.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
