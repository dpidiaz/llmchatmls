          "claimId": "MLS-CLM-F60407F4AFB21104B39AB65D",
          "sectionKey": "En pocas palabras",
          "summary": "Las interjecciones formularias participan en actos sociales convencionalizados, como saludar, despedirse, agradecer o formular expresiones de cortesía.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-D0D9FE7D1A119DE40E5C1994",
          "sectionKey": "Cómo funciona",
          "summary": "Expresiones como hola, adiós y buenas pueden constituir intervenciones convencionales autónomas, identificables por su función social.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-CDE046CB94FCADC123E7559D",
          "sectionKey": "Observación importante",
          "summary": "La clasificación formularia depende del uso pragmático en el intercambio y puede variar según registro y situación, no solo según el origen léxico de la forma.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
