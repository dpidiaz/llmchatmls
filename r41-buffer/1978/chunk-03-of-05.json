      "claims": [
        {
          "claimId": "MLS-CLM-BE7CA180D8229B00A60EE9EA",
          "sectionKey": "En pocas palabras",
          "summary": "Según su valor comunicativo se distinguen interjecciones expresivas, apelativas y formularias, sin equiparar dicha clasificación con su origen gramatical.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-730134CE274A8C17D7B0C5B0",
          "sectionKey": "Cómo funciona",
          "summary": "Las expresivas reflejan una reacción del hablante; las apelativas se dirigen a un interlocutor; las fórmulas convencionales intervienen en actos sociales como el saludo.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-BC61F7070F88FFDC03F715A0",
          "sectionKey": "Observación importante",
          "summary": "El valor de la interjección depende del contexto y de la entonación; los usos comunicativos de una misma forma no siempre son unívocos.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
