        "title": "El concepto de complemento indirecto",
        "level": "G1",
        "part": "Sujeto y objetos / Subject and objects",
        "chapter": "El complemento indirecto / The indirect object"
      },
      "evidenceVersion": "1.0",
      "evidenceRevision": 1,
      "status": "SOURCED",
      "claims": [
        {
          "claimId": "MLS-CLM-DD83143B68C84A449F85161C",
          "sectionKey": "En pocas palabras",
          "summary": "El complemento indirecto es función sintáctica expresada por pronombres dativos o sintagmas con a sustituibles por dativos; su significado no se restringe al receptor.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-5B9A8CA4F64144C7F2A2B082",
          "sectionKey": "Cómo funciona",
          "summary": "Los clíticos le/les permiten reconocer el dativo; el uso de a por sí solo no distingue el complemento indirecto del directo marcado con a personal.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-CF924DB92DD67921B35B3377",
          "sectionKey": "Función y significado",
          "summary": "Receptor, destinatario, experimentante y beneficiario son papeles semánticos posibles, no definiciones equivalentes a la función sintáctica de complemento indirecto.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-19AD8E1BC40CACDFA2B516DF",
          "sectionKey": "Observación importante",
          "summary": "Los sintagmas con para que expresan destino o beneficio no son automáticamente complementos indirectos porque no admiten sustitución por dativos.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
