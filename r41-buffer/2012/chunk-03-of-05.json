      "claims": [
        {
          "claimId": "MLS-CLM-3313156D4B3C30AA2642DA0A",
          "sectionKey": "En pocas palabras",
          "summary": "Los usos absolutos de verbos transitivos omiten el objeto cuando el discurso no necesita identificarlo.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-5D141F474C5C52D6D62341CC",
          "sectionKey": "Cómo funciona",
          "summary": "La omisión puede recuperar un objeto ya mencionado, como en Sí, ya terminé tras la pregunta sobre el informe.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-F126CF8C75A7BBA1C7EBF935",
          "sectionKey": "Contexto y recuperación",
          "summary": "La omisión contextual con referente específico se distingue del uso genérico o inespecífico de Marta lee mucho.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-B7CF1DB81BD89D14ED40790F",
          "sectionKey": "Observación importante",
          "summary": "La construcción Vi a María no es absoluta porque expresa el objeto; la omisión depende de cada verbo y contexto.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
