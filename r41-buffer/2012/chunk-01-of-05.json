          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-C8942E9FF5891D4352A6BDCD",
          "sectionKey": "Cómo funciona",
          "summary": "La a personal puede introducir un complemento directo humano, como a Marta en Vi a Marta; su presencia no convierte el objeto en indirecto.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-510CCDF78B97EF186DCF9321",
          "sectionKey": "Cómo funciona",
          "summary": "El complemento directo admite diversos papeles semánticos: entidad afectada, creada, percibida, conocida o contenido comunicado.",
