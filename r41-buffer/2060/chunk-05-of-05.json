      "claims": [
        {
          "claimId": "MLS-CLM-8AC0564C35FBDFFEF9500019",
          "sectionKey": "En pocas palabras",
          "summary": "El foco no constituye una categoría gramatical autónoma: sujeto, objeto, adjunto, verbo o proposición pueden realizar una función focal sin perder su función sintáctica.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-8428A7D491522F6DC7F2AB00",
          "sectionKey": "Cómo funciona",
          "summary": "La focalización española puede marcarse por prominencia in situ, posición posverbal, anteposición contrastiva y construcciones hendidas; tópicos con clítico y focos antepuestos no son equivalentes.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-A52E8692F5FBC307BBBDE099",
          "sectionKey": "Observación importante",
          "summary": "No hay posición fija del foco y su movilidad está condicionada por estructura, prosodia y contexto; la focalización no sustituye el análisis de sujeto, objeto o adjunto.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
