          "claimId": "MLS-CLM-7DFC9EA9512454DE6CA8CC87",
          "sectionKey": "En pocas palabras",
          "summary": "El rema aporta la predicación respecto al tema, mientras el foco es el componente destacado para identificar, seleccionar o contrastar alternativas; no son nociones sinónimas.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-77D09028A5D765D18E315E2D",
          "sectionKey": "Cómo funciona",
          "summary": "Un foco puede ser estrecho sobre sujeto u objeto, o amplio sobre la proposición; la pregunta previa, la entonación y el orden ayudan a delimitarlo, y también hay focos contrastivos.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-8516FE284EA57353B0BED85B",
          "sectionKey": "Observación importante",
          "summary": "El foco puede coincidir con una porción del rema o abarcar la oración; no todo contenido nuevo es foco ni todo foco requiere referente desconocido.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
