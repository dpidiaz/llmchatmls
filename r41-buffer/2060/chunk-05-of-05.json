      "claims": [
        {
          "claimId": "MLS-CLM-002420A793A6A61A7CD6E715",
          "sectionKey": "En pocas palabras",
          "summary": "El tema establece el punto de partida del enunciado y el rema desarrolla la predicación sobre ese marco; ambos son funciones informativas distintas de sujeto y predicado.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-9AE70E294AE58A36641F58AC",
          "sectionKey": "Cómo funciona",
          "summary": "La accesibilidad contextual del tema no exige mención previa, y las distinciones tema/rema y dado/nuevo no coinciden de forma automática; un sujeto también puede ser focal.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-1E6BFC48DE5611F85774E861",
          "sectionKey": "Observación importante",
          "summary": "La organización temática y remática no se identifica mecánicamente con sujeto/predicado ni con información dada/nueva; el contexto, el orden y la prosodia intervienen en el análisis.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
