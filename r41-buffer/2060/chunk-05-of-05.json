      "claims": [
        {
          "claimId": "MLS-CLM-3F16ABA2A6017E422499FF94",
          "sectionKey": "En pocas palabras",
          "summary": "El tópico puede aparecer en posición periférica inicial o final, pero su identificación también depende de la prosodia, el contexto y los vínculos sintácticos; la posición inicial no basta.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-15B18193913FC6B35CE2D61C",
          "sectionKey": "Cómo funciona",
          "summary": "La dislocación izquierda de un objeto puede acompañarse de clítico resumptivo, y la derecha puede recuperar un referente; los tópicos de marco y los temas vinculantes tienen otras relaciones con la oración.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-912B01B62A05B8A0287B2F9F",
          "sectionKey": "Observación importante",
          "summary": "No toda anteposición corresponde a tópico: un foco contrastivo antepuesto se distingue del tópico mediante el contexto, la entonación y sus relaciones sintácticas.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
