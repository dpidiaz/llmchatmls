      "claims": [
        {
          "claimId": "MLS-CLM-96584E4B5B233265B7B5C9E2",
          "sectionKey": "En pocas palabras",
          "summary": "Los tópicos pueden relacionarse con la oración mediante un vínculo sintáctico, como la retomación pronominal de un complemento, o por coherencia discursiva sin ocupar un argumento interno.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-16CB514CEE6958832CE1F4E7",
          "sectionKey": "Cómo funciona",
          "summary": "La dislocación de objeto directo o indirecto puede retomarse con clítico, mientras los marcos espaciales o temporales y los temas vinculantes se conectan discursivamente con la predicación.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-2EEDB91EDE1E911E66B4124B",
          "sectionKey": "Observación importante",
          "summary": "No todos los tópicos tienen idéntico estatuto sintáctico: la dislocación con clítico presenta correspondencia estructural, pero los marcos y temas colgantes se explican principalmente en el discurso.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
      "links": [
        {
          "linkId": "MLS-LNK-670E4818BF68D4DC0DC278B4",
