      "claims": [
        {
          "claimId": "MLS-CLM-11E484D529E8EA4734BCDF97",
          "sectionKey": "En pocas palabras",
          "summary": "Los adverbios temáticos o de tópico delimitan el ámbito de interpretación de una proposición, como económicamente o lingüísticamente; no expresan necesariamente la manera de actuar.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-AB4EC425812F3CBAAEA8D017",
          "sectionKey": "Cómo funciona",
          "summary": "Los adverbios temáticos suelen ser periféricos y no seleccionados por el verbo; una forma en -mente puede tener lectura temática o modal según su contexto y posición y se distingue de adverbios de la enunciación.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-0CB0ECFDBCB22F12E7CDE953",
          "sectionKey": "Observación importante",
          "summary": "La posición inicial o el sufijo -mente no bastan por sí solos para clasificar un adverbio como temático; temprano en llegó muy temprano tiene lectura temporal, no tópica.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
