        "title": "Definición y clases de conjunciones",
        "level": "G1",
        "part": "Preposiciones, adverbios, conjunciones e interjecciones / Prepositions, adverbs, conjunctions, and interjections",
        "chapter": "Conjunciones y coordinación / Conjunctions and coordination"
      },
      "evidenceVersion": "1.0",
      "evidenceRevision": 1,
      "status": "SOURCED",
      "claims": [
        {
          "claimId": "MLS-CLM-B0697C10BAE59EF4217D6818",
          "sectionKey": "En pocas palabras",
          "summary": "La conjunción es una categoría invariable que relaciona unidades sintácticas; se distingue entre coordinación y subordinación.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-E7A5C9D9481142A3C8BF87BA",
          "sectionKey": "Cómo funciona",
          "summary": "Las coordinantes vinculan miembros equiparables, mientras las subordinantes introducen estructuras dependientes, incluidas ciertas locuciones conjuntivas.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-5DB7F1E8290906780653B26F",
          "sectionKey": "Observación importante",
          "summary": "Una definición de conjunción debe expresar el tipo de vínculo sintáctico y no reducirse a la unión inespecífica de ideas.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
