      "claims": [
        {
          "claimId": "MLS-CLM-A11A75D291C766DE4C4E8CEB",
          "sectionKey": "En pocas palabras",
          "summary": "Las conjunciones coordinantes enlazan miembros de rango sintáctico comparable y presentan clases copulativas, disyuntivas y adversativas.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-2BC641BB23734FC8C7F14D19",
          "sectionKey": "Cómo funciona",
          "summary": "Y/e y ni pertenecen al ámbito copulativo; o/u al disyuntivo; pero introduce contraste adversativo; sin embargo funciona como conector adverbial.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-F2F646680A8CD05C6187A969",
          "sectionKey": "Observación importante",
          "summary": "Los segmentos coordinados pueden variar en extensión, y no todos los conectores de adición o contraste son conjunciones.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
