      "claims": [
        {
          "claimId": "MLS-CLM-F27F80AA6F2AE9BB9CC28301",
          "sectionKey": "En pocas palabras",
          "summary": "La función de adjunto puede expresarse mediante diferentes categorías, como adverbios, grupos preposicionales, nominales y construcciones oracionales.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-D87090E0D2C517A3D0F98A57",
          "sectionKey": "Cómo funciona",
          "summary": "Categoría morfosintáctica y función sintáctica son niveles distintos; un grupo preposicional también puede realizar régimen o complemento de adjetivo según la selección.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-78329B159B70DE048E261BC2",
          "sectionKey": "Ejemplos",
          "summary": "«Ayer», «por la mañana», «toda la mañana» y «cuando terminó la lluvia» pueden aportar circunstancias temporales mediante categorías diferentes.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-B28ABBC66095F4CB5826E752",
          "sectionKey": "Observación importante",
          "summary": "No existe una única categoría gramatical equivalente a adjunto; la forma externa no determina automáticamente su función en el enunciado.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
