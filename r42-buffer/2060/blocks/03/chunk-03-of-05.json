      "evidenceRevision": 1,
      "status": "SOURCED",
      "claims": [
        {
          "claimId": "MLS-CLM-17590F4C8914D2B4586556A6",
          "sectionKey": "En pocas palabras",
          "summary": "Los adjuntos se distinguen de atributos, predicativos, complementos de régimen, complementos nominales y conectores por su incidencia y selección sintáctica.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-F81C1931DCC74434C333649F",
          "sectionKey": "Cómo funciona",
          "summary": "Un atributo o predicativo asigna una propiedad a un participante; un adjunto de manera caracteriza el evento y no presenta concordancia nominal.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-44F6726181076E0581443D47",
          "sectionKey": "Ejemplos",
          "summary": "En «Estoy orgulloso de tu trabajo», el grupo preposicional depende de orgulloso, mientras que «con calma» en «Trabajo con calma» funciona como adjunto modal.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-B1868A3C72C52D6850B1042C",
          "sectionKey": "Observación importante",
          "summary": "Movilidad, opcionalidad y preposición no bastan como diagnósticos; deben considerarse la selección léxica, la función, la concordancia y el nivel estructural.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
