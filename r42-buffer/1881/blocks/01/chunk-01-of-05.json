      "claims": [
        {
          "claimId": "MLS-CLM-53CDACA3E9061C42613DB2EE",
          "sectionKey": "En pocas palabras",
          "summary": "El presente está deícticamente vinculado al momento de enunciación, aunque su referencia puede extenderse en estados y situaciones no puntuales.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-B7A4C0C8F3D085EE956787F4",
          "sectionKey": "Cómo funciona",
          "summary": "El presente generalizador expresa propiedades, regularidades y hábitos, incluso con expresiones de frecuencia, sin imponer realización exactamente en el momento del habla.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-81BFE7DD4395CF6C1457A1B2",
          "sectionKey": "Observación importante",
          "summary": "Un hábito expresado con presente supone reiteración dentro de un marco contextual, no actividad ininterrumpida; el presente gnómico caracteriza generalizaciones no estrictamente episódicas.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
