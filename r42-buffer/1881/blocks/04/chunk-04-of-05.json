      "claims": [
        {
          "claimId": "MLS-CLM-751A62E3B576BC10E9D2AF72",
          "sectionKey": "En pocas palabras",
          "summary": "El futuro simple de subjuntivo (cantare) y el compuesto (hubiere cantado) se conservan como paradigmas históricos hoy restringidos a fórmulas, usos normativos y registros arcaizantes.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-6327CA11558258BF74C0AF52",
          "sectionKey": "Cómo funciona",
          "summary": "Cantare construye situaciones eventuales dependientes; en las subordinadas temporales prospectivas habituales del español contemporáneo suele elegirse el presente de subjuntivo, por ejemplo cuando llegue.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-BE0544D60DD10AB279C53F05",
          "sectionKey": "Observación importante",
          "summary": "Hubiere seguido de participio expresa anterioridad o conclusión eventual respecto de otro punto de referencia; su baja frecuencia no lo convierte en una forma agramatical.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
