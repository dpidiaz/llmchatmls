      "claims": [
        {
          "claimId": "MLS-CLM-F37539B8394B9D76719D247F",
          "sectionKey": "En pocas palabras",
          "summary": "Los relativos simples consisten en una forma y los complejos incluyen artículo con que o cual según la construcción.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-4636150861F4855D5E58D713",
          "sectionKey": "Cómo funciona",
          "summary": "Los grupos relativos el cual, la cual, los cuales y las cuales expresan concordancia y aparecen especialmente en usos explicativos o preposicionales.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-1AAB6DEB5A9A9BBACE1514A3",
          "sectionKey": "Cómo funciona",
          "summary": "La alternancia entre formas simples y complejas depende de la preposición, la clase de relativa, el antecedente y el registro.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-A80BE467CD2D806EE3723520",
          "sectionKey": "Observación importante",
          "summary": "El artículo integrado en el grupo relativo complejo no debe confundirse con el determinante externo de un antecedente nominal.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
