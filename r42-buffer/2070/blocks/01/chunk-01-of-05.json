        "title": "El antecedente: expreso o incorporado",
        "level": "G3",
        "part": "Relativas / Relative clauses",
        "chapter": "Oraciones de relativo / Relative clauses"
      },
      "evidenceVersion": "1.0",
      "evidenceRevision": 1,
      "status": "SOURCED",
      "claims": [
        {
          "claimId": "MLS-CLM-985DE5472F85BA800B3DE5C1",
          "sectionKey": "En pocas palabras",
          "summary": "Una relativa puede tener antecedente expreso o carecer de antecedente nominal externo en la construcción libre.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-55FA39E4A549A0E33A897291",
          "sectionKey": "Cómo funciona",
          "summary": "La función del antecedente en la principal y la función del relativo dentro de la subordinada son niveles sintácticos diferentes.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-2E68437B2CC8F28318306482",
          "sectionKey": "Cómo funciona",
          "summary": "Quien y donde pueden formar relativas libres y las secuencias el que o la que sin nombre expreso se describen como semilibres en ciertos análisis.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-8D49C53C0C1C75EC08E2D050",
          "sectionKey": "Observación importante",
          "summary": "Antecedente expreso no significa referente previamente identificado, y la elección de indicativo o subjuntivo depende de interpretación modal, no solo de su expresión.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
