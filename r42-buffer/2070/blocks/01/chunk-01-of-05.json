      "claims": [
        {
          "claimId": "MLS-CLM-5C47DF1A0D8797DBF8A920E9",
          "sectionKey": "En pocas palabras",
          "summary": "En una relativa preposicional la preposición pertenece a la relación sintáctica que el grupo relativo cumple dentro de la subordinada.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-607542B0DB09AFAB77BFB2A5",
          "sectionKey": "Cómo funciona",
          "summary": "Las preposiciones pueden responder al régimen verbal o adjetival, al objeto personal o a relaciones locativas e instrumentales dentro de la relativa.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-AC64021DCFA60CF047D9E6BE",
          "sectionKey": "Cómo funciona",
          "summary": "Con preposición aparecen quien, el que o el cual, con restricciones de antecedente, animacidad, tipo de preposición y registro.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-053212D18B5F532BEE4D1561",
          "sectionKey": "Observación importante",
          "summary": "Una preposición que introduce el antecedente en la oración principal no convierte por sí misma la subordinada en relativa preposicional.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
