      "claims": [
        {
          "claimId": "MLS-CLM-724C9628EB0281C3616602C9",
          "sectionKey": "En pocas palabras",
          "summary": "Los adverbios aspectuales como ya, todavía y nuevamente sitúan una situación respecto de una fase, continuidad o repetición, sin limitarse a localizarla temporalmente.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-5FD50C371436841AEF20448D",
          "sectionKey": "Cómo funciona",
          "summary": "Ya puede señalar una fase alcanzada; todavía y aún expresan continuidad; de nuevo, otra vez y nuevamente expresan reiteración.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-8B6C1FD9000857ED1642C339",
          "sectionKey": "Observación importante",
          "summary": "Ya llegó hoy distingue fase (ya) de ubicación temporal (hoy); rápidamente describe manera y no constituye por ello un adverbio aspectual.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
