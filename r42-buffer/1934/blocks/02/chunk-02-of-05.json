      "status": "SOURCED",
      "claims": [
        {
          "claimId": "MLS-CLM-C7247F16D0916C712E0FC408",
          "sectionKey": "En pocas palabras",
          "summary": "Los adverbios y expresiones de frecuencia cuantifican la recurrencia de situaciones dentro de un intervalo contextual, a diferencia de la localización de un único acontecimiento.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-69D5F749BDCA226B9FE7DB9D",
          "sectionKey": "Cómo funciona",
          "summary": "Siempre y nunca presentan extremos de frecuencia en las ocasiones pertinentes; frecuentemente, habitualmente, ocasionalmente, a menudo o a veces expresan frecuencia variable; diariamente y semanalmente señalan periodicidad.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-8A37822C86D2B74DAE2D339A",
          "sectionKey": "Observación importante",
          "summary": "Frecuencia y duración no son equivalentes: estudia a menudo caracteriza reiteración y estudia durante tres horas caracteriza la extensión de una sesión; a veces es expresión pluriverbal con función adverbial.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
