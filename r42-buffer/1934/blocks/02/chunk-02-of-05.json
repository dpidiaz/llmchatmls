      "claims": [
        {
          "claimId": "MLS-CLM-624ED872DF5CD2C4DA14C4C2",
          "sectionKey": "En pocas palabras",
          "summary": "Los adverbios de tiempo constituyen una clase diversa: pueden localizar un suceso (ayer, ahora), indicar duración (brevemente), frecuencia (a menudo) u orden relativo (antes, después).",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-956C322306213DFEAD036DBD",
          "sectionKey": "Cómo funciona",
          "summary": "Hoy, ayer y mañana se interpretan en relación con el momento de habla; entonces puede remitir a un momento discursivo; frecuentemente expresa reiteración, mientras todavía y ya se vinculan con fases y expectativas.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-2C37F4A2E9C82252A2472052",
          "sectionKey": "Observación importante",
