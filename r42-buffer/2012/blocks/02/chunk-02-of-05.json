        "title": "Complementos de persona y de cosa personificada. Tendencias generales",
        "level": "G1",
        "part": "Sujeto y objetos / Subject and objects",
        "chapter": "El complemento directo / The direct object"
      },
      "evidenceVersion": "1.0",
      "evidenceRevision": 1,
      "status": "SOURCED",
      "claims": [
        {
          "claimId": "MLS-CLM-18DB73083951D021B059A3DA",
          "sectionKey": "En pocas palabras",
          "summary": "El complemento directo de persona identificada suele marcarse con a personal; en Vi a Marta, la sustitución La vi muestra que sigue siendo directo.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-A987B5A4292508858A1BA80A",
          "sectionKey": "Cómo funciona",
          "summary": "El uso de a con indefinidos depende de especificidad; también puede marcar animales individualizados y referentes personificados en construcciones especiales.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-1BD2D4B3494373DBC844985F",
          "sectionKey": "Tendencias semánticas",
          "summary": "La marcación preposicional resulta de animacidad, definitud, especificidad, personificación y significado verbal, no de la oposición absoluta entre personas y cosas.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-3395B4BE78FCCF5BB80E6CC6",
          "sectionKey": "Observación importante",
          "summary": "La a personal no distingue por sí sola directo e indirecto: la estructura verbal y los clíticos de acusativo o dativo ayudan a identificarlos.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
