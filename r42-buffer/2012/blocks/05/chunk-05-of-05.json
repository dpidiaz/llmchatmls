      "status": "SOURCED",
      "claims": [
        {
          "claimId": "MLS-CLM-92059A076A4E4F719702C137",
          "sectionKey": "En pocas palabras",
          "summary": "El dativo de interés añade una persona beneficiada o perjudicada, mientras el simpatético caracteriza una relación posesiva o de pertenencia estrecha.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-C6FD7C5015223CF5499BFAC9",
          "sectionKey": "Cómo funciona",
          "summary": "Le preparé la cena puede expresar interés, y Le lavaron las manos al niño vincula el dativo con el poseedor de la parte del cuerpo.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-DE021D923BAF9F38C3481DE4",
          "sectionKey": "Interés, posesión y afectación",
          "summary": "El perjuicio o beneficio puede coincidir con la posesión, por lo que los valores de interés y simpatético pueden solaparse.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-733059A01DC58F495CCDFA70",
          "sectionKey": "Observación importante",
          "summary": "Estos dativos no representan necesariamente un destinatario de transferencia ni son siempre participantes seleccionados por el verbo.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
