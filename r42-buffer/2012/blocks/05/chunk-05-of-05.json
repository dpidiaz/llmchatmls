        "title": "Dativo ético y dativo concordado",
        "level": "G1",
        "part": "Sujeto y objetos / Subject and objects",
        "chapter": "El complemento indirecto / The indirect object"
      },
      "evidenceVersion": "1.0",
      "evidenceRevision": 1,
      "status": "SOURCED",
      "claims": [
        {
          "claimId": "MLS-CLM-9235CEE937B9FAF4F5D88843",
          "sectionKey": "En pocas palabras",
          "summary": "El dativo ético señala implicación afectiva del hablante o interlocutor, mientras el dativo concordado es correferente con el sujeto y puede aportar matices aspectuales.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-633D8B76D2F7009ABF20747A",
          "sectionKey": "Cómo funciona",
          "summary": "El me de No me llegués tarde no es exigido por llegar; el me de Me comí todo el pan coincide con el sujeto y acompaña un evento delimitado.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-FA328D083084668F4855E91A",
          "sectionKey": "Concordancia e implicación",
          "summary": "En Vos te comiste todo el clítico te coincide con el sujeto vos, a diferencia del dativo ético que no requiere esa correferencia.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-8CFB830DA369E9886075207B",
          "sectionKey": "Observación importante",
          "summary": "Los dativos ético y concordado no expresan obligatoriamente receptores; la lectura de completitud depende del verbo y del contexto y no se confunde con reflexividad ordinaria.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
