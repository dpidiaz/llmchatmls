        "title": "Complementos argumentales de término, origen y ubicación",
        "level": "G1",
        "part": "Sujeto y objetos / Subject and objects",
        "chapter": "El complemento indirecto / The indirect object"
      },
      "evidenceVersion": "1.0",
      "evidenceRevision": 1,
      "status": "SOURCED",
      "claims": [
        {
          "claimId": "MLS-CLM-E73277F65AA01DAE2E9D4D7F",
          "sectionKey": "En pocas palabras",
          "summary": "Los complementos indirectos argumentales admiten interpretaciones semánticas de término o destino, origen y entidad receptora de una adición o colocación.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-B69E7025D66856604BE423E2",
          "sectionKey": "Cómo funciona",
          "summary": "En dar, quitar y poner, el clítico de dativo le/les o el grupo con a puede designar destinatario, origen o receptor, mientras lo transferido puede realizarse como objeto directo.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-7A304D07CBDD8BF19B37B1E8",
          "sectionKey": "Término, origen y ubicación",
          "summary": "Los rótulos de término, origen y ubicación describen interpretaciones del participante, no tres funciones sintácticas distintas.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-A69A4B8702BAEDD63849CA35",
          "sectionKey": "Observación importante",
          "summary": "No todo grupo locativo es complemento indirecto: el análisis exige una construcción dativa pertinente, no solo significado espacial.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
