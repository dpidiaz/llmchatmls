      "claims": [
        {
          "claimId": "MLS-CLM-83A1D081407EBFF2BCB7298E",
          "sectionKey": "En pocas palabras",
          "summary": "Una forma conjugada seguida de una forma no personal no constituye necesariamente perífrasis; existen construcciones perifrásticas, semiperifrásticas y no perifrásticas.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-E67E1ADCC5AF527F2126C48E",
          "sectionKey": "Cómo funciona",
          "summary": "La cohesión sintáctica y el significado léxico residual del primer verbo, junto con restricciones de selección e interpolación, orientan la distinción entre construcciones.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-881C0E3D5C9E8E359A99D6CE",
          "sectionKey": "Observación importante",
          "summary": "No basta la mera proximidad de dos verbos para establecer una perífrasis: se necesitan varios diagnósticos gramaticales combinados.",
          "claimType": "grammatical_description",
          "materiality": "substantial"
        }
      ],
