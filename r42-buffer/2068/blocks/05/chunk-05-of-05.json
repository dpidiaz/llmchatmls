      "claims": [
        {
          "claimId": "MLS-CLM-DE0653C79AA555D07E96E679",
          "sectionKey": "En pocas palabras",
          "summary": "Las declarativas pueden desempeñar la función de término de una preposición seleccionada por un verbo, nombre o adjetivo.",
          "claimType": "general",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-FD3BA14125BC7C9D79C07355",
          "sectionKey": "Cómo funciona",
          "summary": "En acordarse de que, la preposición de pertenece al régimen de acordarse y la conjunción que encabeza la oración subordinada.",
          "claimType": "general",
          "materiality": "substantial"
        },
        {
          "claimId": "MLS-CLM-6A9D51117C55ECCA8524FCA3",
          "sectionKey": "Observación importante",
          "summary": "No debe confundirse el término de preposición con la declarativa usada directamente como complemento de un verbo sin preposición.",
          "claimType": "general",
          "materiality": "substantial"
        }
      ],
