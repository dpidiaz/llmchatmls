{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://master-language-system.local/schemas/canonical-entry.schema.json",
  "title": "MASTER LANGUAGE SYSTEM Canonical Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "language",
    "languageName",
    "n",
    "title",
    "level",
    "part",
    "chapter",
    "articleMarkdown",
    "provider",
    "model",
    "auditProvider",
    "auditModel",
    "promptVersion",
    "generatedAt"
  ],
  "properties": {
    "code": { "type": "string", "pattern": "^MLS-V[0-9]{2}-[0-9]{4}$" },
    "language": { "type": "string", "minLength": 1 },
    "languageName": { "type": "string", "minLength": 1 },
    "n": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "level": { "type": "string" },
    "part": { "type": "string" },
    "chapter": { "type": "string" },
    "articleMarkdown": { "type": "string", "minLength": 1 },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "auditProvider": { "type": "string" },
    "auditModel": { "type": "string" },
    "promptVersion": { "const": "32.0" },
    "generatedAt": { "type": "string" }
  }
}
