    "title": "Alternancias modales en las subordinadas sustantivas",
    "level": "G3",
    "part": "Subjuntivo y modo / Subjunctive and mood",
    "chapter": "Modo, indicativo y subjuntivo / Mood, indicative, and subjunctive"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 2,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-BE4AF205078F688161BEB96C",
      "sectionKey": "En pocas palabras",
      "summary": "En subordinadas sustantivas, el indicativo y el subjuntivo dependen de la selección léxica, la negación y la interpretación discursiva, sin equivalencia automática con verdad e irrealidad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-36C2A856C3B6B3AC192E270B",
      "sectionKey": "Afirmación y conocimiento",
      "summary": "Las completivas seleccionadas por conocimiento o aserción afirmativa favorecen indicativo y no se explican por una regla general de certeza.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BA6F7DE39EB491B814E12653",
      "sectionKey": "Duda y negación",
      "summary": "La polaridad y el significado del predicado rector explican alternancias del tipo creo que viene / no creo que venga.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-25DAFBCFA6E0B384E87F970A",
      "sectionKey": "Verbos de voluntad y valoración",
      "summary": "Los predicados de deseo, petición e influencia y los de valoración o reacción suelen seleccionar subjuntivo aun si la proposición subordinada se asume cierta.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-6B768D501091B3B5055DB362",
      "sectionKey": "Alternancias con cambio de significado",
      "summary": "Un verbo de comunicación como decir puede cambiar de patrón modal cuando adquiere interpretación de influencia o mandato.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E3EA1DCB77C390C8E85A3C6E",
      "sectionKey": "La importancia de la perspectiva",
      "summary": "Las alternancias de modo pueden focalizar la comunicación asertiva o la evaluación afectiva del mismo contenido; por ello deben interpretarse en su contexto.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AB94D1748721BF835723F47A",
      "sectionKey": "Observación importante",
      "summary": "La selección modal de una subordinada no se reduce a hecho frente a opinión; las clases de predicado, negación, sentido léxico y perspectiva discursiva interactúan.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
