    "title": "Contextos que imponen el modo subjuntivo",
    "level": "G3",
    "part": "Subjuntivo y modo / Subjunctive and mood",
    "chapter": "Modo, indicativo y subjuntivo / Mood, indicative, and subjunctive"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 2,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-0B34C754F96DA0403FD603D7",
      "sectionKey": "En pocas palabras",
      "summary": "La elección del subjuntivo depende de selectores como voluntad, reacción afectiva, valoración, posibilidad e influencia, y no constituye una marca obligatoria de irrealidad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-AF21D2C7D94E73E7978984EC",
      "sectionKey": "Voluntad e influencia",
      "summary": "La subordinada de los verbos de deseo, petición, mandato o influencia suele seleccionarse en subjuntivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A0CC5686C271DC10B2415311",
      "sectionKey": "Valoración y reacción",
      "summary": "La valoración puede seleccionar subjuntivo incluso cuando la proposición subordinada es asumida como verdadera.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A68DE7A293F59D4E2D95014B",
      "sectionKey": "Duda, negación y posibilidad",
      "summary": "Los predicados de falsedad, duda, incertidumbre y posibilidad suelen admitir subjuntivo; la negación puede actuar como inductor externo pero su efecto depende del predicado.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E32300DF17A51C7B0146BB4A",
      "sectionKey": "Finalidad y otras conjunciones",
      "summary": "Las construcciones de finalidad y varias locuciones condicionales introducen subjuntivo, mientras otras conjunciones como aunque admiten ambos modos según interpretación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-CF04E465739FA87E71EAA460",
      "sectionKey": "Temporales futuras y relativas no identificadas",
      "summary": "Los valores prospectivos de ciertos nexos temporales o condicionales favorecen subjuntivo, mientras las relativas presentan alternancias modales ligadas al tipo de referente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-8C185094ED397E9F397E6E46",
      "sectionKey": "Temporales futuras y relativas no identificadas",
      "summary": "Las relativas admiten tanto indicativo como subjuntivo, de acuerdo con su interpretación referencial y el contexto que las selecciona.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-F4B57FC05817665015928CBE",
      "sectionKey": "Observación importante",
      "summary": "El subjuntivo puede aparecer con información presupuesta como cierta en predicados de afección, así que no equivale por sí solo a duda o situación ficticia.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
