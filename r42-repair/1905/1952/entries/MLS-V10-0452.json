  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-2680D6A9B0D4D1DEBA8F9053",
      "sectionKey": "En pocas palabras",
      "summary": "La elección entre indicativo y subjuntivo depende de la construcción, del predicado selector y de la perspectiva discursiva: no coincide mecánicamente con realidad frente a irrealidad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-14083892C4C510AB95B4F00D",
      "sectionKey": "Indicativo",
      "summary": "El indicativo suele seleccionarse en complementos de comunicación afirmativa, certeza, percepción y conocimiento cuando el contenido se presenta como información asumida.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-BC7222A36CCDDB8AD3B1E65E",
      "sectionKey": "Subjuntivo",
      "summary": "El subjuntivo aparece con predicados de intención, influencia, valoración, reacción afectiva, posibilidad y otras clases que no equivalen mecánicamente a irrealidad.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-7A374A75DD5E5C0E928AD5AF",
      "sectionKey": "Negación y modo",
      "summary": "La negación puede modificar la selección modal en completivas, pero no convierte cualquier subordinada interrogativa en subjuntivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-E36E5163AEFE2D27AA1BC173",
      "sectionKey": "Conjunciones y subordinación",
      "summary": "Finales, temporales prospectivas y relativas muestran que la selección modal responde a clases sintácticas y valores de referencia diferenciados.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-307B5FA3D06CB5ADADD3AF5D",
      "sectionKey": "Relativas y referencia",
      "summary": "La selección de modo en oraciones de relativo se relaciona con identificación y especificidad del antecedente; la interpretación referencial modifica el contraste indicativo-subjuntivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-82099B6DB84211EC2EEF3719",
      "sectionKey": "Observación importante",
      "summary": "La oposición indicativo-subjuntivo se interpreta mediante sintaxis, valor del predicado e información discursiva, no con una sola regla de realidad frente a duda.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
