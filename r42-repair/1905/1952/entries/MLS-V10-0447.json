    "title": "Contextos que imponen el modo indicativo",
    "level": "G3",
    "part": "Subjuntivo y modo / Subjunctive and mood",
    "chapter": "Modo, indicativo y subjuntivo / Mood, indicative, and subjunctive"
  },
  "evidenceVersion": "1.0",
  "evidenceRevision": 2,
  "status": "VERIFIED",
  "claims": [
    {
      "claimId": "MLS-CLM-CA5885A14957BA2E6D78C90B",
      "sectionKey": "En pocas palabras",
      "summary": "El indicativo se emplea regularmente en completivas regidas por predicados asertivos y de conocimiento en contexto afirmativo; no equivale por sí solo a verdad extralingüística.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-C50ECE6889136228602061BF",
      "sectionKey": "Verbos de conocimiento y constatación",
      "summary": "En subordinadas dependientes de saber, confirmar, comprobar o demostrar usados de manera asertiva, el indicativo introduce un contenido presentado como información asumida.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-75783D32429534A37F5FDE66",
      "sectionKey": "Verbos de comunicación y afirmación",
      "summary": "Afirmar, decir y asegurar con lectura informativa favorecen el indicativo; la negación puede cambiar la selección modal.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-A509683D213F39CBCFBB5175",
      "sectionKey": "Percepción y evidencia",
      "summary": "Los verbos perceptivos como ver, oír, observar o notar introducen indicativo cuando la subordinada declara información percibida; claro y evidente lo favorecen en uso afirmativo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-2D299181FD7F5BECC50C6225",
      "sectionKey": "Relativas con referente identificado",
      "summary": "Con un antecedente referencial identificado, la relativa suele formularse en indicativo, como en la pauta que describe el informe que todos esperan.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B33EB95EEA6442F6DFFF073E",
      "sectionKey": "Temporales realizadas o habituales",
      "summary": "En las cláusulas de valor temporal que describen eventos realizados u habituales puede usarse indicativo; ciertos nexos con reinterpretación condicional o prospectiva inducen subjuntivo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-761D541701E84336D9EC12E7",
      "sectionKey": "Observación importante",
      "summary": "El indicativo no codifica por sí solo certeza absoluta: su elección depende de la construcción, del elemento rector, de otros inductores y del modo de presentar la información.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
