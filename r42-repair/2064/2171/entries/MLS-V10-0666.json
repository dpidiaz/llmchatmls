      "sectionKey": "En pocas palabras",
      "summary": "Solo, solamente, únicamente y exclusivamente restringen una afirmación a una alternativa del conjunto contextual.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-5CD3C137485137184B054358",
      "sectionKey": "Cómo funciona",
      "summary": "Solo Ana habló con Marta y Ana habló solo con Marta difieren en alcance probable; prosodia y contexto pueden alterar la interpretación.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-922F6CDCB23643088E144544",
      "sectionKey": "Ejemplos",
      "summary": "Solo Ana vino presenta exclusión de otros sujetos pertinentes; Marta vino sola usa un adjetivo femenino, no el adverbio invariable solo.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-4601E1C4D249C360072322DF",
      "sectionKey": "Observación importante",
      "summary": "Solo adverbial se escribe generalmente sin tilde; el caso excepcional de ambigüedad se trata en la doctrina ortográfica vigente.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
