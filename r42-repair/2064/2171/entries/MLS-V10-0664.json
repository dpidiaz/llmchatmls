  "claims": [
    {
      "claimId": "MLS-CLM-3821777333F6D1B6A119980D",
      "sectionKey": "En pocas palabras",
      "summary": "El sí preverbal marca polaridad afirmativa frente a una alternativa negativa real o contextual, como Marta sí vino.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-B7EA824CEB6016A07F636B8A",
      "sectionKey": "Cómo funciona",
      "summary": "La forma preverbal sí marca afirmación contrastiva; sí como respuesta independiente o en Creo que sí recupera el contenido del discurso.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-3D3220E6EA7C99B61CAB0944",
      "sectionKey": "Ejemplos",
      "summary": "Marta sí vino y Vos sí sabés la respuesta expresan polaridad positiva marcada; sabés es forma voseante usada en Guatemala.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    },
    {
      "claimId": "MLS-CLM-477451F868F0FE0F92FA7E2E",
      "sectionKey": "Observación importante",
      "summary": "La tilde distingue el adverbio afirmativo sí de la conjunción condicional si; Marta vino no focaliza polaridad por sí sola.",
      "claimType": "grammatical_description",
      "materiality": "substantial"
    }
  ],
